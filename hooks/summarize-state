#!/usr/bin/env bash
# summarize-state — derive a short, non-authoritative TaskFlow state summary.
# Runs from the repo root, and says nothing at all only where there is nothing
# to say. Cross-platform: invoked via run-hook.cmd (Git-bash on Windows).
# POSIX shell + awk only: the plugin must run with no language runtime available.
set -euo pipefail
shopt -s nullglob
# Byte-order collation keeps glob order identical across hosts, which is what
# makes the printed task order byte-stable.
LC_ALL=C
export LC_ALL

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
repo_root="${TASKFLOW_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")}"
[ -n "$repo_root" ] || repo_root="$PLUGIN_ROOT"
docs="$repo_root/TaskFlowDocs"

# A repository that has never used TaskFlow is the case where the obligation is
# hardest to notice: there is no todo.md to find and no active task to continue,
# so this hook used to exit in silence and the session began with no sign that a
# requests-to-TaskFlow path exists at all. The gate itself is stated in SKILL.md
# ("Applicability gate"), and repeating it here is the one thing this hook can do
# without writing: it is the only TaskFlow output a session gets before an Agent
# has read anything. This states the boundary; it does not act on it — no
# directory, no Todo, no intake.
if [ ! -d "$docs" ]; then
  cat <<'GATE'
# TaskFlow (not started in this repository)
- Applicable work enters TaskFlow: a request to modify this repository or deliver a development artifact — a feature, fix, refactor, test, or configuration/build/CI change — is recorded first in TaskFlowDocs/todo.md.
- Read-only work (explanation, translation, status, research, review, diagnosis) does not, and an explicit $taskflow request opts it in.
GATE
  exit 0
fi

todo="$docs/todo.md"
verbose="${TASKFLOW_VERBOSE:-0}"
task_id="${TASKFLOW_TASK_ID:-}"

# Registration is by slug, not by status. A branch is named <type>/<slug> and a
# task directory <date>-<slug>, so a branch belongs to a task when some task
# directory is named "<something>-<that slug>" — the suffix match, not a prefix,
# because the date is dropped from the branch name. `achieved` is included on
# purpose: work that was registered and then archived is registered work, and
# reporting it would put a line in every session of every repository whose task
# set is fully archived.
#
# `report` starts at 0 and is raised only where the question is meaningful. A
# base branch, a detached HEAD, and a directory that is not a repository are all
# situations with no branch to register, and saying so every session would be
# noise that hides the one case this exists for.
report=0
current_branch="$(git -C "$repo_root" branch --show-current 2>/dev/null || true)"
branch_slug="${current_branch##*/}"
case "$current_branch" in ""|main|master) ;; *)
  report=1
  for dir in "$docs"/*/ "$docs"/achieved/*/; do
    name="${dir%/}"
    name="${name##*/}"
    case "$name" in achieved|repository-docs) continue ;; esac
    case "$name" in *-"$branch_slug") report=0; break ;; esac
  done
  ;;
esac

active=()
for dir in "$docs"/*/; do
  name="${dir%/}"
  name="${name##*/}"
  case "$name" in achieved|repository-docs) continue ;; esac
  [ -f "$dir/plan.md" ] || continue
  active+=("$name")
done

# The Todo inbox is only worth printing when there is no active task to report,
# or on request: the active-task list is the more useful default.
if [ -f "$todo" ] && { [ "$verbose" = "1" ] || [ "${#active[@]}" -eq 0 ]; }; then
  echo "# TaskFlow inbox (not done)"
  awk '
    function ltrim(s) { sub(/^[[:space:]]+/, "", s); return s }
    function rtrim(s) { sub(/[[:space:]]+$/, "", s); return s }
    function trim(s) { return rtrim(ltrim(s)) }
    function rfield(a, b, name,   i, p) {
      p = "- " name ":"
      for (i = a; i <= b; i++) if (index(line[i], p) == 1) return trim(substr(line[i], length(p) + 1))
      return ""
    }
    { n++; line[n] = $0 }
    END {
      hc = 0
      for (i = 1; i <= n; i++) if (index(line[i], "## ") == 1) { hc++; hd[hc] = i }
      for (j = 1; j <= hc; j++) {
        a = hd[j] + 1; b = (j < hc) ? hd[j + 1] - 1 : n
        id = rfield(a, b, "ID")
        # The template placeholders are documentation, not entries.
        if (id == "" || id == "T-YYYYMMDD-001" || id == "YYYYMMDD-001") continue
        # The string form matches \S+, so a value with whitespace is not an ID.
        if (id ~ /[[:space:]]/) continue
        st = rfield(a, b, "Status")
        if (st == "done") continue
        g = rfield(a, b, "Goal")
        if (length(g) > 120) g = substr(g, 1, 120)
        printf "- %s | %s | %s\n", id, (st == "" ? "?" : st), g
      }
    }
  ' "$todo"
fi

echo "# Active tasks"

# One line per selected task: id, version, status, title, approval, next Step.
summarize_plan() {  # summarize_plan <task-name> <plan-path>
  awk -v dirname="$1" '
    function ltrim(s) { sub(/^[[:space:]]+/, "", s); return s }
    function rtrim(s) { sub(/[[:space:]]+$/, "", s); return s }
    function trim(s) { return rtrim(ltrim(s)) }
    function at(s, p) { return index(s, p) == 1 }
    function pvalue(key,   p, i, v) {
      p = "> " key ":"
      for (i = 1; i <= n; i++) {
        if (at(line[i], p)) {
          v = trim(substr(line[i], length(p) + 1))
          return v
        }
      }
      return ""
    }
    { n++; line[n] = $0 }
    END {
      version = pvalue("Task version"); if (version == "") version = "?"
      status = pvalue("Status"); if (status == "") status = "?"
      title = dirname
      # The Plan heading is "# Plan - Title" with an optional separator.
      for (i = 1; i <= n; i++) {
        if (at(line[i], "# Plan")) {
          h = substr(line[i], 7)
          sub(/^[[:space:]]*/, "", h)
          sub(/^(\xe2\x80\x94|-)/, "", h)
          sub(/^[[:space:]]*/, "", h)
          h = rtrim(h)
          if (h != "") title = h
          break
        }
      }
      approval = "?"
      for (i = 1; i <= n; i++) {
        if (at(line[i], "## Approval")) {
          for (j = i + 1; j <= n; j++) {
            if (at(line[j], "## ")) break
            if (at(line[j], "- Status:")) { approval = trim(substr(line[j], 10)); break }
          }
          break
        }
      }
      # The first Step that is not done. The Step heading separator is optional.
      ns = ""
      for (i = 1; i <= n; i++) {
        if (!at(line[i], "### Step ")) continue
        rest = substr(line[i], 10)
        if (!match(rest, /^[0-9]+/)) continue
        num = substr(rest, 1, RLENGTH)
        stitle = substr(rest, RLENGTH + 1)
        sub(/^[[:space:]]*/, "", stitle)
        sub(/^(\xe2\x80\x94|-)/, "", stitle)
        sub(/^[[:space:]]*/, "", stitle)
        stitle = rtrim(stitle)
        st = "?"
        for (j = i + 1; j <= n; j++) {
          if (at(line[j], "### Step ") || at(line[j], "## ")) break
          if (at(line[j], "- Status:")) { st = trim(substr(line[j], 10)); break }
        }
        if (st != "done") { ns = "Step " num " " stitle " [" st "]"; break }
      }
      suffix = " | approval: " approval
      if (ns != "") suffix = suffix " | next: " ns
      printf "- %s | %s | %s \xe2\x80\x94 %s%s\n", dirname, version, status, title, suffix
    }
  ' "$2"
}

if [ -n "$task_id" ]; then
  found=0
  for name in "${active[@]}"; do
    [ "$name" = "$task_id" ] || continue
    summarize_plan "$name" "$docs/$name/plan.md"
    found=1
  done
  [ "$found" = "1" ] || echo "- Requested task unavailable: $task_id"
elif [ "${#active[@]}" -eq 1 ]; then
  summarize_plan "${active[0]}" "$docs/${active[0]}/plan.md"
elif [ "${#active[@]}" -gt 1 ]; then
  if [ "$verbose" = "1" ]; then
    for name in "${active[@]}"; do summarize_plan "$name" "$docs/$name/plan.md"; done
  else
    echo "- Multiple active tasks (${#active[@]}); set TASKFLOW_TASK_ID to select one."
  fi
fi

# Last, so it reads as a classification of what is above rather than a preamble
# to it. Taking over a workstream reads as a continuation, and `SKILL.md` rules
# that a new session or a changed implementation detail is never by itself a new
# task trigger — so work that was never registered can be picked up and carried
# a long way with nothing ever asking whether it should have been. Locating the
# branch is all this does; whether the work belongs here stays the Agent's call.
if [ "$report" = "1" ]; then
  echo "# No task for branch '$current_branch'"
  echo "- Work on this branch is not registered: no TaskFlowDocs/<task>/ matches it. If it should be, record it before continuing."
fi
exit 0
