#!/usr/bin/env bash
# summarize-state — derive a short, non-authoritative TaskFlow state summary.
# Runs from the repo root, and says nothing at all only where there is nothing
# to say. Cross-platform: invoked via run-hook.cmd (Git-bash on Windows).
# POSIX shell + awk only: the plugin must run with no language runtime available.
set -euo pipefail
shopt -s nullglob
# Byte-order collation keeps glob order identical across hosts, which is what
# makes the printed task order byte-stable.
LC_ALL=C
export LC_ALL

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
repo_root="${TASKFLOW_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")}"
[ -n "$repo_root" ] || repo_root="$PLUGIN_ROOT"
docs="$repo_root/TaskFlowDocs"

todo="$docs/todo.md"
verbose="${TASKFLOW_VERBOSE:-0}"
task_id="${TASKFLOW_TASK_ID:-}"

# Registration is by slug, not by status. A branch is named <type>/<slug> and a
# task directory <date>-<slug>, so a branch belongs to a task when some task
# directory is named "<something>-<that slug>" — the suffix match, not a prefix,
# because the date is dropped from the branch name. `achieved` is included on
# purpose: work that was registered and then archived is registered work, and
# reporting it would put a line in every session of every repository whose task
# set is fully archived.
#
# `report` starts at 0 and is raised only where the question is meaningful. A
# base branch, a detached HEAD, and a directory that is not a repository are all
# situations with no branch to register, and saying so every session would be
# noise that hides the one case this exists for.
report=0
current_branch="$(git -C "$repo_root" branch --show-current 2>/dev/null || true)"
branch_slug="${current_branch##*/}"
case "$current_branch" in ""|main|master) ;; *)
  report=1
  for dir in "$docs"/*/ "$docs"/achieved/*/; do
    name="${dir%/}"
    name="${name##*/}"
    case "$name" in achieved|repository-docs) continue ;; esac
    case "$name" in *-"$branch_slug") report=0; break ;; esac
  done
  ;;
esac

active=()
for dir in "$docs"/*/; do
  name="${dir%/}"
  name="${name##*/}"
  case "$name" in achieved|repository-docs) continue ;; esac
  [ -f "$dir/plan.md" ] || continue
  active+=("$name")
done

# The obligation line is printed in the states where no active task exists — and
# it is keyed on exactly that, not on whether `TaskFlowDocs/` is there.
#
# It used to be keyed on the directory being absent. That condition cannot hold
# in a repository that has ever used TaskFlow: the SessionStart routing hook
# creates `TaskFlowDocs/repository-docs/` itself, and `todo.md` is a tracked
# file, so both are present from the repository's first recorded request onward.
# The line was therefore dead code in every repository that had anything to
# record it for, and the state it went missing in is the one a session most often
# opens in: the base checkout. Measured 2026-10-12 on 1.1.5 — same commit, same
# todo.md, base branch printed nothing while `fix/something` printed the branch
# report. The obligation's delivery condition and its own applicability were
# exactly inverted, since the harder a repository has used TaskFlow, the less it
# could ever be told how.
#
# The branch report is deliberately not part of this condition. The two answer
# different questions — "should this work have been recorded?" applies on every
# branch including the base one, while "is this branch's work unregistered?" has
# no meaning on a base branch — so a base checkout says the first and never the
# second.
#
# `repository-docs/` is excluded from the "recorded" evidence because the routing
# hook creates it itself, so its presence proves nothing; anything else under
# here, an `achieved/` directory included, is evidence of use.
if [ "${#active[@]}" -eq 0 ]; then
  recorded=0
  [ -f "$todo" ] && recorded=1
  if [ "$recorded" -eq 0 ]; then
    for dir in "$docs"/*/; do
      name="${dir%/}"
      name="${name##*/}"
      case "$name" in repository-docs) continue ;; esac
      recorded=1
      break
    done
  fi
  if [ "$recorded" -eq 1 ]; then
    echo "# TaskFlow (no active task)"
    echo "- Applicable work enters TaskFlow: a request to modify this repository or deliver a development artifact — a feature, fix, refactor, test, or configuration/build/CI change — is recorded first in TaskFlowDocs/todo.md."
  else
    echo "# TaskFlow (not started in this repository)"
    echo "- Applicable work enters TaskFlow: a request to modify this repository or deliver a development artifact — a feature, fix, refactor, test, or configuration/build/CI change — is recorded first in TaskFlowDocs/todo.md."
  fi
  echo "- Read-only work (explanation, translation, status, research, review, diagnosis) does not, and an explicit \$taskflow request opts it in."
fi

# The Todo inbox is only worth printing when there is no active task to report,
# or on request: the active-task list is the more useful default.
if [ -f "$todo" ] && { [ "$verbose" = "1" ] || [ "${#active[@]}" -eq 0 ]; }; then
  echo "# TaskFlow inbox (not done)"
  awk '
    function ltrim(s) { sub(/^[[:space:]]+/, "", s); return s }
    function rtrim(s) { sub(/[[:space:]]+$/, "", s); return s }
    function trim(s) { return rtrim(ltrim(s)) }
    function rfield(a, b, name,   i, p) {
      p = "- " name ":"
      for (i = a; i <= b; i++) if (index(line[i], p) == 1) return trim(substr(line[i], length(p) + 1))
      return ""
    }
    { n++; line[n] = $0 }
    END {
      hc = 0
      for (i = 1; i <= n; i++) if (index(line[i], "## ") == 1) { hc++; hd[hc] = i }
      for (j = 1; j <= hc; j++) {
        a = hd[j] + 1; b = (j < hc) ? hd[j + 1] - 1 : n
        id = rfield(a, b, "ID")
        # The template placeholders are documentation, not entries.
        if (id == "" || id == "T-YYYYMMDD-001" || id == "YYYYMMDD-001") continue
        # The string form matches \S+, so a value with whitespace is not an ID.
        if (id ~ /[[:space:]]/) continue
        st = rfield(a, b, "Status")
        if (st == "done") continue
        g = rfield(a, b, "Goal")
        if (length(g) > 120) g = substr(g, 1, 120)
        printf "- %s | %s | %s\n", id, (st == "" ? "?" : st), g
      }
    }
  ' "$todo"
fi

echo "# Active tasks"

# One line per selected task: id, version, status, title, approval, next Step.
summarize_plan() {  # summarize_plan <task-name> <plan-path> [prd-path]
  # The PRD is read separately for unanswered Blocking questions: they are the
  # one piece of state that can invalidate the whole Plan, and leaving them out of
  # the summary meant a resumed session could carry on into work it should not.
  blocking=0
  if [ -n "${3:-}" ] && [ -f "$3" ]; then
    blocking="$(awk '/^### Blocking$/{inb=1; next} inb && /^#{1,6} /{exit} inb && /^- \[ \]/{c++} END{print c+0}' "$3")"
  fi
  awk -v dirname="$1" -v blocking="$blocking" '
    function ltrim(s) { sub(/^[[:space:]]+/, "", s); return s }
    function rtrim(s) { sub(/[[:space:]]+$/, "", s); return s }
    function trim(s) { return rtrim(ltrim(s)) }
    function at(s, p) { return index(s, p) == 1 }
    function pvalue(key,   p, i, v) {
      p = "> " key ":"
      for (i = 1; i <= n; i++) {
        if (at(line[i], p)) {
          v = trim(substr(line[i], length(p) + 1))
          return v
        }
      }
      return ""
    }
    { n++; line[n] = $0 }
    END {
      version = pvalue("Task version"); if (version == "") version = "?"
      status = pvalue("Status"); if (status == "") status = "?"
      title = dirname
      # The Plan heading is "# Plan - Title" with an optional separator.
      for (i = 1; i <= n; i++) {
        if (at(line[i], "# Plan")) {
          h = substr(line[i], 7)
          sub(/^[[:space:]]*/, "", h)
          sub(/^(\xe2\x80\x94|-)/, "", h)
          sub(/^[[:space:]]*/, "", h)
          h = rtrim(h)
          if (h != "") title = h
          break
        }
      }
      approval = "?"
      for (i = 1; i <= n; i++) {
        if (at(line[i], "## Approval")) {
          for (j = i + 1; j <= n; j++) {
            if (at(line[j], "## ")) break
            if (at(line[j], "- Status:")) { approval = trim(substr(line[j], 10)); break }
          }
          break
        }
      }
      # The first Step that is not done. The Step heading separator is optional.
      ns = ""
      for (i = 1; i <= n; i++) {
        if (!at(line[i], "### Step ")) continue
        rest = substr(line[i], 10)
        if (!match(rest, /^[0-9]+/)) continue
        num = substr(rest, 1, RLENGTH)
        stitle = substr(rest, RLENGTH + 1)
        sub(/^[[:space:]]*/, "", stitle)
        sub(/^(\xe2\x80\x94|-)/, "", stitle)
        sub(/^[[:space:]]*/, "", stitle)
        stitle = rtrim(stitle)
        st = "?"
        for (j = i + 1; j <= n; j++) {
          if (at(line[j], "### Step ") || at(line[j], "## ")) break
          if (at(line[j], "- Status:")) { st = trim(substr(line[j], 10)); break }
        }
        if (st != "done") { ns = "Step " num " " stitle " [" st "]"; break }
      }
      suffix = " | approval: " approval
      if (ns != "") suffix = suffix " | next: " ns
      # Count what the next Step still owes, so the summary says "2 open" rather
      # than leaving the reader to open the Plan and count. Checklist items are
      # indented under `- Implementation checklist:`, so match on the marker
      # anywhere in the line rather than at column 0.
      if (match(ns, /^Step [0-9]+/)) {
        snum = ns; sub(/^Step /, "", snum); sub(/ .*/, "", snum)
        pending_items = 0; found = 0
        for (i = 1; i <= n; i++) {
          if (at(line[i], "### Step " snum " ")) { found = i; break }
        }
        if (found > 0) {
          for (j = found + 1; j <= n; j++) {
            if (at(line[j], "### Step ") || at(line[j], "## ")) break
            if (index(line[j], "- [ ]") > 0) pending_items++
          }
        }
        if (pending_items > 0) suffix = suffix " | checklist: " pending_items " open"
      }
      if (blocking + 0 > 0) suffix = suffix " | BLOCKING: " blocking " unanswered"
      printf "- %s | %s | %s \xe2\x80\x94 %s%s\n", dirname, version, status, title, suffix
    }
  ' "$2"
}

if [ -n "$task_id" ]; then
  found=0
  for name in "${active[@]}"; do
    [ "$name" = "$task_id" ] || continue
    summarize_plan "$name" "$docs/$name/plan.md" "$docs/$name/prd.md"
    found=1
  done
  [ "$found" = "1" ] || echo "- Requested task unavailable: $task_id"
elif [ "${#active[@]}" -eq 1 ]; then
  summarize_plan "${active[0]}" "$docs/${active[0]}/plan.md" "$docs/${active[0]}/prd.md"
elif [ "${#active[@]}" -gt 1 ]; then
  # List every active task by default. The previous behaviour reported only a
  # count and told the reader to set TASKFLOW_TASK_ID, which is an instruction
  # they cannot act on: nothing in the summary said which task to pick or what
  # those IDs were. Listing them all is a few more lines and needs no decision.
  for name in "${active[@]}"; do summarize_plan "$name" "$docs/$name/plan.md" "$docs/$name/prd.md"; done
  echo "- Set TASKFLOW_TASK_ID to narrow this to one task."
fi

# Last, so it reads as a classification of what is above rather than a preamble
# to it. Taking over a workstream reads as a continuation, and `SKILL.md` rules
# that a new session or a changed implementation detail is never by itself a new
# task trigger — so work that was never registered can be picked up and carried
# a long way with nothing ever asking whether it should have been. Locating the
# branch is all this does; whether the work belongs here stays the Agent's call.
if [ "$report" = "1" ]; then
  echo "# No task for branch '$current_branch'"
  echo "- Work on this branch is not registered: no TaskFlowDocs/<task>/ matches it. If it should be, record it before continuing."
fi
exit 0
