#!/usr/bin/env bash
# summarize-state — derive a short, non-authoritative TaskFlow state summary.
# Prints nothing when no TaskFlowDocs exists. Runs from the repo root.
# Cross-platform: invoked via run-hook.cmd (Git-bash on Windows).

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
repo_root="${TASKFLOW_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")}"
[ -n "$repo_root" ] || repo_root="$PLUGIN_ROOT"
docs="$repo_root/TaskFlowDocs"
[ -d "$docs" ] || exit 0

todo="$docs/todo.md"
verbose="${TASKFLOW_VERBOSE:-0}"
task_id="${TASKFLOW_TASK_ID:-}"
python_cmd="$(bash "$(dirname "$0")/python-runtime")"
active_count=$(find "$docs" -mindepth 2 -maxdepth 2 -name plan.md -not -path '*/achieved/*' -not -path '*/repository-docs/*' | wc -l)
if [ -f "$todo" ] && { [ "$verbose" = 1 ] || [ "$active_count" -eq 0 ]; }; then
  echo "# TaskFlow inbox (not done)"
  "$python_cmd" - "$todo" <<'PY'
import re, sys
text = open(sys.argv[1], encoding='utf-8').read()
parts = re.split(r'(?m)^(## .*)$', text)
for i in range(1, len(parts), 2):
    body = parts[i+1]
    m = re.search(r'(?m)^- ID:\s*(\S+)', body)
    if not m or m.group(1) in {'T-YYYYMMDD-001', 'YYYYMMDD-001'}: continue
    st = re.search(r'(?m)^- Status:\s*(\S+)', body)
    if st and st.group(1) == 'done': continue
    g = re.search(r'(?m)^- Goal:\s*(.+)', body)
    print(f"- {m.group(1)} | {st.group(1) if st else '?'} | {(g.group(1) if g else '').strip()[:120]}")
PY
fi

echo "# Active tasks"
"$python_cmd" - "$docs" <<'PY'
import os, pathlib, re, sys
task_id = os.environ.get("TASKFLOW_TASK_ID", "").strip()
verbose = os.environ.get("TASKFLOW_VERBOSE", "0") == "1"
active = []
for directory in sorted(pathlib.Path(sys.argv[1]).iterdir()):
    if not directory.is_dir() or directory.name in {'achieved', 'repository-docs'}: continue
    plan = directory / 'plan.md'
    if not plan.is_file(): continue
    text = plan.read_text(encoding='utf-8')
    def value(pattern, default='?'):
        match = re.search(pattern, text, re.M)
        return match.group(1).strip() if match else default
    version = value(r'^> Task version:\s*(.+)$')
    status = value(r'^> Status:\s*(.+)$')
    title = value(r'^# Plan\s*(?:—|-)?\s*(.+)$', directory.name)
    approval_section = re.search(r'(?ms)^## Approval\s*(.*?)(?=^## |\Z)', text)
    approval = '?'
    if approval_section:
        match = re.search(r'(?m)^- Status:\s*(.+)$', approval_section.group(1))
        approval = match.group(1).strip() if match else '?'
    next_step = None
    for step in re.finditer(r'(?ms)^### Step (\d+)\s*(?:—|-)?\s*(.*?)(?=^### Step |^## |\Z)', text):
        step_status = re.search(r'(?m)^- Status:\s*(\S+)', step.group(2))
        if not step_status or step_status.group(1) != 'done':
            step_title = step.group(2).splitlines()[0].strip()
            next_step = f"Step {step.group(1)} {step_title} [{step_status.group(1) if step_status else '?'}]"
            break
    active.append((directory, version, status, title, approval, next_step))
if task_id:
    selected = [item for item in active if item[0].name == task_id]
    if not selected:
        print(f"- Requested task unavailable: {task_id}")
        raise SystemExit(0)
elif len(active) == 1:
    selected = active
elif len(active) > 1:
    print(f"- Multiple active tasks ({len(active)}); set TASKFLOW_TASK_ID to select one.")
    selected = []
else:
    selected = []
if verbose:
    selected = active
for directory, version, status, title, approval, next_step in selected:
    suffix = f" | approval: {approval}" + (f" | next: {next_step}" if next_step else '')
    print(f"- {directory.name} | {version} | {status} — {title}{suffix}")
PY
exit 0
