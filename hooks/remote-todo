#!/usr/bin/env bash
# Explicit remote Todo operations; a missing configuration keeps local mode.
set -euo pipefail
usage() { echo 'usage: remote-todo mode|validate|list [--root <path>] | snapshot <new-file> [--root <path>] | create <alias> <title> <body-file> [--root <path>] | edit <alias> <number> title|body <value> [--root <path>] | stage <alias> <number> <stage> [--root <path>] | label <alias> <number> add|remove <label> [--root <path>] | resolve <operation-id> <number> [--root <path>] | resolve-absent <operation-id> --checked [--root <path>] | ack-update <operation-id> --checked [--root <path>]' >&2; exit 2; }
[ "$#" -ge 1 ] || usage
command="$1"; shift
target=
if [ "$command" = snapshot ]; then [ "$#" -ge 1 ] || usage; target="$1"; shift; fi
if [ "$command" = ack-update ]; then
  [ "$#" -ge 2 ] && [ "$2" = --checked ] || usage
  resolve_id="$1"; shift 2
fi
if [ "$command" = resolve-absent ]; then
  [ "$#" -ge 2 ] && [ "$2" = --checked ] || usage
  resolve_id="$1"; shift 2
fi
if [ "$command" = resolve ]; then
  [ "$#" -ge 2 ] || usage
  resolve_id="$1"; resolve_number="$2"; shift 2
fi
if [ "$command" = label ]; then
  [ "$#" -ge 4 ] || usage
  selected="$1"; issue_number="$2"; action="$3"; label="$4"; shift 4
fi
if [ "$command" = stage ]; then
  [ "$#" -ge 3 ] || usage
  selected="$1"; issue_number="$2"; stage="$3"; shift 3
fi
if [ "$command" = edit ]; then
  [ "$#" -ge 4 ] || usage
  selected="$1"; issue_number="$2"; field="$3"; value="$4"; shift 4
fi
if [ "$command" = create ]; then
  [ "$#" -ge 3 ] || usage
  selected="$1"; title="$2"; body="$3"; shift 3
fi
root=.
if [ "$#" -gt 0 ]; then
  [ "$#" -eq 2 ] && [ "$1" = --root ] || usage
  root="$2"
fi
case "$command" in mode|validate|list|snapshot|create|edit|stage|label|resolve|resolve-absent|ack-update) ;; *) usage ;; esac
if [ "$command" = snapshot ]; then
  [ -n "$target" ] && [ ! -e "$target" ] && [ ! -L "$target" ] || { echo 'Snapshot target must be a new file.' >&2; exit 2; }
  echo 'Snapshot may contain private issue data; protect the selected file.' >&2
  if ! content="$(bash "$0" list --root "$root")"; then echo 'Snapshot not created: remote listing incomplete.' >&2; exit 2; fi
  umask 077
  (set -o noclobber; printf 'Snapshot UTC: %s (read-only historical data; may be stale)\n%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$content" > "$target") || { echo 'Cannot create snapshot.' >&2; exit 2; }
  exit 0
fi
config="$root/TaskFlowDocs/remote-todos.conf"
if [ ! -e "$config" ] && [ ! -L "$config" ]; then
  case "$command" in mode) echo local ;; validate) echo 'OK local' ;; list|create|edit|stage|label|resolve|resolve-absent|ack-update) echo 'No remote Todo repositories configured.' >&2; exit 2 ;; esac
  exit 0
fi
[ -f "$config" ] && [ ! -L "$config" ] || { echo 'Invalid remote Todo configuration.' >&2; exit 2; }
# The file has a mode line followed by tab-separated alias, platform, host and path.
# Never print rejected data: it might contain accidentally pasted credentials.
result=$(awk -F '\t' -v action="$command" '
  function invalid() { bad = 1 }
  NR == 1 {
    if (NF != 1 || ($1 != "local" && $1 != "remote")) invalid()
    mode = $1
    next
  }
  {
    if (NF != 4 || $1 !~ /^[A-Za-z0-9][A-Za-z0-9_-]*$/ || ($2 != "github" && $2 != "gitlab")) invalid()
    if ($3 !~ /^[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]+)?$/ || $3 ~ /\.\./) invalid()
    if ($4 !~ /^[A-Za-z0-9_.-]+(\/[A-Za-z0-9_.-]+)+$/ || $4 ~ /(^|\/)\.\.?($|\/)/) invalid()
    if ($2 == "github" && split($4, parts, "/") != 2) invalid()
    if (seen[$1]++) invalid()
  }
  END {
    if (NR == 0 || bad) { print "Invalid remote Todo configuration." > "/dev/stderr"; exit 2 }
    if (action == "mode") print mode
    else if (action == "validate") print "OK " mode
  }
' "$config")
if [ "$command" = mode ] || [ "$command" = validate ]; then
  printf '%s\n' "$result"
  exit 0
fi
if [ "$command" = label ]; then
  [[ "$selected" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] && [[ "$issue_number" =~ ^[1-9][0-9]*$ ]] || { echo 'Invalid source or Issue number.' >&2; exit 2; }
  case "$action" in add|remove) ;; *) echo 'Invalid label operation.' >&2; exit 2 ;; esac
  [ -n "$label" ] && [[ "$label" != *[[:cntrl:]]* ]] || { echo 'Invalid label.' >&2; exit 2; }
  case "$label" in taskflow:*) echo 'TaskFlow stage labels are managed by the stage command.' >&2; exit 2 ;; esac
  connection="$(awk -F '\t' -v name="$selected" 'NR > 1 && $1 == name { print; found = 1 } END { if (!found) exit 2 }' "$config")" || { echo 'Unknown source alias.' >&2; exit 2; }
  tab="$(printf '\t')"
  IFS="$tab" read -r alias platform host project <<EOF
$connection
EOF
  if [ "$platform" = github ]; then endpoint="repos/$project/issues/$issue_number"; number_key=number
  else
    case "$label" in *,*) echo 'GitLab label names containing commas cannot be changed safely through this interface.' >&2; exit 2 ;; esac
    encoded="${project//\//%2F}"; endpoint="projects/$encoded/issues/$issue_number"; number_key=iid
  fi
  HERE="$(cd "$(dirname "$0")" && pwd)"
  label_get() {
    if [ "$platform" = github ]; then gh api "$endpoint" --hostname "$host" --jq 'select(.pull_request == null) | .labels |= map(.name)' 2>/dev/null
    else glab api "$endpoint" --hostname "$host" 2>/dev/null; fi
  }
  before="$(label_get)" || { echo 'Cannot read remote Issue; label not changed.' >&2; exit 2; }
  actual="$(printf '%s' "$before" | bash "$HERE/json-field" --numbers "$number_key")" || { echo 'Cannot parse remote Issue.' >&2; exit 2; }
  [ "$actual" = "$issue_number" ] || { echo 'Remote Issue identity mismatch.' >&2; exit 2; }
  has="$(printf '%s' "$before" | bash "$HERE/json-field" --array-has labels "$label")" || { echo 'Cannot parse Issue labels.' >&2; exit 2; }
  if { [ "$action" = add ] && [ "$has" = yes ]; } || { [ "$action" = remove ] && [ "$has" = no ]; }; then echo 'Label already has the requested state.'; exit 0; fi
  id="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  [[ "$id" =~ ^[0-9a-f]{32}$ ]] || { echo 'Cannot allocate operation ID.' >&2; exit 2; }
  store="$root/TaskFlowDocs/.remote-todo-updates"
  umask 077
  [ ! -L "$store" ] || { echo 'Invalid operation directory.' >&2; exit 2; }
  mkdir -p "$store"
  [ -d "$store" ] && [ ! -L "$store" ] || { echo 'Invalid operation directory.' >&2; exit 2; }
  normalized_host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"
  normalized_project="$project"
  if [ "$platform" = github ]; then normalized_project="$(printf '%s' "$project" | tr '[:upper:]' '[:lower:]')"; fi
  lock_id="$(printf '%s\n%s\n%s\n%s\nlabel\n' "$platform" "$normalized_host" "$normalized_project" "$issue_number" | cksum | awk '{ print $1 "-" $2 }')"
  lock="$store/.edit-$lock_id"
  mkdir "$lock" 2>/dev/null || { echo 'A label update is already in progress or needs inspection.' >&2; exit 2; }
  trap 'rmdir "$lock" 2>/dev/null || true' EXIT
  for existing in "$store"/*; do
    [ -e "$existing" ] || [ -L "$existing" ] || continue
    [ -f "$existing" ] && [ ! -L "$existing" ] || { echo 'Invalid operation record.' >&2; exit 2; }
    if awk -F '\t' -v p="$platform" -v h="$host" -v r="$project" -v n="$issue_number" '
      NR == 1 { valid = NF == 7 && $1 == "pending"; same = $2 == p && tolower($3) == tolower(h) && (p == "github" ? tolower($4) == tolower(r) : $4 == r) && $5 == n && $6 == "label" }
      NR == 2 && ($1 == "confirmed" || $1 == "reviewed") { resolved = 1 }
      END { if (!valid || (same && !resolved)) exit 0; exit 1 }
    ' "$existing"; then echo 'Unresolved label update exists; inspect it before retrying.' >&2; exit 2; fi
  done
  record="$store/$id"
  (set -o noclobber; printf 'pending\t%s\t%s\t%s\t%s\tlabel\t%s\n' "$platform" "$host" "$project" "$issue_number" "$id" > "$record") || { echo 'Cannot save operation intent.' >&2; exit 2; }
  echo 'Updating one label; GitLab may create a missing label. Concurrent edits may race.' >&2
  if [ "$platform" = github ] && [ "$action" = add ]; then
    gh api "$endpoint/labels" --hostname "$host" --method POST --raw-field "labels[]=$label" >/dev/null 2>&1 || { echo "Result unknown for operation $id; inspect the Issue before retrying." >&2; exit 2; }
  elif [ "$platform" = github ]; then
    encoded_label=''
    LC_ALL=C
    for ((i=0; i<${#label}; i++)); do
      c="${label:i:1}"
      case "$c" in [A-Za-z0-9._~-]) encoded_label="$encoded_label$c" ;; *) printf -v hex '%%%02X' "'$c"; encoded_label="$encoded_label$hex" ;; esac
    done
    gh api "$endpoint/labels/$encoded_label" --hostname "$host" --method DELETE >/dev/null 2>&1 || { echo "Result unknown for operation $id; inspect the Issue before retrying." >&2; exit 2; }
  else
    glab api "$endpoint" --hostname "$host" --method PUT --raw-field "${action}_labels=$label" >/dev/null 2>&1 || { echo "Result unknown for operation $id; inspect the Issue before retrying." >&2; exit 2; }
  fi
  after="$(label_get)" || { echo "Result unknown for operation $id; inspect the Issue before retrying." >&2; exit 2; }
  actual="$(printf '%s' "$after" | bash "$HERE/json-field" --numbers "$number_key")" || { echo "Result unknown for operation $id." >&2; exit 2; }
  [ "$actual" = "$issue_number" ] || { echo "Result unknown for operation $id: identity mismatch." >&2; exit 2; }
  has="$(printf '%s' "$after" | bash "$HERE/json-field" --array-has labels "$label")" || { echo "Result unknown for operation $id: invalid labels." >&2; exit 2; }
  if { [ "$action" = add ] && [ "$has" != yes ]; } || { [ "$action" = remove ] && [ "$has" != no ]; }; then echo "Result unknown for operation $id: label state mismatch." >&2; exit 2; fi
  printf 'confirmed\n' >> "$record" || { echo "Result unknown for operation $id; inspect the Issue before retrying." >&2; exit 2; }
  printf 'Updated label on %s #%s (operation %s).\n' "$selected" "$issue_number" "$id"
  exit 0
fi
if [ "$command" = stage ]; then
  [[ "$selected" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] && [[ "$issue_number" =~ ^[1-9][0-9]*$ ]] || { echo 'Invalid source or Issue number.' >&2; exit 2; }
  case "$stage" in inbox|clarified|promoted|in_progress|done|cancelled) ;; *) echo 'Invalid TaskFlow stage.' >&2; exit 2 ;; esac
  connection="$(awk -F '\t' -v name="$selected" 'NR > 1 && $1 == name { print; found = 1 } END { if (!found) exit 2 }' "$config")" || { echo 'Unknown source alias.' >&2; exit 2; }
  tab="$(printf '\t')"
  IFS="$tab" read -r alias platform host project <<EOF
$connection
EOF
  if [ "$platform" = github ]; then endpoint="repos/$project/issues/$issue_number"; number_key=number
  else encoded="${project//\//%2F}"; endpoint="projects/$encoded/issues/$issue_number"; number_key=iid; fi
  HERE="$(cd "$(dirname "$0")" && pwd)"
  stage_get() {
    if [ "$platform" = github ]; then gh api "$endpoint" --hostname "$host" --jq 'select(.pull_request == null) | .labels |= map(.name)' 2>/dev/null
    else glab api "$endpoint" --hostname "$host" 2>/dev/null; fi
  }
  before="$(stage_get)" || { echo 'Cannot read remote Issue; stage not changed.' >&2; exit 2; }
  actual="$(printf '%s' "$before" | bash "$HERE/json-field" --numbers "$number_key")" || { echo 'Cannot parse remote Issue.' >&2; exit 2; }
  [ "$actual" = "$issue_number" ] || { echo 'Remote Issue identity mismatch.' >&2; exit 2; }
  present=''
  for item in inbox clarified promoted in_progress done cancelled; do
    has="$(printf '%s' "$before" | bash "$HERE/json-field" --array-has labels "taskflow:$item")" || { echo 'Cannot parse Issue labels.' >&2; exit 2; }
    if [ "$has" = yes ] && [ "$item" != "$stage" ]; then present="$present $item"; fi
  done
  desired="taskflow:$stage"
  desired_state=open; event=reopen
  case "$stage" in done|cancelled) desired_state=closed; event=close ;; esac
  id="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  [[ "$id" =~ ^[0-9a-f]{32}$ ]] || { echo 'Cannot allocate operation ID.' >&2; exit 2; }
  store="$root/TaskFlowDocs/.remote-todo-updates"
  umask 077
  [ ! -L "$store" ] || { echo 'Invalid operation directory.' >&2; exit 2; }
  mkdir -p "$store"
  [ -d "$store" ] && [ ! -L "$store" ] || { echo 'Invalid operation directory.' >&2; exit 2; }
  normalized_host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"
  normalized_project="$project"
  if [ "$platform" = github ]; then normalized_project="$(printf '%s' "$project" | tr '[:upper:]' '[:lower:]')"; fi
  lock_id="$(printf '%s\n%s\n%s\n%s\nstage\n' "$platform" "$normalized_host" "$normalized_project" "$issue_number" | cksum | awk '{ print $1 "-" $2 }')"
  lock="$store/.edit-$lock_id"
  mkdir "$lock" 2>/dev/null || { echo 'A stage update is already in progress or needs inspection.' >&2; exit 2; }
  trap 'rmdir "$lock" 2>/dev/null || true' EXIT
  for existing in "$store"/*; do
    [ -e "$existing" ] || [ -L "$existing" ] || continue
    [ -f "$existing" ] && [ ! -L "$existing" ] || { echo 'Invalid operation record.' >&2; exit 2; }
    if awk -F '\t' -v p="$platform" -v h="$host" -v r="$project" -v n="$issue_number" '
      NR == 1 { valid = NF == 7 && $1 == "pending"; same = $2 == p && tolower($3) == tolower(h) && (p == "github" ? tolower($4) == tolower(r) : $4 == r) && $5 == n && $6 == "stage" }
      NR == 2 && ($1 == "confirmed" || $1 == "reviewed") { resolved = 1 }
      END { if (!valid || (same && !resolved)) exit 0; exit 1 }
    ' "$existing"; then echo 'Unresolved stage update exists; inspect it before retrying.' >&2; exit 2; fi
  done
  record="$store/$id"
  (set -o noclobber; printf 'pending\t%s\t%s\t%s\t%s\tstage\t%s\n' "$platform" "$host" "$project" "$issue_number" "$id" > "$record") || { echo 'Cannot save operation intent.' >&2; exit 2; }
  echo 'Updating TaskFlow labels and Issue state; existing non-TaskFlow labels are retained. Missing labels may need creation or permissions; concurrent edits may race.' >&2
  if [ "$platform" = github ]; then
    for item in $present; do
      gh api "$endpoint/labels/taskflow%3A$item" --hostname "$host" --method DELETE >/dev/null 2>&1 || { echo "Result unknown for operation $id; inspect the Issue before retrying." >&2; exit 2; }
    done
    gh api "$endpoint/labels" --hostname "$host" --method POST --raw-field "labels[]=$desired" >/dev/null 2>&1 || { echo "Result unknown for operation $id; inspect the Issue before retrying." >&2; exit 2; }
    gh api "$endpoint" --hostname "$host" --method PATCH --raw-field "state=$desired_state" >/dev/null 2>&1 || { echo "Result unknown for operation $id; inspect the Issue before retrying." >&2; exit 2; }
  else
    remove=''
    for item in $present; do if [ -n "$remove" ]; then remove="$remove,"; fi; remove="${remove}taskflow:$item"; done
    glab api "$endpoint" --hostname "$host" --method PUT --raw-field "add_labels=$desired" --raw-field "remove_labels=$remove" --raw-field "state_event=$event" >/dev/null 2>&1 || { echo "Result unknown for operation $id; inspect the Issue before retrying." >&2; exit 2; }
  fi
  after="$(stage_get)" || { echo "Result unknown for operation $id; inspect the Issue before retrying." >&2; exit 2; }
  actual="$(printf '%s' "$after" | bash "$HERE/json-field" --numbers "$number_key")" || { echo "Result unknown for operation $id." >&2; exit 2; }
  [ "$actual" = "$issue_number" ] || { echo "Result unknown for operation $id: identity mismatch." >&2; exit 2; }
  actual="$(printf '%s' "$after" | bash "$HERE/json-field" state)" || { echo "Result unknown for operation $id." >&2; exit 2; }
  if [ "$platform" = gitlab ] && [ "$desired_state" = open ]; then desired_state=opened; fi
  [ "$actual" = "$desired_state" ] || { echo "Result unknown for operation $id: state mismatch." >&2; exit 2; }
  for item in inbox clarified promoted in_progress done cancelled; do
    has="$(printf '%s' "$after" | bash "$HERE/json-field" --array-has labels "taskflow:$item")" || { echo "Result unknown for operation $id: invalid labels." >&2; exit 2; }
    if { [ "$item" = "$stage" ] && [ "$has" != yes ]; } || { [ "$item" != "$stage" ] && [ "$has" = yes ]; }; then echo "Result unknown for operation $id: stage mismatch." >&2; exit 2; fi
  done
  printf 'confirmed\n' >> "$record" || { echo "Result unknown for operation $id; inspect the Issue before retrying." >&2; exit 2; }
  printf 'Updated stage for %s #%s (operation %s).\n' "$selected" "$issue_number" "$id"
  exit 0
fi
if [ "$command" = ack-update ]; then
  [[ "$resolve_id" =~ ^[0-9a-f]{32}$ ]] || { echo 'Invalid operation ID.' >&2; exit 2; }
  record="$root/TaskFlowDocs/.remote-todo-updates/$resolve_id"
  [ -f "$record" ] && [ ! -L "$record" ] && [ ! -L "$root/TaskFlowDocs/.remote-todo-updates" ] || { echo 'Operation record not found.' >&2; exit 2; }
  if ! awk -F '\t' -v id="$resolve_id" 'NR == 1 { valid = NF == 7 && $1 == "pending" && $7 == id } NR > 1 { resolved = 1 } END { if (!valid || resolved) exit 1 }' "$record"; then echo 'Invalid or resolved operation.' >&2; exit 2; fi
  printf 'reviewed\n' >> "$record" || { echo 'Cannot save the decision.' >&2; exit 2; }
  echo 'Recorded user review; no remote Issue was changed.'
  exit 0
fi
if [ "$command" = edit ]; then
  [[ "$selected" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] && [[ "$issue_number" =~ ^[1-9][0-9]*$ ]] || { echo 'Invalid source or Issue number.' >&2; exit 2; }
  case "$field" in title) [ -n "$value" ] || { echo 'Title must not be empty.' >&2; exit 2; } ;; body) [ -f "$value" ] && [ -r "$value" ] || { echo 'Body must be a readable file.' >&2; exit 2; } ;; *) echo 'Only title and body can be edited.' >&2; exit 2 ;; esac
  connection="$(awk -F '\t' -v name="$selected" 'NR > 1 && $1 == name { print; found = 1 } END { if (!found) exit 2 }' "$config")" || { echo 'Unknown source alias.' >&2; exit 2; }
  tab="$(printf '\t')"
  IFS="$tab" read -r alias platform host project <<EOF
$connection
EOF
  if [ "$platform" = github ]; then endpoint="repos/$project/issues/$issue_number"; cli=gh; method=PATCH; number_key=number; body_key=body
  else encoded="${project//\//%2F}"; endpoint="projects/$encoded/issues/$issue_number"; cli=glab; method=PUT; number_key=iid; body_key=description; fi
  HERE="$(cd "$(dirname "$0")" && pwd)"
  get_issue() {
    if [ "$platform" = github ]; then gh api "$endpoint" --hostname "$host" --jq 'select(.pull_request == null)' 2>/dev/null
    else glab api "$endpoint" --hostname "$host" 2>/dev/null; fi
  }
  before="$(get_issue)" || { echo 'Cannot read remote Issue; edit not started.' >&2; exit 2; }
  actual="$(printf '%s' "$before" | bash "$HERE/json-field" --numbers "$number_key")" || { echo 'Cannot parse remote Issue; edit not started.' >&2; exit 2; }
  [ "$actual" = "$issue_number" ] || { echo 'Remote Issue identity mismatch; edit not started.' >&2; exit 2; }
  if [ "$field" = title ]; then expected="$value"; api_field=title
  else expected="$(cat "$value")" || { echo 'Cannot read body file.' >&2; exit 2; }; api_field="$body_key"; fi
  id="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  [[ "$id" =~ ^[0-9a-f]{32}$ ]] || { echo 'Cannot allocate operation ID.' >&2; exit 2; }
  store="$root/TaskFlowDocs/.remote-todo-updates"
  umask 077
  [ ! -L "$store" ] || { echo 'Invalid operation directory.' >&2; exit 2; }
  mkdir -p "$store"
  [ -d "$store" ] && [ ! -L "$store" ] || { echo 'Invalid operation directory.' >&2; exit 2; }
  normalized_host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"
  normalized_project="$project"
  if [ "$platform" = github ]; then normalized_project="$(printf '%s' "$project" | tr '[:upper:]' '[:lower:]')"; fi
  lock_id="$(printf '%s\n%s\n%s\n%s\n%s\n' "$platform" "$normalized_host" "$normalized_project" "$issue_number" "$field" | cksum | awk '{ print $1 "-" $2 }')"
  lock="$store/.edit-$lock_id"
  mkdir "$lock" 2>/dev/null || { echo 'An edit for this field is already in progress or needs inspection.' >&2; exit 2; }
  trap 'rmdir "$lock" 2>/dev/null || true' EXIT
  for existing in "$store"/*; do
    [ -e "$existing" ] || [ -L "$existing" ] || continue
    [ -f "$existing" ] && [ ! -L "$existing" ] || { echo 'Invalid operation record.' >&2; exit 2; }
    if awk -F '\t' -v p="$platform" -v h="$host" -v r="$project" -v n="$issue_number" -v f="$field" '
      NR == 1 { valid = NF == 7 && $1 == "pending"; same = $2 == p && tolower($3) == tolower(h) && (p == "github" ? tolower($4) == tolower(r) : $4 == r) && $5 == n && $6 == f }
      NR == 2 && ($1 == "confirmed" || $1 == "reviewed") { resolved = 1 }
      END { if (!valid || (same && !resolved)) exit 0; exit 1 }
    ' "$existing"; then echo 'Unresolved update exists; inspect it before editing this field.' >&2; exit 2; fi
  done
  record="$store/$id"
  (set -o noclobber; printf 'pending\t%s\t%s\t%s\t%s\t%s\t%s\n' "$platform" "$host" "$project" "$issue_number" "$field" "$id" > "$record") || { echo 'Cannot save operation intent.' >&2; exit 2; }
  echo 'Editing only the requested field; concurrent edits can still be overwritten.' >&2
  if [ "$field" = title ]; then
    if response="$("$cli" api "$endpoint" --hostname "$host" --method "$method" --raw-field "title=$value" 2>/dev/null)"; then :
    else echo "Result unknown for operation $id; inspect the remote Issue before retrying." >&2; exit 2; fi
  else
    if response="$(cat "$value" | "$cli" api "$endpoint" --hostname "$host" --method "$method" --field "$api_field=@-" 2>/dev/null)"; then :
    else echo "Result unknown for operation $id; inspect the remote Issue before retrying." >&2; exit 2; fi
  fi
  after="$(get_issue)" || { echo "Result unknown for operation $id; inspect the remote Issue before retrying." >&2; exit 2; }
  actual="$(printf '%s' "$after" | bash "$HERE/json-field" --numbers "$number_key")" || { echo "Result unknown for operation $id." >&2; exit 2; }
  [ "$actual" = "$issue_number" ] || { echo "Result unknown for operation $id: Issue identity changed." >&2; exit 2; }
  actual="$(printf '%s' "$after" | bash "$HERE/json-field" "$api_field")" || { echo "Result unknown for operation $id." >&2; exit 2; }
  [ "$actual" = "$expected" ] || { echo "Result unknown for operation $id: requested field differs after write." >&2; exit 2; }
  printf 'confirmed\n' >> "$record" || { echo "Result unknown for operation $id; inspect the remote Issue before retrying." >&2; exit 2; }
  printf 'Updated %s #%s (operation %s).\n' "$selected" "$issue_number" "$id"
  exit 0
fi
if [ "$command" = resolve-absent ]; then
  [[ "$resolve_id" =~ ^[0-9a-f]{32}$ ]] || { echo 'Invalid operation ID.' >&2; exit 2; }
  record="$root/TaskFlowDocs/.remote-todo-operations/$resolve_id"
  [ -f "$record" ] && [ ! -L "$record" ] && [ ! -L "$root/TaskFlowDocs/.remote-todo-operations" ] || { echo 'Operation record not found.' >&2; exit 2; }
  tab="$(printf '\t')"
  IFS="$tab" read -r state platform host project saved_id < "$record"
  [ "$state" = pending ] && [ "$saved_id" = "$resolve_id" ] || { echo 'Invalid operation record.' >&2; exit 2; }
  if awk -F '\t' 'NR > 1 && ($1 == "confirmed" || $1 == "absent") { found = 1 } END { if (!found) exit 1 }' "$record"; then
    echo 'Operation already resolved.' >&2; exit 2
  fi
  printf 'absent\tuser-checked\n' >> "$record" || { echo 'Cannot save the decision.' >&2; exit 2; }
  echo 'Recorded user-confirmed absence; no remote Issue was changed.'
  exit 0
fi
if [ "$command" = resolve ]; then
  [[ "$resolve_id" =~ ^[0-9a-f]{32}$ ]] && [[ "$resolve_number" =~ ^[1-9][0-9]*$ ]] || { echo 'Invalid operation ID or Issue number.' >&2; exit 2; }
  record="$root/TaskFlowDocs/.remote-todo-operations/$resolve_id"
  [ -f "$record" ] && [ ! -L "$record" ] && [ ! -L "$root/TaskFlowDocs/.remote-todo-operations" ] || { echo 'Operation record not found.' >&2; exit 2; }
  tab="$(printf '\t')"
  IFS="$tab" read -r state platform host project saved_id < "$record"
  [ "$state" = pending ] && [ "$saved_id" = "$resolve_id" ] || { echo 'Invalid operation record.' >&2; exit 2; }
  awk -F '\t' -v p="$platform" -v h="$host" -v r="$project" 'NR > 1 && $2 == p && $3 == h && $4 == r { found = 1 } END { if (!found) exit 1 }' "$config" || { echo 'Operation source is not configured.' >&2; exit 2; }
  if awk -F '\t' 'NR > 1 && ($1 == "confirmed" || $1 == "absent") { found = 1 } END { if (!found) exit 1 }' "$record"; then
    echo 'Operation already confirmed.' >&2; exit 2
  fi
  if [ "$platform" = github ]; then
    response="$(gh api "repos/$project/issues/$resolve_number" --hostname "$host" --jq 'select(.pull_request == null)' 2>/dev/null)" || { echo 'Cannot verify remote Issue.' >&2; exit 2; }
    number_key=number; body_key=body
  else
    encoded="${project//\//%2F}"
    response="$(glab api "projects/$encoded/issues/$resolve_number" --hostname "$host" 2>/dev/null)" || { echo 'Cannot verify remote Issue.' >&2; exit 2; }
    number_key=iid; body_key=description
  fi
  HERE="$(cd "$(dirname "$0")" && pwd)"
  actual="$(printf '%s' "$response" | bash "$HERE/json-field" --numbers "$number_key")" || { echo 'Cannot parse remote Issue.' >&2; exit 2; }
  body_value="$(printf '%s' "$response" | bash "$HERE/json-field" "$body_key")" || { echo 'Cannot parse remote Issue.' >&2; exit 2; }
  [ "$actual" = "$resolve_number" ] || { echo 'Remote Issue identity mismatch.' >&2; exit 2; }
  case "$body_value" in *"<!-- taskflow-operation:$resolve_id -->"*) ;; *) echo 'Remote Issue operation marker mismatch.' >&2; exit 2 ;; esac
  printf 'confirmed\t%s\n' "$resolve_number" >> "$record" || { echo 'Cannot confirm operation.' >&2; exit 2; }
  printf 'Operation %s confirmed as Issue #%s.\n' "$resolve_id" "$resolve_number"
  exit 0
fi
if [ "$command" = create ]; then
  [[ "$selected" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || { echo 'Invalid source alias.' >&2; exit 2; }
  [ -n "$title" ] && [ -f "$body" ] && [ -r "$body" ] || { echo 'A title and readable body file are required.' >&2; exit 2; }
  connection="$(awk -F '\t' -v name="$selected" 'NR > 1 && $1 == name { print; found = 1 } END { if (!found) exit 2 }' "$config")" || { echo 'Unknown source alias.' >&2; exit 2; }
  tab="$(printf '\t')"
  IFS="$tab" read -r alias platform host project <<EOF
$connection
EOF
  id="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  [[ "$id" =~ ^[0-9a-f]{32}$ ]] || { echo 'Cannot allocate operation ID.' >&2; exit 2; }
  store="$root/TaskFlowDocs/.remote-todo-operations"
  umask 077
  [ ! -L "$store" ] || { echo 'Invalid operation directory.' >&2; exit 2; }
  mkdir -p "$store"
  [ -d "$store" ] && [ ! -L "$store" ] || { echo 'Invalid operation directory.' >&2; exit 2; }
  normalized_host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"
  normalized_project="$project"
  if [ "$platform" = github ]; then normalized_project="$(printf '%s' "$project" | tr '[:upper:]' '[:lower:]')"; fi
  lock_id="$(printf '%s\n%s\n%s\n' "$platform" "$normalized_host" "$normalized_project" | cksum | awk '{ print $1 "-" $2 }')"
  lock="$store/.create-$lock_id"
  # Only the empty directory created by this process is removed; crash locks are retained.
  mkdir "$lock" 2>/dev/null || { echo 'A creation for this source is already in progress or needs inspection.' >&2; exit 2; }
  trap 'rmdir "$lock" 2>/dev/null || true' EXIT
  for existing in "$store"/*; do
    [ -e "$existing" ] || [ -L "$existing" ] || continue
    [ -f "$existing" ] && [ ! -L "$existing" ] || { echo 'Invalid operation record.' >&2; exit 2; }
    if awk -F '\t' -v p="$platform" -v h="$host" -v r="$project" '
      NR == 1 { valid = NF == 5 && $1 == "pending"; same = $2 == p && tolower($3) == tolower(h) && (p == "github" ? tolower($4) == tolower(r) : $4 == r) }
      NR == 2 && NF == 2 && (($1 == "confirmed" && $2 ~ /^[1-9][0-9]*$/) || ($1 == "absent" && $2 == "user-checked")) { confirmed = 1 }
      END { if (!valid || (same && !confirmed)) exit 0; exit 1 }
    ' "$existing"; then
      echo 'Unresolved creation operation exists; inspect and resolve it before creating another Issue in this source.' >&2
      exit 2
    fi
  done
  record="$store/$id"
  (set -o noclobber; printf 'pending\t%s\t%s\t%s\t%s\n' "$platform" "$host" "$project" "$id" > "$record") || { echo 'Cannot save operation intent.' >&2; exit 2; }
  echo 'Creating remote Issue; concurrent changes may not be detected.' >&2
  if [ "$platform" = github ]; then
    if response="$({ cat "$body"; printf '\n\n<!-- taskflow-operation:%s -->\n' "$id"; } | gh api "repos/$project/issues" --hostname "$host" --method POST --raw-field "title=$title" --field body=@- 2>/dev/null)"; then :
    else echo "Result unknown for operation $id; inspect the remote Issue before retrying." >&2; exit 2; fi
    key=number
  else
    encoded="${project//\//%2F}"
    if response="$({ cat "$body"; printf '\n\n<!-- taskflow-operation:%s -->\n' "$id"; } | glab api "projects/$encoded/issues" --hostname "$host" --method POST --raw-field "title=$title" --field description=@- 2>/dev/null)"; then :
    else echo "Result unknown for operation $id; inspect the remote Issue before retrying." >&2; exit 2; fi
    key=iid
  fi
  HERE="$(cd "$(dirname "$0")" && pwd)"
  number="$(printf '%s' "$response" | bash "$HERE/json-field" --numbers "$key")" || { echo "Result unknown for operation $id; inspect the remote Issue before retrying." >&2; exit 2; }
  [[ "$number" =~ ^[1-9][0-9]*$ ]] || { echo "Result unknown for operation $id; inspect the remote Issue before retrying." >&2; exit 2; }
  printf 'confirmed\t%s\n' "$number" >> "$record" || { echo "Result unknown for operation $id; inspect the remote Issue before retrying." >&2; exit 2; }
  printf 'Created %s #%s (operation %s).\n' "$selected" "$number" "$id"
  exit 0
fi
connections="$(awk 'NR > 1 { print }' "$config")"
[ -n "$connections" ] || { echo 'No remote Todo repositories configured.' >&2; exit 2; }
failed=0
tab="$(printf '\t')"
while IFS="$tab" read -r alias platform host project; do
  printf 'SOURCE %s %s %s %s\n' "$alias" "$platform" "$host" "$project"
  if [ "$platform" = github ]; then
    if output="$(gh api "repos/$project/issues?state=all&per_page=100" --hostname "$host" --paginate --jq '.[] | select(.pull_request == null) | @json' 2>/dev/null)"; then
      [ -z "$output" ] || printf '%s\n' "$output"
    else
      printf 'Incomplete: could not read source %s.\n' "$alias" >&2
      failed=1
    fi
  else
    encoded="${project//\//%2F}"
    if output="$(glab api "projects/$encoded/issues?scope=all&state=all&per_page=100" --hostname "$host" --paginate --output ndjson 2>/dev/null)"; then
      [ -z "$output" ] || printf '%s\n' "$output"
    else
      printf 'Incomplete: could not read source %s.\n' "$alias" >&2
      failed=1
    fi
  fi
done <<EOF
$connections
EOF
[ "$failed" -eq 0 ] || exit 2