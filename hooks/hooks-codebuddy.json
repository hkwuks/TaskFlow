{
  "description": "TaskFlow lifecycle hooks: SessionStart state summary, per-prompt in-flight task reminder, pre-write capability gate, and capability-call capture (CodeBuddy plugin form).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEBUDDY_PLUGIN_ROOT}/hooks/session-start\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEBUDDY_PLUGIN_ROOT}/hooks/prompt-reminder\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEBUDDY_PLUGIN_ROOT}/hooks/capability-gate\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEBUDDY_PLUGIN_ROOT}/hooks/capability-evidence\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEBUDDY_PLUGIN_ROOT}/hooks/capability-evidence\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
