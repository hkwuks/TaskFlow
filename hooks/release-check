#!/usr/bin/env bash
# release-check — read-only version-consistency check for a release.
# Usage: release-check [repository-root]
# Every version literal a release has to move must agree, and the marketplace pin
# must resolve to the commit it names. Not attached to automatic hooks.
set -euo pipefail
LC_ALL=C
export LC_ALL

root="${1:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
if [ -z "$root" ] || [ ! -d "$root" ]; then
  echo "STATUS: blocked"
  echo "- Cannot identify a repository root."
  exit 3
fi
cd "$root"

claude_manifest=".claude-plugin/plugin.json"
codex_manifest=".codex-plugin/plugin.json"
codebuddy_manifest=".codebuddy-plugin/plugin.json"
dsh_manifest="package.json"
marketplace=".claude-plugin/marketplace.json"
codebuddy_marketplace=".codebuddy-plugin/marketplace.json"

# The version literals are validated by field name rather than by parsing JSON:
# the manifests are repository-owned and CODE_STYLE fixes their shape, so a
# parser would be a dependency bought for a format that does not move. A missing
# file blocks the check instead — an absent manifest is a repository defect, not
# a version mismatch to report.
blocked=0
for file in "$claude_manifest" "$codex_manifest" "$codebuddy_manifest" "$dsh_manifest" "$marketplace" "$codebuddy_marketplace" CHANGELOG.md README.md README.zh-CN.md; do
  if [ ! -f "$file" ]; then
    echo "- $file: missing"
    blocked=1
  fi
done
if [ "$blocked" -eq 1 ]; then
  echo "Repository: $root"
  echo "STATUS: blocked"
  exit 3
fi

needs=0
echo "Repository: $root"

jversion() { sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" | head -1; }

# Reads one scalar field *inside the plugin's `source` object* rather than
# anywhere in the file. A flat "first match wins" scan would silently read the
# wrong value as soon as a second top-level string repeats the field name (a
# second plugin entry, a later `ref`/`sha` pair), and a wrong pin read is
# precisely the failure this check exists to catch. The address range bounds the
# match to the object.
jpin() {
  sed -n '/"source"[[:space:]]*:[[:space:]]*{/,/}/p' "$1" \
    | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
    | head -1
}

claude_v="$(jversion "$claude_manifest")"
# The Codex and CodeBuddy cachebusters suffix the version
# (`1.0.5+codex.20260915`, `1.0.5+codebuddy.20260917`); only the release number
# has to agree with the tag. The dsh bundle manifest carries no suffix.
codex_v="$(jversion "$codex_manifest")"
codex_release="${codex_v%%+*}"
codebuddy_v="$(jversion "$codebuddy_manifest")"
codebuddy_release="${codebuddy_v%%+*}"
# The dsh bundle carries no cachebuster: dsh installs it through pnpm, which has
# its own integrity record, rather than through a host-side plugin cache.
dsh_v="$(jversion "$dsh_manifest")"
# The newest *version* section, not simply the newest section: an `## [Unreleased]`
# heading is the normal state between releases and is not a version literal.
changelog_v="$(sed -n 's/^## \[\([0-9][0-9.]*\)\].*/\1/p' CHANGELOG.md | head -1)"
# Every `Version:` sample line, not the first one. Each README carries two — the
# `claude plugin list` sample and the `codebuddy plugin list` sample — and a
# release moves both, so reading only the first left half of each file's literals
# uncompared. A file with no sample line at all yields nothing and is reported
# below as a mismatch rather than skipped.
readme_versions() { sed -n 's/^#.*Version:[[:space:]]*\([^[:space:]]*\).*/\1/p' "$1"; }
readme_v="$(readme_versions README.md)"
readme_zh_v="$(readme_versions README.zh-CN.md)"

echo "Version literals:"
printf -- '- %s: %s\n' "$claude_manifest" "$claude_v"
printf -- '- %s: %s\n' "$codex_manifest" "$codex_v"
printf -- '- %s: %s\n' "$codebuddy_manifest" "$codebuddy_v"
printf -- '- %s: %s\n' "$dsh_manifest" "$dsh_v"
printf -- '- CHANGELOG.md (first section): %s\n' "$changelog_v"
# One line per literal, so a second sample disagreeing with the first is visible
# in the output rather than averaged away.
for readme in README.md README.zh-CN.md; do
  if [ "$readme" = "README.md" ]; then values="$readme_v"; else values="$readme_zh_v"; fi
  if [ -z "$values" ]; then
    printf -- '- %s (plugin list sample): none\n' "$readme"
  else
    n=0
    while IFS= read -r value; do
      n=$((n + 1))
      if [ "$n" -eq 1 ]; then
        printf -- '- %s (plugin list sample): %s\n' "$readme" "$value"
      else
        printf -- '- %s (plugin list sample %d): %s\n' "$readme" "$n" "$value"
      fi
    done <<EOF
$values
EOF
  fi
done

# Every manifest states a release number; the suffix after `+` is a cachebuster
# and is checked separately. An unparseable literal would otherwise slip past the
# equality loop as long as it matched something else, so the shape is validated
# for all three rather than only the one that happens to have no suffix.
for pair in "$claude_manifest:$claude_v" "$codex_manifest:$codex_release" "$codebuddy_manifest:$codebuddy_release" "$dsh_manifest:$dsh_v"; do
  label="${pair%%:*}"; value="${pair#*:}"
  if ! printf '%s\n' "$value" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    echo "- $label version is not X.Y.Z: ${value:-nothing}"
    needs=1
  fi
done
for pair in "CHANGELOG.md:$changelog_v" "$codex_manifest:$codex_release" \
            "$codebuddy_manifest:$codebuddy_release" "$dsh_manifest:$dsh_v"; do
  label="${pair%%:*}"; value="${pair#*:}"
  if [ "$value" != "$claude_v" ]; then
    echo "- $label says ${value:-nothing}, $claude_manifest says $claude_v"
    needs=1
  fi
done
# Every README sample line, each named by position when it is not the first, so a
# stale second sample reads as the specific literal it is rather than as the file.
check_readme_values() {  # check_readme_values <file> <values>
  local readme="$1" values="$2" n=0 value
  if [ -z "$values" ]; then
    echo "- $readme has no 'Version:' plugin-list sample"
    needs=1
    return 0
  fi
  while IFS= read -r value; do
    n=$((n + 1))
    if [ "$value" != "$claude_v" ]; then
      # The first sample keeps the wording the smoke suite asserts on.
      if [ "$n" -eq 1 ]; then
        echo "- $readme says ${value:-nothing}, $claude_manifest says $claude_v"
      else
        echo "- $readme sample $n says ${value:-nothing}, $claude_manifest says $claude_v"
      fi
      needs=1
    fi
  done <<EOF
$values
EOF
}
check_readme_values README.md "$readme_v"
check_readme_values README.zh-CN.md "$readme_zh_v"

# The pin is checked against the tag it names, not against the version literals:
# the marketplace intentionally still points at the previous release while the
# next one is being prepared, so a version comparison would fail on the one run
# that matters. What must hold is `ref` and `sha` naming the same commit — the
# disagreement Claude Code refuses at install time as `sha_pin_mismatch`.
#
# Both catalogs carry the pin, and both are checked: the two files are separate
# copies of the same entry, so a pin corrected in one and missed in the other
# would install a different commit depending on which catalog a host reads. Each
# catalog's pin is read from its own `source` object so the comparison is
# between the two recorded pins, not between a pin and an unrelated field.
window_tag=""; window_sha=""
for catalog in "$marketplace" "$codebuddy_marketplace"; do
  pin_ref="$(jpin "$catalog" ref)"
  pin_sha="$(jpin "$catalog" sha)"
  if [ -z "$pin_ref" ]; then
    echo "Marketplace pin ($catalog): none recorded"
  elif ! pin_commit="$(git rev-parse --verify -q "$pin_ref^{commit}" 2>/dev/null)"; then
    echo "- $catalog ref $pin_ref is not present locally; fetch tags before releasing"
    needs=1
  elif [ -z "$pin_sha" ]; then
    echo "- $catalog ref $pin_ref resolves to $pin_commit, but no sha is recorded"
    needs=1
  elif [ "$pin_sha" != "$pin_commit" ]; then
    echo "- $catalog ref $pin_ref is $pin_commit, but sha says $pin_sha"
    needs=1
  else
    echo "Marketplace pin ($catalog): $pin_ref -> $pin_sha"
    [ -n "$window_sha" ] || { window_tag="$pin_ref"; window_sha="$pin_sha"; }
  fi
done

# The window between the tagged commit and the commit that recorded the pin.
# `RELEASE.md` makes a release two commits by construction — the tag cannot exist
# before the release commit, and the pin cannot be written before the tag — so
# exactly two files have any business changing in that range: the two marketplace
# catalogs, whose `ref`/`sha` are the pin itself. Anything else there is a change
# that shipped under the pin without being in the release commit the tag names.
#
# The range ends at the commit that last wrote a catalog, not at HEAD: later work
# on `main` is not part of the release and comparing against HEAD would report
# every commit since the release as a stray.
#
# `TaskFlowDocs/` is exempt: task documents are not distributed with the release,
# so one landing in the window cannot make a pin ship unpublished code. Every
# other path is named, because "one of the release commits had an extra file" is
# not something a status line should hide.
if [ -n "$window_sha" ]; then
  recorded="$(git log -1 --format=%H -- "$marketplace" "$codebuddy_marketplace" 2>/dev/null || true)"
  if [ -n "$recorded" ] && [ "$recorded" != "$window_sha" ]; then
    stray=""
    for path in $(git diff --name-only "$window_sha" "$recorded" 2>/dev/null || true); do
      case "$path" in
        "$marketplace"|"$codebuddy_marketplace"|TaskFlowDocs/*) ;;
        *) stray="$stray $path" ;;
      esac
    done
    if [ -n "$stray" ]; then
      echo "- the pin commit range carries changes outside the pin:$stray"
      echo "  ($window_tag is $window_sha; the catalogs were last written in $recorded)"
      needs=1
    fi
  fi
fi

if [ "$needs" -eq 1 ]; then
  echo "STATUS: needs-user-input"
  exit 2
else
  echo "STATUS: pass"
fi
