#!/usr/bin/env bash
# task — token-saving TaskFlow lifecycle edits.
# Usage: task intake|promote|state|next|remove|get|progress|approve|complete ...
# POSIX shell + awk only: the plugin must run with no language runtime available.
#
# Every parameter is passed to awk through the environment rather than -v: awk
# interprets escape sequences in -v values, so a goal containing a backslash would
# be silently rewritten.
set -euo pipefail
shopt -s nullglob
LC_ALL=C
export LC_ALL

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
bash_cmd="$(command -v bash)"
command -v cygpath >/dev/null 2>&1 && bash_cmd="$(cygpath -w "$bash_cmd")"

today="$(date +%Y-%m-%d)"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
tmp_pairs="$work/pairs"

fail() { echo "$*" >&2; exit 1; }

# --- shared text helpers ---------------------------------------------------
# Reads stdin, writes <path> through a temp file in the same directory so an
# interrupted run cannot truncate a task document.
write_file() {
  local path="$1" dir tmp
  dir="$(dirname "$path")"
  mkdir -p "$dir"
  tmp="$(mktemp "$dir/.taskflow.XXXXXX")"
  cat > "$tmp"
  mv "$tmp" "$path"
}

ends_with_newline() {
  [ -s "$1" ] || return 1
  [ "$(tail -c 1 "$1" | od -An -tx1 | tr -d ' \n')" = "0a" ]
}

# Is $root a task worktree rather than the base one? `git worktree add` makes the
# linked tree's git dir a pointer directory containing `commondir`, so that file
# is Git's own answer to the question — no branch-name parsing, no guessing which
# task a tree belongs to.
#
# Not a repository at all is not an answer: `--root` may point outside Git (the
# smoke fixtures do), and refusing there would break callers who never had the
# base-tree problem. That case reports "not applicable" and the caller allows it.
# Returns 0 = task worktree, 1 = not a repository, 2 = base working tree.
worktree_kind() {  # worktree_kind <root>
  local root="$1" git_dir
  git -C "$root" rev-parse --show-toplevel >/dev/null 2>&1 || return 1
  # `--absolute-git-dir`, not `--git-dir`: Git for Windows hands back a drive path
  # (`D:/repo/.git/worktrees/x`) that is absolute there but does not match the
  # POSIX `/*` case below, so the join turned it into `$root/D:/...` and every
  # worktree read as a base tree.
  git_dir="$(git -C "$root" rev-parse --absolute-git-dir 2>/dev/null)" || return 1
  [ -f "$git_dir/commondir" ] || return 2
  return 0
}

# The awk program is shared by every command; TASKFLOW_CMD selects the branch.
TASK_AWK="$(cat <<'AWK'
function ltrim(s) { sub(/^[[:space:]]+/, "", s); return s }
function rtrim(s) { sub(/[[:space:]]+$/, "", s); return s }
function trim(s) { return rtrim(ltrim(s)) }
function is_blank(s) { return s ~ /^[[:space:]]*$/ }
function at(s, p) { return index(s, p) == 1 }
function die(msg) { print msg > "/dev/stderr"; exit 1 }

# Longest prefix of s that is at most max bytes and ends on a whole character.
# Under LC_ALL=C every awk counts bytes, so a bare substr() cut can land inside a
# UTF-8 sequence and write an invalid byte into todo.md. Under a UTF-8-aware awk
# substr() already stops on a character boundary: no single byte then answers the
# table, every character measures 1, and the prefix comes back cut to characters
# instead -- also a boundary. Both worlds get valid UTF-8, and pure ASCII is
# byte-for-byte what the old substr() returned.
function cutbytes(s, max,   i, n, c, len) {
  i = 1
  n = length(s)
  while (i <= n) {
    c = ord[substr(s, i, 1)] + 0
    if (c < 128) len = 1
    else if (c < 224) len = 2
    else if (c < 240) len = 3
    else len = 4
    if (i - 1 + len > max) break
    i += len
  }
  return substr(s, 1, i - 1)
}
# A field line is "- Name:" with a letter-initial, space-separated name. Notes
# continuation bullets start with "- " too, so this is what tells the two apart
# when the end of a Notes block has to be found.
function isfield(s) { return s ~ /^- [A-Za-z][A-Za-z ]*:/ }

# Section scan: a section is a line starting exactly with "## ".
function scan(   i) {
  hc = 0
  for (i = 1; i <= n; i++) if (at(line[i], "## ")) { hc++; hd[hc] = i }
}
function bstart(j) { return hd[j] + 1 }
function bend(j) { return (j < hc) ? hd[j + 1] - 1 : n }
function rfield(a, b, name,   i, p) {
  p = "- " name ":"
  for (i = a; i <= b; i++) if (at(line[i], p)) return trim(substr(line[i], length(p) + 1))
  return ""
}
function rhas(a, b, name,   i, p) {
  p = "- " name ":"
  for (i = a; i <= b; i++) if (at(line[i], p)) return 1
  return 0
}
function rfind(a, b, needle,   i) {
  for (i = a; i <= b; i++) if (index(line[i], needle)) return 1
  return 0
}
function findsec(id, task,   j, a, b) {
  for (j = 1; j <= hc; j++) {
    a = bstart(j); b = bend(j)
    if (id != "" && rfield(a, b, "ID") == id) return j
    if (task != "" && rfind(a, b, "`TaskFlowDocs/" task "/`")) return j
  }
  return 0
}
# Replaces the first "^- <name>:" line in the range; returns 0 when absent.
function setr(a, b, name, value,   i, p) {
  p = "- " name ":"
  for (i = a; i <= b; i++) if (at(line[i], p)) { line[i] = "- " name ": " value; return 1 }
  return 0
}
function emit(   i) {
  for (i = 1; i <= n; i++) {
    if (i == n && !ends_nl) printf "%s", line[i]
    else printf "%s\n", line[i]
  }
}
# Inserts at position p, shifting the tail up. `emit` prints while it walks, so
# the element appended at p is printed in the same pass -- no second emit.
function insert(p, s,   i) {
  for (i = n; i >= p; i--) line[i + 1] = line[i]
  n++
  line[p] = s
}
# Last line of the Notes block starting at a. Continuation bullets are "- "
# lines that are not field lines; anything else closes the block.
function notes_end(a, b,   i, e) {
  e = a
  for (i = a + 1; i <= b; i++) {
    if (is_blank(line[i])) continue
    if (at(line[i], "- ") && !isfield(line[i])) { e = i; continue }
    break
  }
  return e
}
# a and b are the target body range; they are parameters, not extras, or awk
# would scope them as local copies and every setr would miss.
function loadpairs(f, a, b,   pl, k, name, value) {
  while ((getline pl < f) > 0) {
    if (pl == "") continue
    k = index(pl, "\t")
    if (k == 0) continue
    name = substr(pl, 1, k - 1)
    value = substr(pl, k + 1)
    if (!setr(a, b, name, value)) die("missing Todo field: " name)
  }
  close(f)
}
BEGIN {
  cmd = ENVIRON["TASKFLOW_CMD"]
  id = ENVIRON["TASKFLOW_ID"]
  task = ENVIRON["TASKFLOW_TASK"]
  keys = ENVIRON["TASKFLOW_KEYS"]
  pairs = ENVIRON["TASKFLOW_PAIRS"]
  value = ENVIRON["TASKFLOW_VALUE"]
  goal = ENVIRON["TASKFLOW_GOAL"]
  owner = ENVIRON["TASKFLOW_OWNER"]
  source = ENVIRON["TASKFLOW_SOURCE"]
  step = ENVIRON["TASKFLOW_STEP"]
  step_status = ENVIRON["TASKFLOW_STEP_STATUS"]
  verification = ENVIRON["TASKFLOW_VERIFICATION"]
  next_action = ENVIRON["TASKFLOW_NEXT_ACTION"]
  notes = ENVIRON["TASKFLOW_NOTES"]
  removed_reason = ENVIRON["TASKFLOW_REASON"]
  ends_nl = ENVIRON["TASKFLOW_ENDS_NL"] + 0
  today = ENVIRON["TASKFLOW_TODAY"]
  # Byte value of every single byte, for cutbytes. A character this table cannot
  # answer -- one UTF-8-aware awk hands back whole, or one from a sequence that
  # is not valid UTF-8 to begin with -- reads as 0 and is measured as one byte.
  for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i
  n = 0
  lc = "abcdefghijklmnopqrstuvwxyz"
  uc = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  min_token_len = ENVIRON["TASKFLOW_MIN_TOKEN"] + 0
  if (min_token_len < 1) min_token_len = 2
  min_shared = ENVIRON["TASKFLOW_MIN_SHARED"] + 0
  if (min_shared < 1) min_shared = 2
  overlap_pct = ENVIRON["TASKFLOW_OVERLAP_PCT"] + 0
  if (overlap_pct < 1) overlap_pct = 40
}

# Word-overlap heuristic backing the intake candidate report. Words are split on
# anything that is not a letter or digit and lowercased with the `lc`/`uc` string
# pair, because POSIX awk's tolower() is locale-dependent and the bash 3.2 + BSD
# floor this file is written to offers nothing better. Tokens shorter than
# `min_token_len` are dropped, which is what keeps two CJK sentences that share
# only function words from scoring above the threshold.
#
# The measure is Jaccard, set against a floor: the intersection must be at least
# `min_shared` tokes before the ratio counts at all. Jaccard alone is too eager
# between short entries -- half of "fix a typo in the README title" is "the
# README" on any entry that names README -- and too quiet between a long and a
# short one, which is why the floor rather than a containment term is what makes
# the report usable. Measured, not assumed: at 2 tokes and 40% the report fires
# on a genuine re-wording and stays silent on a library of unrelated entries.
function addtok(s,   w) {
  if (s == "") return
  w = lcsub(s)
  if (length(w) < min_token_len) return
  if (!(w in seenm)) { seenm[w] = 1; toks[++ntok] = w }
}
function lcsub(s,   i, c, o) {
  o = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    p = index(uc, c)
    o = o (p ? substr(lc, p, 1) : c)
  }
  return o
}
# Fills a set array keyed by token; callers intersect by lookup, so two sets never
# share an index space.
function tokset(s, set,   i, c, buf, w) {
  delete set; nt = 0
  buf = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c ~ /[A-Za-z0-9]/) { buf = buf c; continue }
    if (buf != "") { w = lcsub(buf); if (length(w) >= min_token_len) { set[w] = 1; nt++ } }
    buf = ""
  }
  if (buf != "") { w = lcsub(buf); if (length(w) >= min_token_len) { set[w] = 1; nt++ } }
  return nt
}
# Returns the Jaccard ratio, or 0 when the two goals share fewer than min_shared
# tokes. That floor is what makes it a candidate report rather than noise.
function overlap(   w) {
  intercount = 0
  for (w in goaltoks) if (w in candtoks) intercount++
  if (intercount < min_shared) return 0
  denom = ngoaltoks + ncandtoks - intercount
  if (denom <= 0) return 0
  return intercount / denom
}
{ n++; line[n] = $0 }
END {
  scan()

  if (cmd == "get") {
    j = findsec(id, task)
    if (j == 0) die(ENVIRON["TASKFLOW_NOTFOUND"])
    # removeprefix("## ").strip()
    printf "%s\n", trim(substr(line[hd[j]], 4))
    if (keys != "") {
      k = split(keys, kl, ",")
      for (i = 1; i <= k; i++) print rfield(bstart(j), bend(j), kl[i])
    }
    exit 0
  }

  if (cmd == "edit") {
    j = findsec(id, task)
    if (j == 0) die(ENVIRON["TASKFLOW_NOTFOUND"])
    a = bstart(j); b = bend(j)
    loadpairs(pairs, a, b)
    emit()
    exit 0
  }

  if (cmd == "intake") {
    for (j = 1; j <= hc; j++) {
      a = bstart(j); b = bend(j)
      if (rfield(a, b, "Goal") == goal) die("duplicate Todo goal")
      # Two different goals colliding in the digest is a 1-in-16-million event;
      # refusing loudly is better than writing an ID that `todo_part` cannot
      # resolve to one entry.
      if (rfield(a, b, "ID") == id) die("Todo ID already in use: " id)
    }
    # Candidates for the same work, reported but never acted on. The duplicate
    # check above is byte-exact, so a re-worded item used to appear beside the
    # one it duplicates with no signal at all. Reported on stderr, because the
    # caller's stdout contract is `intake OK: <id>` and `smoke-test` reads the
    # ID as stdout's last field.
    ncand = 0; candtrunc = 0
    ngoaltoks = tokset(goal, goaltoks)
    for (j = 1; j <= hc; j++) {
      a = bstart(j); b = bend(j)
      st = rfield(a, b, "Status")
      if (st == "" || st == "done" || st == "cancelled") continue
      jid = rfield(a, b, "ID")
      if (jid == "") continue
      jgoal = rfield(a, b, "Goal")
      if (jgoal == goal) continue
      ncandtoks = tokset(jgoal, candtoks)
      if (overlap() * 100 >= overlap_pct) {
        ncand++
        if (ncand <= 3) { candid[ncand] = jid; candtitle[ncand] = cutbytes(jgoal, 80) }
        else candtrunc = 1
      }
    }
    if (ncand > 0) {
      printf "note: %d existing live Todo %s may cover the same work -- review before planning:\n", \
        ncand, (ncand == 1 ? "entry" : "entries") > "/dev/stderr"
      for (j = 1; j <= (ncand < 3 ? ncand : 3); j++)
        printf "  %s  %s\n", candid[j], candtitle[j] > "/dev/stderr"
      if (candtrunc) printf "  ... and more\n" > "/dev/stderr"
    }
    # str.rstrip(".") first, then truncate: the two steps are not commutative.
    # Whitespace is stripped before *and* after the cut. Before, so a goal ending
    # in spaces does not push its period out of reach of the regex above. After,
    # because the cut itself can land inside a run of spaces mid-goal, and the
    # result is not a field but a `## ` heading -- a line other people diff, where
    # `git diff --check` reports the trailing space on every review.
    t = goal
    sub(/[[:space:]]+$/, "", t)
    sub(/\.+$/, "", t)
    title = rtrim(cutbytes(t, 80))

    # Insertion index: top of `## Items` (after its heading, blanks, and a
    # leading HTML comment), else just before `## Removed`, else EOF. The old
    # code always appended at EOF, so a file ending in `## Removed` put the new
    # live entry in the deleted region and outside the documented "add at the
    # top" convention in `todo.md`.
    ins = 0
    for (i = 1; i <= n; i++) {
      if (at(line[i], "## Items")) {
        ins = i + 1
        while (ins <= n && (is_blank(line[ins]) || line[ins] ~ /^[ \t]*<!--/)) ins++
        break
      }
    }
    if (ins == 0) {
      for (i = 1; i <= n; i++) {
        if (at(line[i], "## Removed")) { ins = i; break }
      }
    }

    lead = 0
    trail = 0
    if (ins <= 0 || ins > n) {
      # EOF path: same rstrip/rtrim as before, one blank line between the last
      # retained line and `##` (two leading blanks when the file was empty, so
      # the bytes still match `\n\n##`).
      while (n > 0 && is_blank(line[n])) n--
      if (n > 0) {
        line[n] = rtrim(line[n])
        lead = 1
      } else {
        lead = 2
      }
      ins = n + 1
      ends_nl = 1
    } else if (!is_blank(line[ins])) {
      trail = 1
    }

    nb = 0
    nb++; blk[nb] = "## " title
    nb++; blk[nb] = ""
    nb++; blk[nb] = "- ID: " id
    nb++; blk[nb] = "- Status: inbox"
    nb++; blk[nb] = "- Priority: normal"
    nb++; blk[nb] = "- Owner: " owner
    nb++; blk[nb] = "- Source: " source
    nb++; blk[nb] = "- Added: " today
    nb++; blk[nb] = "- Updated: " today
    nb++; blk[nb] = "- Goal: " goal
    nb++; blk[nb] = "- Task: Not promoted."
    nb++; blk[nb] = "- Next action: Clarify and promote when ready."

    total = lead + nb + trail
    for (i = n; i >= ins; i--) line[i + total] = line[i]
    for (i = 1; i <= lead; i++) line[ins + i - 1] = ""
    for (i = 1; i <= nb; i++) line[ins + lead + i - 1] = blk[i]
    if (trail) line[ins + lead + nb] = ""
    n += total
    emit()
    exit 0
  }

  if (cmd == "step") {
    a = 0; b = 0
    for (i = 1; i <= n; i++) {
      if (at(line[i], "### Step ")) {
        rest = substr(line[i], 10)
        if (match(rest, /^[0-9]+/)) {
          num = substr(rest, 1, RLENGTH)
          following = substr(rest, RLENGTH + 1, 1)
          if (num == step && following !~ /[A-Za-z0-9_]/) { a = i; break }
        }
      }
    }
    if (a == 0) die("Step " step " not found")
    for (i = a + 1; i <= n; i++) {
      if (at(line[i], "### Step ") || at(line[i], "## ")) break
    }
    b = i - 1
    if (step_status == "done") {
      for (i = a; i <= b; i++) {
        if (line[i] ~ /^[[:space:]]*- \[ \]/) die("Step " step " has unchecked items")
      }
    }
    if (!setr(a, b, "Status", step_status)) die("Step " step " missing Status")
    if (verification != "") {
      vline = "- " today " Step " step ": " verification
      found = 0
      for (i = 1; i <= n; i++) {
        if (line[i] == "## Verification / Review") {
          # Equivalent to replacing "## Verification / Review\n" with
          # "## Verification / Review\n\n<line>\n": a blank line and the entry are
          # inserted directly after the heading, and whatever followed stays.
          for (k = n; k > i; k--) line[k + 2] = line[k]
          line[i + 1] = ""
          line[i + 2] = vline
          n += 2
          found = 1
          break
        }
      }
      # Reporting success while the line went nowhere is the worse failure, and it
      # is invisible: a translated or mistyped heading lost the verification with no
      # signal. Nothing has been printed yet -- `emit` is the only writer and this
      # exits before reaching it -- so dying here leaves the Plan byte-identical.
      if (!found) die("missing ## Verification / Review section; verification not recorded")
    }
    emit()
    exit 0
  }

  if (cmd == "next") {
    j = findsec(id, "")
    if (j == 0) die(ENVIRON["TASKFLOW_NOTFOUND"])
    a = bstart(j); b = bend(j)
    # Last non-blank line of the section: where a field that is absent gets
    # appended. `archive` takes the same lenient line over Todo shape.
    last = a - 1
    for (i = a; i <= b; i++) if (!is_blank(line[i])) last = i

    if (!setr(a, b, "Next action", next_action)) {
      p = 0
      for (i = a; i <= b; i++) if (at(line[i], "- Status:")) { p = i; break }
      if (p == 0) p = last
      insert(p + 1, "- Next action: " next_action); b++; last++
    }

    if (notes != "") {
      p = 0
      for (i = a; i <= b; i++) if (at(line[i], "- Notes:")) { p = i; break }
      if (p == 0) {
        insert(last + 1, "- Notes: " notes); b++; last++
      } else {
        # At the end of the block, NOT at the end of the entry: `- Updated:` and
        # any field after it would otherwise end up above the new line.
        insert(notes_end(p, b) + 1, "- " notes); b++; last++
      }
    }

    if (!setr(a, b, "Updated", today)) {
      insert(last + 1, "- Updated: " today); b++; last++
    }

    emit()
    exit 0
  }

  # `todo-check` refuses a Todo entry that disappears, which is what catches a
  # merge resolving a conflict by taking one side wholesale. An authorized
  # deletion is the one legitimate way for an entry to vanish, so it records the
  # ID and the reason first, in a section that check reads.
  if (cmd == "remove") {
    j = findsec(id, "")
    if (j == 0) die(ENVIRON["TASKFLOW_NOTFOUND"])
    a = bstart(j); b = bend(j)
    # Deleting the entry of a promoted task would orphan its directory, so that
    # has to go through the archive path instead.
    ta = rfield(a, b, "Task")
    if (ta != "Not promoted.") {
      die("Todo entry is not unpromoted (Task: " (ta == "" ? "missing" : ta) "); handle its task first")
    }
    tomb = "- ID: " id " (removed " today ": " removed_reason ")"
    # Delete the heading and body. Blank lines elsewhere are left alone, and the
    # one that separated the entry from the next one stays with that entry.
    cnt = 0
    for (i = 1; i <= n; i++) {
      if (i >= hd[j] && i <= b) continue
      cnt++; line[cnt] = line[i]
    }
    n = cnt
    scan()
    # Where the records section belongs: directly above the first entry. The
    # preamble headings (`## Items`, a status-flow section) hold no `- ID:`
    # field, so they are not entries and the record goes below them.
    first = 0
    removed = 0
    for (i = 1; i <= n; i++) {
      if (!at(line[i], "## ")) continue
      if (at(line[i], "## Removed")) { removed = 1; continue }
      if (first != 0) continue
      e = (i + 1 <= n) ? i + 1 : n
      while (e < n && !at(line[e], "## ")) {
        if (rfield(e, e, "ID") != "") { first = i; break }
        e++
      }
      if (first == 0 && e == n && rfield(e, e, "ID") != "") first = i
    }
    if (!removed) {
      # Above the first entry when there is one; otherwise the section has no
      # anchor left and goes at the end, which is what removing the only entry
      # leaves behind.
      if (first == 0) first = n + 1
      pad = 0
      if (first > n && n > 0 && !is_blank(line[n])) pad = 1
      insert(first, "## Removed")
      insert(first + 1, "")
      insert(first + 2, tomb)
      insert(first + 3, "")
      if (pad) insert(first, "")
    } else {
      pos = 0
      for (i = 1; i <= n; i++) if (at(line[i], "## Removed")) pos = i
      last = pos
      for (i = pos + 1; i <= n; i++) {
        if (at(line[i], "## ")) break
        if (!is_blank(line[i])) last = i
      }
      insert(last + 1, tomb)
    }
    emit()
    exit 0
  }

  # Not named "get": that command already means "title line + the fields named in
  # TASKFLOW_KEYS", and three internal callers depend on that shape. This branch
  # prints the entry body verbatim instead -- the CLI wrapper below is what
  # carries the name `get`. Every non-blank line, not only column-0 `- ` fields:
  # Notes continuations are often indented (with or without a dash) and a prefix
  # filter dropped them with no warning, so a caller saw a truncated entry.
  if (cmd == "entry") {
    j = findsec(id, "")
    if (j == 0) die(ENVIRON["TASKFLOW_NOTFOUND"])
    a = bstart(j); b = bend(j)
    for (i = a; i <= b; i++) if (!is_blank(line[i])) print line[i]
    exit 0
  }

  if (cmd == "docstatus") {
    for (i = 1; i <= n; i++) {
      if (at(line[i], "> Status: ")) { line[i] = "> Status: " value; emit(); exit 0 }
    }
    die("missing document Status")
  }

  die("unknown TASKFLOW_CMD: " cmd)
}
AWK
)"

# Reads <input> and replaces <target> only when awk succeeds, so a rejected
# command leaves the target untouched. Redirecting rather than piping is what
# makes that atomic: a pipeline's later stage still runs when awk exits early.
run_awk_to() {  # run_awk_to <target> <input|-> [key=value ...]
  local target="$1" input="$2" dir tmp ends=0
  shift 2
  # The source's trailing-newline state is carried through the environment: awk
  # cannot observe it through stdin, and dropping it would add a newline to files
  # that never had one.
  if [ "$input" != "-" ] && ends_with_newline "$input"; then ends=1; fi
  dir="$(dirname "$target")"
  mkdir -p "$dir"
  tmp="$(mktemp "$dir/.taskflow.XXXXXX")"
  if ! env TASKFLOW_TODAY="$today" TASKFLOW_ENDS_NL="$ends" "$@" awk "$TASK_AWK" "$input" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv "$tmp" "$target"
}

# Read-only query: prints awk's stdout and never writes a file.
run_task_awk() {  # run_task_awk <file> [key=value ...]
  local file="${1:-/dev/null}"
  shift
  env TASKFLOW_TODAY="$today" TASKFLOW_ENDS_NL=0 "$@" awk "$TASK_AWK" "$file"
}

# --- argument handling -----------------------------------------------------
[ "$#" -ge 1 ] || fail "usage: task intake|promote|state|next|remove|get|progress|approve|unaided|complete ..."
command="$1"; shift

# The phase-table concept classes. This is the only place a concept class is
# validated: the pre-write gate names a *suggested* class in its block message,
# and `approve` reconciles a recorded stage against evidence instead of
# re-reading the prose. Product-neutral by construction — the list names
# concepts, never a tool.
concept_class_re='requirements elicitation|literature and evidence|architecture and design|work breakdown|incremental implementation|testing strategy|documentation and decision'

# Mirrors the existing contract: --root, when present, is the final two arguments.
split_root() {
  root=""
  rest=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --root)
        [ "$#" -eq 2 ] || fail "--root must be the final option: --root <path>"
        root="$2"
        shift 2
        ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  if [ -n "$root" ]; then
    if [ -d "$root" ]; then root="$(cd "$root" && pwd -P)"; else fail "root not found: $root"; fi
  else
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
  fi
}

task_paths() {  # task_paths <root> <task>
  docs="$1/TaskFlowDocs"
  base="$docs/$2"
  prd="$base/prd.md"
  plan="$base/plan.md"
  [ -d "$base" ] || fail "active task not found: $2"
}

# The approval gate every command that acts on approved work shares. `state
# in_progress` proved it was needed; `progress` and `complete` were reachable
# without it, so unimplemented-and-unapproved work could be marked done and
# even archived.
require_approval() {  # require_approval <task-id>
  local text version approval
  text="$(cat "$plan")"
  version="$(printf '%s\n' "$text" | sed -n 's/^> Task version: \(v[0-9][0-9]*\)$/\1/p' | head -1)"
  [ -n "$version" ] || fail "missing Plan Task version"
  approval="$(printf '%s\n' "$text" | sed -n '/^## Approval$/,/^## /p')"
  printf '%s\n' "$approval" | grep -qx -- "- Status: approved" || fail "current Task version is not approved"
  printf '%s\n' "$approval" | grep -qx -- "- Approved version: $version" || fail "current Task version is not approved"
  # A version match alone still admits the template: it ships `pending` in every
  # Approval field, so an approval copied from a previous version validates as
  # long as its version is bumped. A real approval always carries an approver.
  printf '%s\n' "$approval" | grep -q '^- Approved by: pending$' && fail "current Task version is not approved"
  return 0
}

# --- commands --------------------------------------------------------------
case "$command" in
  intake)
    split_root "$@"
    [ "${#rest[@]}" -ge 1 ] && [ "${#rest[@]}" -le 2 ] || fail 'usage: task intake <goal> [source] [--root <path>]'
    goal="${rest[0]}"
    if [ "${#rest[@]}" -eq 2 ]; then source="${rest[1]}"; else source="direct user request"; fi
    [ -n "$goal" ] || fail "goal must not be empty"
    # Who wrote the entry is the host that ran the command, and only the host can
    # answer that. The detection is the one `hooks/session-record` already uses, so
    # the Todo entry and the sessions index name the same agent. An unrecognized
    # host gets `Unknown` rather than a guess: the previous literal said `Codex` in
    # every host, which recorded an owner that was simply not true.
    owner=""
    case "${AI_AGENT:-}" in *claude*) owner=Claude ;; esac
    if [ -z "$owner" ] && { [ -n "${CLAUDECODE:-}" ] || [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; }; then
      owner=Claude
    fi
    if [ -z "$owner" ]; then
      case "${AI_AGENT:-}" in *codex*) owner=Codex ;; esac
      if [ -z "$owner" ] && { [ -n "${CODEX_HOME:-}" ] || [ -n "${CODEX_SANDBOX:-}" ]; }; then
        owner=Codex
      fi
    fi
    owner="${owner:-Unknown}"
    mkdir -p "$root/TaskFlowDocs"
    todo="$root/TaskFlowDocs/todo.md"
    [ -f "$todo" ] || printf '# Todo\n' | write_file "$todo"
    # The ID is derived from the goal, not from the highest existing ID: two
    # branches cut from the same base would otherwise both compute "-01" on the
    # first intake of the day and collide on merge. A digest of the goal makes
    # the two branches agree, so the merge driver sees one entry, not two.
    # `cksum` rather than `sha256sum`: it is in POSIX, so it is present on macOS,
    # Windows' Git Bash, and Linux alike.
    digest="$(printf '%s' "$goal" | cksum | awk '{ printf "%06x", $1 % 16777216 }')"
    todo_id="TF-$(printf '%s' "$today" | tr -d '-')-$digest"
    run_awk_to "$todo" "$todo" TASKFLOW_CMD=intake TASKFLOW_GOAL="$goal" TASKFLOW_SOURCE="$source" \
      TASKFLOW_ID="$todo_id" TASKFLOW_OWNER="$owner"
    echo "intake OK: $todo_id"
    # Nothing here is refused: triage is meant to be cheap, and an inbox item may
    # never be planned. But `todo.md` is shared, and leaving it modified in the
    # base checkout is what makes the next `git checkout` refuse to move — the
    # very failure this signal exists for. So it is said, not prevented.
    kind=0
    worktree_kind "$root" || kind=$?
    if [ "$kind" -eq 2 ]; then
      echo "note: TaskFlowDocs/todo.md is now modified in the base working tree."
      echo "      Commit or stash it before switching branches, or work from a task worktree."
    fi
    ;;

  promote)
    split_root "$@"
    [ "${#rest[@]}" -eq 3 ] || fail 'usage: task promote <todo-id> <task-id> <small|large> [--root <path>]'
    todo_id="${rest[0]}"; task="${rest[1]}"; size="${rest[2]}"
    case "$size" in small|large) ;; *) fail 'usage: task promote <todo-id> <task-id> <small|large> [--root <path>]' ;; esac
    # Phase 1 writes the task's first documents, so this is where a task that was
    # never isolated would land them in the base tree, on whatever branch happens
    # to be checked out. Refuse before anything is written and hand over the
    # command instead. `<type>` is the one thing the script cannot know — the
    # repository's branch prefixes are prose in CONTRIBUTING.md, and guessing a
    # prefix from a task name would be a heuristic — so it stays a placeholder
    # and the reader picks it.
    kind=0
    worktree_kind "$root" || kind=$?
    if [ "$kind" -eq 2 ]; then
      base_branch="$(git -C "$root" branch --show-current 2>/dev/null || true)"
      [ -n "$base_branch" ] || base_branch="<base>"
      printf '%s\n' \
        "Blocked: this is the base working tree, not a task worktree." \
        "A task's first documents are written in Phase 1, so they would land here on" \
        "whatever branch is checked out. Create the task worktree and rerun promote" \
        "from inside it:" \
        "" \
        "  git worktree add .worktrees/$task -b <type>/$task $base_branch" \
        "  cd .worktrees/$task" \
        "" \
        "<base> is filled in above; <type> is one of feature | fix | docs | chore," \
        "chosen from what the task changes." \
        "STATUS: blocked"
      exit 3
    fi
    # Not task_paths: that helper exits when the task is missing, and this command
    # requires it to be absent. `A && B` also aborts under `set -e` when A fails,
    # so the guard is written as an explicit test.
    if [ -e "$root/TaskFlowDocs/$task" ]; then fail "task already exists: $task"; fi
    docs="$root/TaskFlowDocs"
    base="$docs/$task"
    prd="$base/prd.md"
    plan="$base/plan.md"
    todo="$docs/todo.md"
    [ -f "$todo" ] || fail "todo.md missing; promotion not started"

    # Task is "Not promoted." on a promotable entry; anything else is a repeat.
    state_of="$(run_task_awk "$todo" TASKFLOW_CMD=get TASKFLOW_ID="$todo_id" \
      TASKFLOW_KEYS="Task" TASKFLOW_NOTFOUND="Todo entry not found: $todo_id")"
    task_field="$(printf '%s\n' "$state_of" | sed -n '2p')"
    [ "$task_field" = "Not promoted." ] || fail "Todo already promoted"
    title="$(printf '%s\n' "$state_of" | sed -n '1p')"
    goal="$(run_task_awk "$todo" TASKFLOW_CMD=get TASKFLOW_ID="$todo_id" TASKFLOW_KEYS="Goal" \
      TASKFLOW_NOTFOUND="Todo entry not found: $todo_id" | sed -n '2p')"

    mkdir -p "$base"
    {
      printf '%s\n' "# $title"
      printf '%s\n' '> Task version: v1' '> Status: planning' ''
      printf '%s\n' '## Goal' ''
      printf '%s\n' "$goal" ''
      printf '%s' '## Background / Confirmed Facts

## Requirements

## Acceptance Criteria

## In Scope

## Out of Scope

## Risks / Deferred Items

## Open Questions

## Version History

- v1 — planning.
'
    } | write_file "$prd"

    {
      printf '%s\n' "# Plan — $title"
      printf '%s\n' '> Task version: v1' '> Status: planning' ''
      if [ "$size" = "large" ]; then
        printf '%s' '## Spec Pointers

- `spec.md`

'
      else
        printf '%s' 'No spec required — small, self-contained task.

'
      fi
      printf '%s' '## Reference Pointers

## Related Tasks

## Skills / Tools Used

## Preconditions

## Approval

- Status: requested
- Approved by: pending
- Approved at: pending
- Approved version: pending
- Approved scope: pending

## Steps

### Step 1 — Implement and verify

- Goal:
- Dependencies:
- Files:
- Implementation checklist:
  - [ ] Implement the approved change.
  - [ ] Run focused verification.
- Acceptance:
- Verification:
- Rollback:
- Status: pending

## Checkpoints

## Verification / Review

## Change Log

## Follow-ups

## Version History

- v1 — planning.
'
    } | write_file "$plan"

    if [ "$size" = "large" ]; then
      {
        printf '%s\n' "# Spec — $title" '> Task version: v1' ''
        printf '%s' '## Objective and Success Criteria

## Architecture Boundaries and Responsibilities

## Project Structure / Affected Files

## Interfaces, Data Flow, and Contracts

## Invariants and Compatibility

## Validation and Error Semantics

## Code and Test Constraints

## Design Decisions and Alternatives

## Open Questions
'
      } | write_file "$base/spec.md"
    fi

    {
      printf 'Status\tpromoted\n'
      printf 'Updated\t%s\n' "$today"
      printf 'Task\t`TaskFlowDocs/%s/`\n' "$task"
      printf 'Next action\tComplete PRD / Spec / Plan and request approval.\n'
    } > "$tmp_pairs"
    run_awk_to "$todo" "$todo" TASKFLOW_CMD=edit TASKFLOW_ID="$todo_id" TASKFLOW_PAIRS="$tmp_pairs" \
      TASKFLOW_NOTFOUND="Todo entry not found: $todo_id"
    echo "promote OK: $todo_id -> $task ($size)"
    ;;

  state)
    split_root "$@"
    [ "${#rest[@]}" -eq 2 ] || fail 'usage: task state <task-id> <planning|ready|in_progress|checking|blocked> [--root <path>]'
    task="${rest[0]}"; new_state="${rest[1]}"
    case "$new_state" in
      planning|ready|in_progress|checking|blocked) ;;
      *) fail 'usage: task state <task-id> <planning|ready|in_progress|checking|blocked> [--root <path>]' ;;
    esac
    task_paths "$root" "$task"
    if [ "$new_state" = "in_progress" ]; then
      require_approval "$task"
    fi
    todo="$root/TaskFlowDocs/todo.md"
    [ -f "$todo" ] || fail "todo.md missing; state change not started"
    case "$new_state" in
      planning|ready) todo_status=promoted ;;
      *) todo_status=in_progress ;;
    esac
    {
      printf 'Status\t%s\n' "$todo_status"
      printf 'Updated\t%s\n' "$today"
    } > "$tmp_pairs"
    run_awk_to "$todo" "$todo" TASKFLOW_CMD=edit TASKFLOW_TASK="$task" TASKFLOW_PAIRS="$tmp_pairs" \
      TASKFLOW_NOTFOUND="Todo entry not found: $task"
    run_awk_to "$plan" "$plan" TASKFLOW_CMD=docstatus TASKFLOW_VALUE="$new_state"
    run_awk_to "$prd" "$prd" TASKFLOW_CMD=docstatus TASKFLOW_VALUE="$new_state"
    echo "state OK: $task -> $new_state"
    ;;

  # Deliberately unguarded by require_approval: Todo is triage metadata, not an
  # approved artifact. `intake` and `promote` write it the same way. The gate
  # exists to protect implementation against work that is not approved yet.
  next)
    split_root "$@"
    [ "${#rest[@]}" -ge 2 ] && [ "${#rest[@]}" -le 3 ] || fail 'usage: task next <todo-id> <next-action> [notes] [--root <path>]'
    todo_id="${rest[0]}"; next_action="${rest[1]}"
    # Positional optional, like `progress`'s verification: no flag to remember.
    if [ "${#rest[@]}" -eq 3 ]; then notes="${rest[2]}"; else notes=""; fi
    [ -n "$todo_id" ] || fail "todo-id must not be empty"
    [ -n "$next_action" ] || fail "next-action must not be empty"
    todo="$root/TaskFlowDocs/todo.md"
    [ -f "$todo" ] || fail "todo.md missing; next action not written"
    run_awk_to "$todo" "$todo" TASKFLOW_CMD=next TASKFLOW_ID="$todo_id" \
      TASKFLOW_NEXT_ACTION="$next_action" TASKFLOW_NOTES="$notes" \
      TASKFLOW_NOTFOUND="Todo entry not found: $todo_id"
    echo "next OK: $todo_id"
    ;;

  # Reading one entry is the other half of the token saving: the caller gets the
  # fields it needs instead of the whole Todo file. Prints verbatim `- ` lines,
  # so a caller keeps using `awk '{print $NF}'` on them. Read-only, and no
  # approval gate -- same reasoning as `next`.
  get)
    split_root "$@"
    [ "${#rest[@]}" -eq 1 ] || fail 'usage: task get <todo-id> [--root <path>]'
    todo_id="${rest[0]}"
    [ -n "$todo_id" ] || fail "todo-id must not be empty"
    todo="$root/TaskFlowDocs/todo.md"
    [ -f "$todo" ] || fail "todo.md missing; nothing to read"
    run_task_awk "$todo" TASKFLOW_CMD=entry TASKFLOW_ID="$todo_id" \
      TASKFLOW_NOTFOUND="Todo entry not found: $todo_id"
    ;;

  # An authorized deletion is the one legitimate way for a Todo entry to vanish,
  # and `todo-check` cannot tell it from a dropped entry — that is the point of
  # the check. So the deletion records itself first, and the check reads it.
  remove)
    split_root "$@"
    [ "${#rest[@]}" -eq 2 ] || fail 'usage: task remove <todo-id> <reason> [--root <path>]'
    todo_id="${rest[0]}"; reason="${rest[1]}"
    [ -n "$todo_id" ] || fail "todo-id must not be empty"
    [ -n "$reason" ] || fail "reason must not be empty"
    todo="$root/TaskFlowDocs/todo.md"
    [ -f "$todo" ] || fail "todo.md missing; nothing to remove"
    run_awk_to "$todo" "$todo" TASKFLOW_CMD=remove TASKFLOW_ID="$todo_id" \
      TASKFLOW_REASON="$reason" TASKFLOW_NOTFOUND="Todo entry not found: $todo_id"
    echo "remove OK: $todo_id (recorded in ## Removed)"
    ;;

  progress)
    split_root "$@"
    [ "${#rest[@]}" -ge 3 ] && [ "${#rest[@]}" -le 4 ] || fail 'usage: task progress <task-id> <step-number> <pending|in_progress|done|blocked> [verification] [--root <path>]'
    task="${rest[0]}"; number="${rest[1]}"; step_status="${rest[2]}"
    case "$step_status" in
      pending|in_progress|done|blocked) ;;
      *) fail 'usage: task progress <task-id> <step-number> <pending|in_progress|done|blocked> [verification] [--root <path>]' ;;
    esac
    if [ "${#rest[@]}" -eq 4 ]; then verification="${rest[3]}"; else verification=""; fi
    task_paths "$root" "$task"
    require_approval "$task"
    run_awk_to "$plan" "$plan" TASKFLOW_CMD=step TASKFLOW_STEP="$number" \
      TASKFLOW_STEP_STATUS="$step_status" TASKFLOW_VERIFICATION="$verification"
    echo "progress OK: $task Step $number -> $step_status"
    ;;

  # Transcribes an approval the user has already given. Does not invent
  # consent, is not gated by require_approval (writing approval is not
  # "already approved"), and leaves > Status: / Todo / Git alone.
  unaided)
    split_root "$@"
    # Exit 2 rather than `fail`, on purpose: CODE_STYLE reserves 2 for
    # needs-user-input, and an unusable invocation here is exactly that — the
    # caller must supply the missing input. `fail` is the house helper for
    # argument errors and exits 1, so do not tidy this branch back onto it.
    unaided_usage='usage: task unaided <PRD|Spec|Plan> --considered "<concept class>" [--root <path>]'
    [ "${#rest[@]}" -eq 3 ] || { echo "$unaided_usage" >&2; exit 2; }
    stage="${rest[0]}"
    considered="${rest[2]}"
    [ "${rest[1]}" = "--considered" ] || { echo "$unaided_usage" >&2; exit 2; }
    case "$stage" in
      PRD|Spec|Plan) ;;
      *) echo "stage must be PRD, Spec, or Plan: $stage" >&2; exit 2 ;;
    esac
    [ -n "$considered" ] || { echo "--considered must not be empty" >&2; exit 2; }
    printf '%s' "$considered" | grep -qiE "$concept_class_re" || {
      printf 'concept class must name a phase-table class: %s\n' "$(printf '%s' "$concept_class_re" | sed 's/|/, /g')" >&2
      exit 2
    }
    # The gate reads the record back from the *task directory's* git dir, so
    # refuse here rather than writing a record that nothing will ever read. A
    # caller in the base checkout, or in a tree with no active task, would
    # otherwise be told the stage was recorded while the gate kept refusing.
    active=""
    for dir in "$root/TaskFlowDocs"/*/; do
      [ -d "$dir" ] || continue
      name="${dir%/}"
      name="${name##*/}"
      case "$name" in achieved|repository-docs) continue ;; esac
      if [ -f "$dir/plan.md" ]; then active="$name"; break; fi
    done
    [ -n "$active" ] || fail "no active task under $root/TaskFlowDocs; run unaided from the task worktree"
    git_dir="$(git -C "$root" rev-parse --absolute-git-dir 2>/dev/null)" \
      || fail "cannot locate the git directory for $root"
    mkdir -p "$git_dir/taskflow" || fail "cannot create the capability store under $git_dir"
    considered="$(printf '%s' "$considered" | tr -d '|\r\n')"
    printf 'unaided|%s\n' "$considered" >> "$git_dir/taskflow/evidence"
    printf 'unaided OK: %s in %s -> %s\n' "$stage" "$active" "$considered"
    ;;

  approve)
    split_root "$@"
    [ "${#rest[@]}" -ge 1 ] && [ "${#rest[@]}" -le 2 ] || fail 'usage: task approve <task-id> [approver] [--root <path>]'
    task="${rest[0]}"
    if [ "${#rest[@]}" -eq 2 ]; then approver="${rest[1]}"; else approver="user"; fi
    [ -n "$approver" ] || fail "approver must not be empty"
    task_paths "$root" "$task"
    [ -f "$plan" ] || fail "missing plan.md; approval not written"
    grep -q '^## Approval$' "$plan" || fail "missing Approval section; approval not written"
    # Stage gate: reconcile each required stage against the record the pre-write
    # gate wrote, instead of trusting the Plan's prose. Shape alone could not
    # tell an invoked phase from an uninvoked one — `Unaided — …` is
    # indistinguishable from a real call in text, and could be written after the
    # fact. The release record exists only because a capability really ran, or
    # because a deliberate unaided decision was recorded.
    #
    # The concept vocabulary is deliberately NOT re-checked here: `task unaided`
    # is its single entry point, so re-reading the same text at approve would
    # only re-validate something the record already guarantees.
    #
    # Required stages: always [PRD] and [Plan]; [Spec] when spec.md exists
    # (promote large writes it). Untagged bullets do not satisfy a stage.
    # Fail closed before any Approval field is written.
    cap_size=small
    [ -f "$base/spec.md" ] && cap_size=large
    cap_skills="$(awk '
      /^## Skills \/ Tools Used$/ { p = 1; next }
      p && /^## / { exit }
      p { print }
    ' "$plan")"
    if [ -z "$(printf '%s' "$cap_skills" | tr -d '[:space:]')" ]; then
      fail "approve blocked: Skills / Tools Used is missing or empty"
    fi
    approved_version="$(sed -n 's/^> Task version: \(v[0-9][0-9]*\)$/\1/p' "$plan" | head -1)"
    [ -n "$approved_version" ] || fail "missing Plan Task version; approval not written"
    cap_released="$(git -C "$root" rev-parse --absolute-git-dir 2>/dev/null)/taskflow/released"
    cap_invoked=0
    cap_unaided=0
    require_stage() {
      local stage="$1" stage_lines line record kind capability
      stage_lines="$(printf '%s\n' "$cap_skills" | grep -E "^- \\[${stage}\\] " || true)"
      if [ -z "$(printf '%s' "$stage_lines" | tr -d '[:space:]')" ]; then
        fail "approve blocked: missing stage [$stage]"
      fi
      record=""
      if [ -f "$cap_released" ]; then
        record="$(awk -F'|' -v v="$approved_version" -v s="$stage" \
          '$1 == v && $2 == s { keep = $0 } END { if (keep != "") print keep }' "$cap_released")"
      fi
      if [ -z "$record" ]; then
        fail "approve blocked: stage [$stage] was never released by the pre-write gate. Re-run that phase with a capability invoked, or declare it: bash hooks/task unaided $stage --considered '<concept class>'"
      fi
      kind="$(printf '%s' "$record" | cut -d'|' -f4)"
      capability="$(printf '%s' "$record" | cut -d'|' -f5)"
      line="$(printf '%s\n' "$stage_lines" | head -1)"
      case "$line" in
        *Unaided*)
          [ "$kind" = "unaided" ] \
            || fail "approve blocked: stage [$stage] is reported Unaided but was recorded as an invocation ($capability)"
          printf '%s\n' "$line" | grep -q 'considered:' \
            || fail "approve blocked: stage [$stage] Unaided needs considered:"
          printf '%s\n' "$line" | grep -qF -- "$capability" \
            || fail "approve blocked: stage [$stage] reports a different considered class than the recorded one ($capability)"
          cap_unaided=$((cap_unaided + 1))
          ;;
        *)
          [ "$kind" = "invoke" ] \
            || fail "approve blocked: stage [$stage] is reported as an invocation but was recorded as an unaided decision"
          printf '%s\n' "$line" | grep -qF -- "$capability" \
            || fail "approve blocked: stage [$stage] does not name the recorded capability ($capability)"
          cap_invoked=$((cap_invoked + 1))
          ;;
      esac
    }
    require_stage PRD
    require_stage Plan
    if [ "$cap_size" = large ]; then
      require_stage Spec
    fi
    printf 'stages released by the gate: %s invoked, %s unaided\n' "$cap_invoked" "$cap_unaided"
    approved_at="$(date '+%Y-%m-%d %H:%M %z')"
    approved_scope=""
    [ -f "$prd" ] && approved_scope="PRD"
    if [ -f "$base/spec.md" ]; then
      if [ -n "$approved_scope" ]; then approved_scope="$approved_scope / Spec"; else approved_scope="Spec"; fi
    fi
    if [ -n "$approved_scope" ]; then approved_scope="$approved_scope / Plan"; else approved_scope="Plan"; fi
    # Same five-line shape as promote / version reset; missing lines are
    # inserted, non-field lines in the section are left alone. Values come
    # from the environment (not awk -v) so backslashes are not rewritten.
    if ! TASKFLOW_APPROVER="$approver" TASKFLOW_APPROVED_AT="$approved_at" \
      TASKFLOW_APPROVED_VERSION="$approved_version" TASKFLOW_APPROVED_SCOPE="$approved_scope" \
      awk '
        BEGIN {
          t[1] = "- Status: approved"
          t[2] = "- Approved by: " ENVIRON["TASKFLOW_APPROVER"]
          t[3] = "- Approved at: " ENVIRON["TASKFLOW_APPROVED_AT"]
          t[4] = "- Approved version: " ENVIRON["TASKFLOW_APPROVED_VERSION"]
          t[5] = "- Approved scope: " ENVIRON["TASKFLOW_APPROVED_SCOPE"]
        }
        function flush_five(   i) {
          for (i = 1; i <= 5; i++) print t[i]
          emitted = 1
        }
        /^## Approval$/ { approval = 1; emitted = 0; print; next }
        approval && /^## / {
          if (!emitted) flush_five()
          approval = 0
          print
          next
        }
        approval && /^- Status:/ ||
        approval && /^- Approved by:/ ||
        approval && /^- Approved at:/ ||
        approval && /^- Approved version:/ ||
        approval && /^- Approved scope:/ {
          if (!emitted) flush_five()
          next
        }
        { print }
        END { if (approval && !emitted) flush_five() }
      ' "$plan" > "$plan.tmp"; then
      rm -f "$plan.tmp"
      fail "approval not written"
    fi
    mv "$plan.tmp" "$plan"
    echo "approve OK: $task ($approver, $approved_version)"
    ;;

  complete)
    split_root "$@"
    [ "${#rest[@]}" -eq 2 ] && [ "${rest[1]}" = "--user-accepted" ] || fail 'usage: task complete <task-id> --user-accepted [--root <path>]'
    task="${rest[0]}"
    task_paths "$root" "$task"
    docs="$root/TaskFlowDocs"
    plan_text="$(cat "$plan")"
    require_approval "$task"
    printf '%s\n' "$plan_text" | grep -q '^[[:space:]]*- \[ \]' && fail "Plan has unchecked items"
    printf '%s\n' "$plan_text" | grep -qE '^- Status: (pending|in_progress|blocked)$' && fail "Plan has unfinished Steps"
    [ -e "$docs/achieved/$task" ] && fail "achieved/$task already exists"
    todo="$docs/todo.md"
    [ -f "$todo" ] || fail "todo.md missing; completion not started"
    # Every archive precondition that does not depend on the docs already being
    # `completed` runs before the first write. archive re-checks them; failing
    # here means no docstatus mutation to roll back.
    [ -f "$prd" ] || fail "prd.md missing; completion not started"
    [ -f "$plan" ] || fail "plan.md missing; completion not started"
    run_task_awk "$todo" TASKFLOW_CMD=get TASKFLOW_TASK="$task" TASKFLOW_KEYS="ID" \
      TASKFLOW_NOTFOUND="Todo entry not found: $task"
    # Marking completed is irreversible unless archive succeeds — so remember
    # the prior statuses and put them back when archive fails. Without this a
    # failed archive left prd/plan saying completed beside an active directory.
    plan_prev="$(sed -n 's/^> Status: //p' "$plan" | head -1)"
    prd_prev="$(sed -n 's/^> Status: //p' "$prd" | head -1)"
    [ -n "$plan_prev" ] || fail "plan.md has no > Status: line"
    [ -n "$prd_prev" ] || fail "prd.md has no > Status: line"
    run_awk_to "$plan" "$plan" TASKFLOW_CMD=docstatus TASKFLOW_VALUE=completed
    run_awk_to "$prd" "$prd" TASKFLOW_CMD=docstatus TASKFLOW_VALUE=completed
    archive_out=""
    if ! archive_out="$(cd "$root" && "$bash_cmd" "$SCRIPT_DIR/archive" "$task" 2>&1)"; then
      # Best-effort rollback: each docstatus independently; report archive last.
      run_awk_to "$plan" "$plan" TASKFLOW_CMD=docstatus TASKFLOW_VALUE="$plan_prev" || true
      run_awk_to "$prd" "$prd" TASKFLOW_CMD=docstatus TASKFLOW_VALUE="$prd_prev" || true
      fail "${archive_out:-archive failed}"
    fi
    # Stage/branch instructions from archive go to the Agent, not swallowed.
    [ -z "$archive_out" ] || printf '%s\n' "$archive_out"
    echo "complete OK: $task"
    ;;

  *)
    fail "unknown task command: $command"
    ;;
esac
