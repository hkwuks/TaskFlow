#!/usr/bin/env bash
# version-baseline — record and verify a task version's repository checkpoint.
set -euo pipefail
[ "$#" -eq 4 ] || { echo 'usage: version-baseline <init|check> <root> <task> <version>' >&2; exit 1; }
action="$1"; root="$2"; task="$3"; version="$4"
HERE="$(cd "$(dirname "$0")" && pwd)"
bash "$HERE/task-id" "$task" || exit 1
[[ "$version" =~ ^v[1-9][0-9]*$ ]] || { echo 'invalid task version' >&2; exit 1; }
case "$action" in init|check) ;; *) echo 'invalid baseline action' >&2; exit 1;; esac
# A non-Git task retains its existing lifecycle; an unreadable Git repository fails.
[ -e "$root/.git" ] || exit 0
git_dir="$(git -C "$root" rev-parse --absolute-git-dir)" || { echo 'cannot locate Git metadata' >&2; exit 1; }
head="$(git -C "$root" rev-parse --verify HEAD^{commit})" || { echo 'Git HEAD is not a commit' >&2; exit 1; }
store="$git_dir/taskflow/version-baselines/$task"
file="$store/$version"
# Git status omits assume-unchanged and skip-worktree files, so refuse those
# flags rather than silently treating a potentially modified file as clean.
tracked="$(git -C "$root" ls-files -v -- . ":(exclude,top)TaskFlowDocs/$task/**" ':(exclude,top)TaskFlowDocs/todo.md')" || { echo 'cannot inspect Git index' >&2; exit 1; }
hidden="$(printf '%s\n' "$tracked" | grep -E '^[a-zS] ' || true)"
if [ -n "$hidden" ]; then
  printf 'Git index hides paths from status; inspect and clear their flags before %s %s:\n%s\n' "$action" "$version" "$hidden" >&2
  exit 1
fi
# Porcelain quotes unusual path names, so a newline in a file name is not lost.
status="$(git -C "$root" status --porcelain --untracked-files=all -- . ":(exclude,top)TaskFlowDocs/$task/**" ':(exclude,top)TaskFlowDocs/todo.md')" || { echo 'cannot inspect Git worktree' >&2; exit 1; }
if [ -n "$status" ]; then
  printf 'repository changes must be committed before %s %s:\n%s\n' "$action" "$version" "$status" >&2
  exit 1
fi
if [ "$action" = init ]; then
  mkdir -p "$store"
  if [ -e "$file" ]; then
    existing="$(cat "$file")"
    [ "$existing" = "$head" ] || { echo "baseline already exists for $task $version with a different HEAD" >&2; exit 1; }
  else
    (set -o noclobber; printf '%s\n' "$head" > "$file") || { echo "cannot record baseline for $task $version" >&2; exit 1; }
  fi
  exit 0
fi
[ -f "$file" ] || { echo "missing Git baseline for $task $version; cannot verify this version" >&2; exit 1; }
base="$(cat "$file")"
[[ "$base" =~ ^[0-9a-f]{40,64}$ ]] || { echo "invalid Git baseline for $task $version" >&2; exit 1; }
git -C "$root" cat-file -e "$base^{commit}" 2>/dev/null || { echo "Git baseline is not an available commit: $base" >&2; exit 1; }
git -C "$root" merge-base --is-ancestor "$base" "$head" || { echo "Git baseline is not an ancestor of HEAD: $base" >&2; exit 1; }
printf 'Git version checkpoint: %s..%s (ignored files excluded)\n' "$base" "$head"
