#!/usr/bin/env bash
# smoke-test — assert-style smoke tests for TaskFlow hook scripts.
# Usage: smoke-test [tmp-root]
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
if [ "${1:-}" = "--echo-args" ]; then
  shift
  for arg in "$@"; do
    printf '<'
    printf '%s' "$arg" | od -An -tx1 | tr -d ' \n'
    printf '>|'
  done
  printf '\n'
  exit 0
fi

# Portable SHA-256: GNU coreutils provides sha256sum; stock macOS has shasum.
digest() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}
tmp="${1:-$(mktemp -d)}"
# Auto-clean only roots this script created; a caller-provided root is left
# in place so it is never deleted and stays inspectable.
if [ $# -eq 0 ]; then
  trap 'rm -rf "$tmp"' EXIT
fi

echo "== summarize-state with no TaskFlowDocs prints nothing =="
empty="$(mktemp -d)"; rm -rf "$empty"; mkdir -p "$empty"
out=$(cd "$empty" && bash "$HERE/summarize-state" 2>&1) && [ -z "$out" ] && echo ok
rm -rf "$empty"

echo "== Python runtime preflight is explicit and rejects unusable shims =="
runtime="$(bash "$HERE/python-runtime")"
resolved=$(TASKFLOW_PYTHON="$runtime" bash "$HERE/python-runtime")
[ "$resolved" = "$runtime" ] || { echo "FAIL runtime did not honor usable override"; exit 1; }
shim_dir="$tmp/WindowsApps"
mkdir -p "$shim_dir"
shim="$shim_dir/python3"
printf '#!/usr/bin/env bash\nexit 0\n' > "$shim"
chmod +x "$shim"
if TASKFLOW_PYTHON="$shim" bash "$HERE/python-runtime" >"$tmp/runtime-out" 2>"$tmp/runtime-err"; then
  echo "FAIL WindowsApps shim accepted"
  exit 1
fi
grep -q 'Python 3 is required' "$tmp/runtime-err" || { echo "FAIL runtime error missing guidance"; exit 1; }
echo ok

echo "== session-start emits a platform JSON shape =="
docs="$tmp/TaskFlowDocs"
mkdir -p "$docs/2026-09-08-smoke" "$docs/achieved"
cat > "$docs/2026-09-08-smoke/prd.md" <<'EOF'
# Smoke
> Task version: v1
> Status: completed
EOF
cp "$docs/2026-09-08-smoke/prd.md" "$docs/2026-09-08-smoke/spec.md"
cat > "$docs/2026-09-08-smoke/plan.md" <<'EOF'
# Plan — Smoke
> Task version: v1
> Status: completed

## Approval
- Status: approved
- Approved by: user
- Approved at: 2026-09-08 12:00 +0000
- Approved version: v1
- Approved scope: PRD / Spec / Plan
EOF
cat > "$docs/todo.md" <<'EOF'
# Todo inbox
## Smoke with an arbitrary heading
- ID: T-20260908-999
- Status: in_progress
- Goal: Prove field-based Todo parsing.
- Task: `TaskFlowDocs/2026-09-08-smoke/`
- Updated: 2026-09-08
EOF
summary=$(cd "$tmp" && TASKFLOW_VERBOSE=1 bash "$HERE/summarize-state")
echo "$summary" | grep -q -- "- T-20260908-999 | in_progress | Prove field-based Todo parsing." || { echo "FAIL Todo ID parsing"; exit 1; }
json=$(cd "$tmp" && CLAUDE_PLUGIN_ROOT="$HERE/.." bash "$HERE/session-start" 2>&1)
echo "$json" | grep -q '"hookSpecificOutput"' && echo "ok (claude shape)"

echo "== session-start consumes event JSON and filters other events =="
event_root="$tmp/event-root"
mkdir -p "$event_root/TaskFlowDocs"
printf '# Todo inbox\n' > "$event_root/TaskFlowDocs/todo.md"
session_json=$(printf '{"hook_event_name":"SessionStart","cwd":"%s","session_id":"smoke"}\n' "$event_root" |
  TASKFLOW_REPO_ROOT="$tmp" CLAUDE_PLUGIN_ROOT="$HERE/.." bash "$HERE/session-start")
echo "$session_json" | grep -q 'Repository document routes' || { echo "FAIL SessionStart cwd routing"; exit 1; }
other_root="$tmp/other-event-root"
mkdir -p "$other_root/TaskFlowDocs"
other_json=$(printf '{"hook_event_name":"PreToolUse","cwd":"%s"}\n' "$other_root" |
  CLAUDE_PLUGIN_ROOT="$HERE/.." bash "$HERE/session-start")
[ -z "$other_json" ] || { echo "FAIL non-SessionStart event was handled"; exit 1; }
[ ! -e "$other_root/TaskFlowDocs/repository-docs/index.md" ] || { echo "FAIL non-SessionStart event mutated index"; exit 1; }
if printf '{not-json}\n' | CLAUDE_PLUGIN_ROOT="$HERE/.." bash "$HERE/session-start" >"$tmp/invalid-event.out" 2>"$tmp/invalid-event.err"; then
  echo "FAIL malformed event JSON was accepted"; exit 1;
fi
grep -q 'invalid event JSON' "$tmp/invalid-event.err" || { echo "FAIL malformed event diagnostic missing"; exit 1; }
echo ok

echo "== repository document index sync and phase routing =="
printf '# Contributing\n' > "$tmp/CONTRIBUTING.md"
printf '# Unclassified\n' > "$tmp/TEAM_GOVERNANCE.md"
TASKFLOW_PHASE=pr TASKFLOW_REPO_ROOT="$tmp" bash "$HERE/repository-docs-context" > "$tmp/routes.txt"
index="$docs/repository-docs/index.md"
grep -q '| repository-rule | `CONTRIBUTING.md` | code,commit,pr,release | yes |' "$index" || { echo "FAIL contributing route"; exit 1; }
grep -q '| candidate | `TEAM_GOVERNANCE.md` | review | yes | .* | needs-review |' "$index" || { echo "FAIL candidate review status"; exit 1; }
grep -q 'Read authoritative sources: CONTRIBUTING.md' "$tmp/routes.txt" || { echo "FAIL phase route"; exit 1; }
grep -q 'Needs review before routing: TEAM_GOVERNANCE.md' "$tmp/routes.txt" || { echo "FAIL review context"; exit 1; }
grep -q '| repository-rule | `.github/CODEOWNERS` | pr,review | no | .* | optional |' "$index" || { echo "FAIL optional document status"; exit 1; }
! grep -q 'Missing catalog entries:.*CODEOWNERS' "$tmp/routes.txt" || { echo "FAIL optional document treated as missing"; exit 1; }
# A personal rule sits directly in repository-docs/ and must be routed on its own
# line so its local-only, subordinate status is visible.
before=$(digest "$index")
printf '# My rule\n' > "$docs/repository-docs/my-card.md"
TASKFLOW_PHASE=code TASKFLOW_REPO_ROOT="$tmp" bash "$HERE/repository-docs-context" > "$tmp/personal-routes.txt"
grep -q '| personal-rule | `TaskFlowDocs/repository-docs/my-card.md` | all | yes | .* | local-only |' "$index" || { echo "FAIL personal rule catalog row"; exit 1; }
grep -q '^- Local personal rules (local-only, never committed; they cannot override the sources above): TaskFlowDocs/repository-docs/my-card.md$' "$tmp/personal-routes.txt" || { echo "FAIL personal rule route line"; exit 1; }
! grep -q 'Read authoritative sources:.*my-card.md' "$tmp/personal-routes.txt" || { echo "FAIL personal rule merged into authoritative sources"; exit 1; }
rm -f "$docs/repository-docs/my-card.md"
TASKFLOW_PHASE=pr TASKFLOW_REPO_ROOT="$tmp" bash "$HERE/repository-docs-context" >/dev/null
[ "$before" = "$(digest "$index")" ] || { echo "FAIL index sync not idempotent"; exit 1; }
echo ok

echo "== repository document index rejects unsafe paths and busy writers =="
unsafe="$tmp/unsafe"
mkdir -p "$unsafe/TaskFlowDocs/repository-docs"
cat > "$unsafe/TaskFlowDocs/repository-docs/index.md" <<'EOF'
# Repository documents
| legacy | `../outside.md` | all | yes | 2026-09-12 | ready |
EOF
if TASKFLOW_REPO_ROOT="$unsafe" bash "$HERE/repository-docs-context" >/dev/null 2>"$tmp/unsafe.err"; then
  echo "FAIL unsafe index path accepted"; exit 1
fi
grep -q 'unsafe repository-document path' "$tmp/unsafe.err" || { echo "FAIL unsafe path error missing"; exit 1; }
printf '# Repository documents\n| malformed row |\n' > "$unsafe/TaskFlowDocs/repository-docs/index.md"
before=$(digest "$unsafe/TaskFlowDocs/repository-docs/index.md")
if TASKFLOW_REPO_ROOT="$unsafe" bash "$HERE/repository-docs-context" >/dev/null 2>"$tmp/malformed.err"; then
  echo "FAIL malformed index row accepted"; exit 1
fi
grep -q 'invalid row' "$tmp/malformed.err" || { echo "FAIL malformed row error missing"; exit 1; }
[ "$before" = "$(digest "$unsafe/TaskFlowDocs/repository-docs/index.md")" ] || { echo "FAIL malformed index was overwritten"; exit 1; }
mkdir "$unsafe/TaskFlowDocs/repository-docs/index.md.lock"
busy="$tmp/busy"
mkdir -p "$busy/TaskFlowDocs/repository-docs"
printf '# Repository documents\n' > "$busy/TaskFlowDocs/repository-docs/index.md"
mkdir "$busy/TaskFlowDocs/repository-docs/index.md.lock"
if TASKFLOW_REPO_ROOT="$busy" bash "$HERE/repository-docs-context" >/dev/null 2>"$tmp/lock.err"; then
  echo "FAIL busy index writer accepted"; exit 1
fi
grep -q 'index is busy' "$tmp/lock.err" || { echo "FAIL busy writer error missing"; exit 1; }
rm -rf "$unsafe/TaskFlowDocs/repository-docs/index.md.lock" "$busy/TaskFlowDocs/repository-docs/index.md.lock"
echo ok

echo "== auto phase routing selects the current task =="
multi="$tmp/multi-task"
mkdir -p "$multi/TaskFlowDocs/2026-09-11-code-task" "$multi/TaskFlowDocs/2026-09-11-review-task"
cat > "$multi/TaskFlowDocs/2026-09-11-code-task/plan.md" <<'EOF'
# Plan — Code task
> Status: in_progress
EOF
cat > "$multi/TaskFlowDocs/2026-09-11-review-task/plan.md" <<'EOF'
# Plan — Review task
> Status: checking
EOF
TASKFLOW_PHASE=auto TASKFLOW_TASK_ID=2026-09-11-code-task TASKFLOW_REPO_ROOT="$multi" \
  bash "$HERE/repository-docs-context" > "$multi/selected-routes.txt"
grep -q '^# Repository document routes (code)$' "$multi/selected-routes.txt" || {
  echo "FAIL current task phase selection"; exit 1;
}
TASKFLOW_PHASE=auto TASKFLOW_REPO_ROOT="$multi" \
  bash "$HERE/repository-docs-context" > "$multi/ambiguous-routes.txt"
grep -q '^# Repository document routes (unclassified)$' "$multi/ambiguous-routes.txt" || {
  echo "FAIL ambiguous task detection"; exit 1;
}
echo ok

echo "== SessionStart context is compact by default and verbose on request =="
compact="$tmp/context-compact"
mkdir -p "$compact/TaskFlowDocs/2026-09-13-one" "$compact/TaskFlowDocs/2026-09-13-two"
printf '# Plan — One\n> Task version: v1\n> Status: in_progress\n\n## Approval\n- Status: approved\n\n### Step 1 — Work\n- Status: pending\n' > "$compact/TaskFlowDocs/2026-09-13-one/plan.md"
printf '# Plan — Two\n> Task version: v1\n> Status: in_progress\n' > "$compact/TaskFlowDocs/2026-09-13-two/plan.md"
printf '# Todo inbox\n' > "$compact/TaskFlowDocs/todo.md"
default=$(TASKFLOW_REPO_ROOT="$compact" bash "$HERE/summarize-state")
echo "$default" | grep -q 'Multiple active tasks' || { echo "FAIL ambiguous default context"; exit 1; }
verbose_out=$(TASKFLOW_REPO_ROOT="$compact" TASKFLOW_VERBOSE=1 bash "$HERE/summarize-state")
echo "$verbose_out" | grep -q '2026-09-13-one' || { echo "FAIL verbose context missing task"; exit 1; }
selected=$(TASKFLOW_REPO_ROOT="$compact" TASKFLOW_TASK_ID=2026-09-13-one bash "$HERE/summarize-state")
echo "$selected" | grep -q '2026-09-13-one' || { echo "FAIL explicit task context"; exit 1; }
invalid=$(TASKFLOW_REPO_ROOT="$compact" TASKFLOW_TASK_ID=missing bash "$HERE/summarize-state")
echo "$invalid" | grep -q 'Requested task unavailable' || { echo "FAIL invalid task diagnostic"; exit 1; }
echo ok

if command -v cmd.exe >/dev/null 2>&1 && command -v cygpath >/dev/null 2>&1; then
  echo "== Windows launcher finds Git Bash =="
  win_hook=$(cygpath -w "$HERE/run-hook.cmd")
  json=$(cd "$tmp" && TASKFLOW_REPO_ROOT="$tmp" cmd.exe //d //c "$win_hook" session-start 2>&1)
  echo "$json" | grep -q 'additionalContext\|additional_context\|hookSpecificOutput' || { echo "FAIL Windows launcher"; exit 1; }
  echo ok
fi

if command -v powershell.exe >/dev/null 2>&1 && command -v cygpath >/dev/null 2>&1; then
  echo "== Windows PowerShell/cmd lifecycle with spaces and Chinese =="
  win_smoke=$(cygpath -w "$HERE/smoke-test-windows.ps1")
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$win_smoke"
fi

echo "== archive preflight does not move without Todo =="
preflight="$tmp/preflight"
mkdir -p "$preflight/TaskFlowDocs/2026-09-08-preflight"
cp "$docs/2026-09-08-smoke/prd.md" "$preflight/TaskFlowDocs/2026-09-08-preflight/prd.md"
cp "$docs/2026-09-08-smoke/plan.md" "$preflight/TaskFlowDocs/2026-09-08-preflight/plan.md"
if bash "$HERE/archive" 2026-09-08-preflight "$preflight" >/dev/null 2>&1; then echo "FAIL archive accepted missing Todo"; exit 1; fi
[ -d "$preflight/TaskFlowDocs/2026-09-08-preflight" ] || { echo "FAIL archive moved before preflight"; exit 1; }
echo ok

echo "== archive happy path =="
bash "$HERE/archive" 2026-09-08-smoke "$tmp" >/dev/null
[ ! -d "$docs/2026-09-08-smoke" ] || { echo "FAIL active remains"; exit 1; }
[ -d "$docs/achieved/2026-09-08-smoke" ] || { echo "FAIL not archived"; exit 1; }
grep -q -- "- Status: done" "$docs/todo.md" || { echo "FAIL todo not done"; exit 1; }
grep -q "achieved/2026-09-08-smoke" "$docs/todo.md" || { echo "FAIL todo path"; exit 1; }
echo ok

echo "== reopen restores =="
bash "$HERE/reopen" 2026-09-08-smoke "$tmp" >/dev/null
[ -d "$docs/2026-09-08-smoke" ] || { echo "FAIL reopen"; exit 1; }
grep -q "reopen" "$docs/2026-09-08-smoke/plan.md" || { echo "FAIL reopen log"; exit 1; }
echo ok

echo "== version bumps root + archives only changed docs =="
old_prd=$(digest "$docs/2026-09-08-smoke/prd.md")
bash "$HERE/version" 2026-09-08-smoke v2 "$tmp" prd.md >/dev/null
[ -f "$docs/2026-09-08-smoke/old/v1/prd.md" ] || { echo "FAIL old prd"; exit 1; }
[ -f "$docs/2026-09-08-smoke/prd.md" ] || { echo "FAIL changed prd missing at root"; exit 1; }
[ "$old_prd" = "$(digest "$docs/2026-09-08-smoke/old/v1/prd.md")" ] || { echo "FAIL archived prd changed"; exit 1; }
[ -f "$docs/2026-09-08-smoke/spec.md" ] || { echo "FAIL unchanged spec should stay"; exit 1; }
[ ! -f "$docs/2026-09-08-smoke/old/v1/spec.md" ] || { echo "FAIL unchanged spec archived"; exit 1; }
[ -f "$docs/2026-09-08-smoke/plan.md" ] || { echo "FAIL plan not left"; exit 1; }
grep -q '> Task version: v2' "$docs/2026-09-08-smoke/plan.md" || { echo "FAIL plan not bumped"; exit 1; }
grep -q '> Task version: v2' "$docs/2026-09-08-smoke/prd.md" || { echo "FAIL retained prd not bumped"; exit 1; }
grep -q '> Status: ready' "$docs/2026-09-08-smoke/plan.md" || { echo "FAIL plan not ready"; exit 1; }
grep -A8 '^## Approval$' "$docs/2026-09-08-smoke/plan.md" | grep -q -- '- Approved version: pending' || { echo "FAIL approval not reset"; exit 1; }
echo ok

echo "== version rejects invalid input before mutation =="
if bash "$HERE/version" 2026-09-08-smoke v3 "$tmp" notes.md >/dev/null 2>&1; then echo "FAIL invalid core document accepted"; exit 1; fi
[ ! -e "$docs/2026-09-08-smoke/old/v2" ] || { echo "FAIL invalid input mutated archive"; exit 1; }
grep -q '> Task version: v2' "$docs/2026-09-08-smoke/plan.md" || { echo "FAIL invalid input mutated root"; exit 1; }
echo ok

echo "== task lifecycle dispatcher =="
lifecycle="$tmp/lifecycle"
mkdir -p "$lifecycle/verification-dir"
bash "$HERE/task" intake "Lifecycle smoke goal." "local fixture" --root "$lifecycle" >/dev/null
todo="$lifecycle/TaskFlowDocs/todo.md"
todo_id=$(awk '/^- ID: TF-/{print $3; exit}' "$todo")
before=$(digest "$todo")
if bash "$HERE/task" intake "Lifecycle smoke goal." "local fixture" --root "$lifecycle" >/dev/null 2>&1; then echo "FAIL duplicate goal accepted"; exit 1; fi
[ "$before" = "$(digest "$todo")" ] || { echo "FAIL duplicate goal mutated Todo"; exit 1; }
bash "$HERE/task" promote "$todo_id" 2026-09-10-lifecycle-smoke small --root "$lifecycle" >/dev/null
active="$lifecycle/TaskFlowDocs/2026-09-10-lifecycle-smoke"
[ -f "$active/prd.md" ] && [ -f "$active/plan.md" ] && [ ! -e "$active/spec.md" ] || { echo "FAIL small promotion artifacts"; exit 1; }
grep -q 'TaskFlowDocs/2026-09-10-lifecycle-smoke/' "$todo" || { echo "FAIL promotion Todo link"; exit 1; }
if bash "$HERE/task" state 2026-09-10-lifecycle-smoke in_progress --root "$lifecycle" >/dev/null 2>&1; then echo "FAIL unapproved state accepted"; exit 1; fi
grep -q '> Status: planning' "$active/plan.md" || { echo "FAIL rejected state mutated Plan"; exit 1; }
sed 's/- Status: requested/- Status: approved/; s/- Approved version: pending/- Approved version: v1/' "$active/plan.md" > "$active/plan.md.tmp"
mv "$active/plan.md.tmp" "$active/plan.md"
bash "$HERE/task" state 2026-09-10-lifecycle-smoke in_progress --root "$lifecycle" >/dev/null
if bash "$HERE/task" progress 2026-09-10-lifecycle-smoke 1 done --root "$lifecycle" >/dev/null 2>&1; then echo "FAIL unchecked Step accepted"; exit 1; fi
sed 's/- \[ \]/- [x]/g' "$active/plan.md" > "$active/plan.md.tmp"
mv "$active/plan.md.tmp" "$active/plan.md"
bash "$HERE/task" progress 2026-09-10-lifecycle-smoke 1 done "verification-dir" --root "$lifecycle" >/dev/null
grep -q 'Step 1: verification-dir' "$active/plan.md" || { echo "FAIL verification not recorded"; exit 1; }
if bash "$HERE/task" complete 2026-09-10-lifecycle-smoke --root "$lifecycle" >/dev/null 2>&1; then echo "FAIL completion without acceptance"; exit 1; fi
[ -d "$active" ] || { echo "FAIL rejected completion moved task"; exit 1; }
bash "$HERE/task" complete 2026-09-10-lifecycle-smoke --user-accepted --root "$lifecycle" >/dev/null
[ ! -d "$active" ] && [ -d "$lifecycle/TaskFlowDocs/achieved/2026-09-10-lifecycle-smoke" ] || { echo "FAIL lifecycle archive"; exit 1; }
grep -q -- '- Status: done' "$todo" || { echo "FAIL lifecycle Todo not done"; exit 1; }
echo ok

echo "== TaskFlow packaged Skill contract =="
repo=$(cd "$HERE/.." && pwd)
skill="$repo/skills/taskflow"
[ -f "$skill/SKILL.md" ] && [ -f "$skill/agents/openai.yaml" ] || { echo "FAIL incomplete packaged Skill"; exit 1; }
[ ! -e "$repo/SKILL.md" ] && [ ! -e "$repo/agents" ] && [ ! -e "$repo/references" ] || { echo "FAIL duplicate root Skill"; exit 1; }
grep -q 'selection alone is not invocation' "$skill/SKILL.md" || { echo "FAIL selection/invocation boundary"; exit 1; }
grep -q 'does not require the selection or use of any particular capability' "$skill/SKILL.md" || { echo "FAIL autonomous choice boundary"; exit 1; }
grep -q 'Apply TaskFlow automatically only when the request asks to modify a repository or deliver a development artifact' "$skill/SKILL.md" || { echo "FAIL development applicability boundary"; exit 1; }
grep -q 'Do not create or update Todo/task documents for read-only explanation' "$skill/SKILL.md" || { echo "FAIL read-only exclusion"; exit 1; }
grep -q 'explicit user request to use `\$taskflow` opts any planning or research work' "$skill/SKILL.md" || { echo "FAIL explicit invocation override"; exit 1; }
grep -q 'never assume `origin` is the fork or `upstream` exists' "$skill/SKILL.md" || { echo "FAIL fork remote boundary"; exit 1; }
grep -q 'For missing `CONTRIBUTING.md` or `CODE_STYLE.md`' "$skill/SKILL.md" || { echo "FAIL baseline governance drafting"; exit 1; }
grep -q 'Create `ROADMAP.md` only after the user confirms product direction' "$skill/SKILL.md" || { echo "FAIL roadmap direction gate"; exit 1; }
grep -q 'never committed' "$skill/SKILL.md" && grep -q 'never committed' "$skill/references/artifacts.md" || { echo "FAIL personal supplement git boundary"; exit 1; }
echo ok

echo "== repository-check is read-only and reports actionable status =="
check_root="$tmp/repository-check"
mkdir -p "$check_root/.git" "$check_root/TaskFlowDocs/repository-docs"
git -C "$check_root" init -q
printf '# Catalog\n' > "$check_root/TaskFlowDocs/repository-docs/index.md"
set +e
check_out=$(bash "$HERE/repository-check" "$check_root" 2>&1)
check_status=$?
set -e
echo "$check_out" | grep -q 'STATUS: needs-user-input' || { echo "FAIL repository-check status"; exit 1; }
[ "$check_status" -eq 2 ] || { echo "FAIL repository-check exit code"; exit 1; }
echo "$check_out" | grep -q 'Document CONTRIBUTING.md: missing' || { echo "FAIL repository-check governance finding"; exit 1; }
echo "$check_out" | grep -q 'Base: ambiguous' || { echo "FAIL repository-check base finding"; exit 1; }
echo ok

echo "ALL SMOKE PASSED"
