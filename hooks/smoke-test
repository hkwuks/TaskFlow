  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$win_smoke"
fi

echo "== archive preflight does not move without Todo =="
preflight="$tmp/preflight"
mkdir -p "$preflight/TaskFlowDocs/2026-09-08-preflight"
cp "$docs/2026-09-08-smoke/prd.md" "$preflight/TaskFlowDocs/2026-09-08-preflight/prd.md"
cp "$docs/2026-09-08-smoke/plan.md" "$preflight/TaskFlowDocs/2026-09-08-preflight/plan.md"
if bash "$HERE/archive" 2026-09-08-preflight "$preflight" >/dev/null 2>&1; then echo "FAIL archive accepted missing Todo"; exit 1; fi
[ -d "$preflight/TaskFlowDocs/2026-09-08-preflight" ] || { echo "FAIL archive moved before preflight"; exit 1; }
echo ok

echo "== archive happy path =="
# Capture stdout: it must carry the stage/branch instructions.
arch_out="$tmp/archive-out"
bash "$HERE/archive" 2026-09-08-smoke "$tmp" > "$arch_out"
[ ! -d "$docs/2026-09-08-smoke" ] || { echo "FAIL active remains"; exit 1; }
[ -d "$docs/achieved/2026-09-08-smoke" ] || { echo "FAIL not archived"; exit 1; }
grep -q -- "- Status: done" "$docs/todo.md" || { echo "FAIL todo not done"; exit 1; }
grep -q "achieved/2026-09-08-smoke" "$docs/todo.md" || { echo "FAIL todo path"; exit 1; }
# This fixture entry has no `- Next action:` at all, so archiving has to add the
# canonical line rather than silently leave a done entry with no next action.
grep -A1 -- "- Status: done" "$docs/todo.md" | grep -q -- "- Next action: None — completed and archived." || { echo "FAIL next action not added to an entry that lacked one"; exit 1; }
# Exactly one, not one more: an archive that adds the line without replacing an
# existing one leaves the entry with two next actions and only the first is read.
[ "$(grep -c '^- Next action:' "$docs/todo.md")" -eq 1 ] || { echo "FAIL archive left more than one next action:"; grep -n '^- Next action:' "$docs/todo.md"; exit 1; }
# R3: exact stage line + current-branch rule (hook never runs Git itself).
grep -q "git add -A -- 'TaskFlowDocs/2026-09-08-smoke'" "$arch_out" \
  || { echo "FAIL archive did not print the stage command"; cat "$arch_out"; exit 1; }
grep -q 'TaskFlowDocs/achieved/2026-09-08-smoke' "$arch_out" \
  || { echo "FAIL stage command missing the achieved path"; cat "$arch_out"; exit 1; }
grep -qi 'current branch' "$arch_out" \
  || { echo "FAIL archive did not state the current-branch rule"; cat "$arch_out"; exit 1; }
grep -qi 'do not switch' "$arch_out" \
  || { echo "FAIL archive did not forbid switching branches for the commit"; cat "$arch_out"; exit 1; }
echo ok

echo "== archive todo rewrite only touches Status/Task/Next action =="
# R4 / 172455: lock the three-field rewrite. Diff against a copy taken just
# before archive… already archived above; rebuild a twin fixture from the same
# shape the happy path used, snapshot todo, archive, and require every changed
# line to be one of the three fields (plus the inserted Next action).
r4="$tmp/archive-r4"
mkdir -p "$r4/TaskFlowDocs/2026-09-08-r4" "$r4/TaskFlowDocs/achieved"
cp "$docs/2026-09-08-smoke/prd.md" "$r4/TaskFlowDocs/2026-09-08-r4/prd.md" 2>/dev/null || true
# prd/plan already archived; reconstruct completed pair + todo with the link
printf '# P\n> Task version: v1\n> Status: completed\n' > "$r4/TaskFlowDocs/2026-09-08-r4/prd.md"
printf '# Plan\n> Task version: v1\n> Status: completed\n' > "$r4/TaskFlowDocs/2026-09-08-r4/plan.md"
cat > "$r4/TaskFlowDocs/todo.md" <<'EOF'
# Todo inbox

## Items

<!-- Add new items at the top using the template below. -->
## Item template

## R4 entry

- ID: T-20260908-r4
- Status: in_progress
- Goal: r4
- Task: `TaskFlowDocs/2026-09-08-r4/`
- Updated: 2026-09-08
EOF
cp "$r4/TaskFlowDocs/todo.md" "$tmp/r4-todo-before"
bash "$HERE/archive" 2026-09-08-r4 "$r4" >/dev/null
# Unified diff: every +/- line must match Status, Task, or Next action (or ---/+++).
# `diff` exits 1 when files differ — that is the expected case — so it must not
# trip `set -e`/`pipefail` before awk can filter the lines.
bad_diff="$(
  { diff -u "$tmp/r4-todo-before" "$r4/TaskFlowDocs/todo.md" || true; } | awk '
    /^(---|\+\+\+|@@)/ { next }
    /^[+-]/ {
      line = substr($0, 2)
      if (line ~ /^- Status:/ || line ~ /^- Task:/ || line ~ /^- Next action:/) next
      print
    }'
)"
[ -z "$bad_diff" ] || { echo "FAIL archive changed a line outside Status/Task/Next action:"; printf '%s\n' "$bad_diff"; exit 1; }
# No blank line invented at EOF: the file must not end with two newlines.
last2="$(tail -c 2 "$r4/TaskFlowDocs/todo.md" | od -An -tx1 | tr -d ' \n')"
case "$last2" in
  *0a0a*) echo "FAIL archive left a blank line at EOF"; exit 1 ;;
esac
# No extra blank inserted right after the Item template heading (172455):
# heading, at most one blank, then the next non-empty line.
if ! awk '
  /^## Item template$/ {
    getline
    if ($0 == "") {
      getline
      if ($0 == "") exit 1
    }
  }
  END { exit 0 }
' "$r4/TaskFlowDocs/todo.md"; then
  echo "FAIL archive inserted a blank after the item template heading"
  exit 1
fi
echo ok

echo "== complete rolls back doc status when archive fails =="
# Fixture-only stub: complete resolves archive via SCRIPT_DIR, so a copied
# hooks/ tree with a failing archive exercises the rollback path with no
# production test flag.
roll="$tmp/rollback-hooks"
mkdir -p "$roll"
cp "$HERE/task" "$roll/task"
printf '%s\n' '#!/bin/sh' 'echo "archive stub: forced failure"' 'exit 1' > "$roll/archive"
chmod +x "$roll/archive" "$roll/task"
rf="$tmp/rollback-root"
mkdir -p "$rf"
bash "$roll/task" intake "Rollback smoke goal." "fixture" --root "$rf" >/dev/null
rid=$(awk '/^- ID: TF-/{print $3; exit}' "$rf/TaskFlowDocs/todo.md")
bash "$roll/task" promote "$rid" 2026-09-22-rollback-smoke small --root "$rf" >/dev/null
rtask="$rf/TaskFlowDocs/2026-09-22-rollback-smoke"
# approve + check every box + finish step so complete's gates pass
sed 's/- Status: requested/- Status: approved/; s/- Approved by: pending/- Approved by: user/; s/- Approved version: pending/- Approved version: v1/' \
  "$rtask/plan.md" > "$rtask/plan.md.tmp"
mv "$rtask/plan.md.tmp" "$rtask/plan.md"
sed 's/- \[ \]/- [x]/g; s/^- Status: pending$/- Status: done/' "$rtask/plan.md" > "$rtask/plan.md.tmp"
mv "$rtask/plan.md.tmp" "$rtask/plan.md"
# state in_progress for a realistic prior status
bash "$roll/task" state 2026-09-22-rollback-smoke in_progress --root "$rf" >/dev/null
prev_plan="$(sed -n 's/^> Status: //p' "$rtask/plan.md" | head -1)"
prev_prd="$(sed -n 's/^> Status: //p' "$rtask/prd.md" | head -1)"
set +e
roll_out="$(bash "$roll/task" complete 2026-09-22-rollback-smoke --user-accepted --root "$rf" 2>&1)"
roll_rc=$?
set -e
[ "$roll_rc" -ne 0 ] || { echo "FAIL complete succeeded with a failing archive"; printf '%s\n' "$roll_out"; exit 1; }
echo "$roll_out" | grep -q 'archive stub: forced failure' \
  || { echo "FAIL complete did not surface the archive error"; printf '%s\n' "$roll_out"; exit 1; }
[ -d "$rtask" ] || { echo "FAIL rollback left the active directory moved"; exit 1; }
now_plan="$(sed -n 's/^> Status: //p' "$rtask/plan.md" | head -1)"
now_prd="$(sed -n 's/^> Status: //p' "$rtask/prd.md" | head -1)"
[ "$now_plan" = "$prev_plan" ] || { echo "FAIL plan status not restored: $now_plan != $prev_plan"; exit 1; }
[ "$now_prd" = "$prev_prd" ] || { echo "FAIL prd status not restored: $now_prd != $prev_prd"; exit 1; }
[ "$now_plan" != "completed" ] || { echo "FAIL plan still completed after failed archive"; exit 1; }
echo ok

echo "== reopen restores =="
bash "$HERE/reopen" 2026-09-08-smoke "$tmp" >/dev/null
[ -d "$docs/2026-09-08-smoke" ] || { echo "FAIL reopen"; exit 1; }
grep -q "reopen" "$docs/2026-09-08-smoke/plan.md" || { echo "FAIL reopen log"; exit 1; }
echo ok

echo "== version bumps root + archives only changed docs =="
old_prd=$(digest "$docs/2026-09-08-smoke/prd.md")
bash "$HERE/version" 2026-09-08-smoke v2 "$tmp" prd.md >/dev/null
[ -f "$docs/2026-09-08-smoke/old/v1/prd.md" ] || { echo "FAIL old prd"; exit 1; }
[ -f "$docs/2026-09-08-smoke/prd.md" ] || { echo "FAIL changed prd missing at root"; exit 1; }
[ "$old_prd" = "$(digest "$docs/2026-09-08-smoke/old/v1/prd.md")" ] || { echo "FAIL archived prd changed"; exit 1; }
[ -f "$docs/2026-09-08-smoke/spec.md" ] || { echo "FAIL unchanged spec should stay"; exit 1; }
[ ! -f "$docs/2026-09-08-smoke/old/v1/spec.md" ] || { echo "FAIL unchanged spec archived"; exit 1; }
[ -f "$docs/2026-09-08-smoke/plan.md" ] || { echo "FAIL plan not left"; exit 1; }
grep -q '> Task version: v2' "$docs/2026-09-08-smoke/plan.md" || { echo "FAIL plan not bumped"; exit 1; }
grep -q '> Task version: v2' "$docs/2026-09-08-smoke/prd.md" || { echo "FAIL retained prd not bumped"; exit 1; }
grep -q '> Status: ready' "$docs/2026-09-08-smoke/plan.md" || { echo "FAIL plan not ready"; exit 1; }
# Full five-field block in promote order — not a single-field probe.
approval_fields="$(awk '
  /^## Approval$/ { p = 1; next }
  p && /^## / { exit }
  p && /^- Status:/ { print; next }
  p && /^- Approved by:/ { print; next }
  p && /^- Approved at:/ { print; next }
  p && /^- Approved version:/ { print; next }
  p && /^- Approved scope:/ { print; next }
' "$docs/2026-09-08-smoke/plan.md")"
expected_approval='- Status: requested
- Approved by: pending
- Approved at: pending
- Approved version: pending
- Approved scope: pending'
[ "$approval_fields" = "$expected_approval" ] || {
  echo "FAIL approval not reset to the five-field block:"
  printf '%s\n' "$approval_fields"
  exit 1
}
echo ok

echo "== version writes five-field Approval when Status is missing =="
# Skill used to document a four-field record (no Status). version must still
# emit the promote template rather than refuse on the absent line.
v4root="$tmp/version-approval-shape"
mkdir -p "$v4root/TaskFlowDocs/2026-09-08-v4shape"
cat > "$v4root/TaskFlowDocs/2026-09-08-v4shape/prd.md" <<'EOF'
# PRD — Shape
> Task version: v1
> Status: ready
EOF
cat > "$v4root/TaskFlowDocs/2026-09-08-v4shape/plan.md" <<'EOF'
# Plan — Shape
> Task version: v1
> Status: in_progress

## Approval
- Approved by: user
- Approved at: 2026-09-08 12:00 +0000
- Approved version: v1
- Approved scope: PRD / Plan

## Steps
- x
EOF
bash "$HERE/version" 2026-09-08-v4shape v2 "$v4root" prd.md >/dev/null \
  || { echo "FAIL version refused a plan missing Status"; exit 1; }
approval_fields="$(awk '
  /^## Approval$/ { p = 1; next }
  p && /^## / { exit }
  p && /^- Status:/ { print; next }
  p && /^- Approved by:/ { print; next }
  p && /^- Approved at:/ { print; next }
  p && /^- Approved version:/ { print; next }
  p && /^- Approved scope:/ { print; next }
' "$v4root/TaskFlowDocs/2026-09-08-v4shape/plan.md")"
[ "$approval_fields" = "$expected_approval" ] || {
  echo "FAIL missing-Status plan not rewritten to the five-field block:"
  printf '%s\n' "$approval_fields"
  exit 1
}
echo ok

echo "== version rejects invalid input before mutation =="
if bash "$HERE/version" 2026-09-08-smoke v3 "$tmp" notes.md >/dev/null 2>&1; then echo "FAIL invalid core document accepted"; exit 1; fi
[ ! -e "$docs/2026-09-08-smoke/old/v2" ] || { echo "FAIL invalid input mutated archive"; exit 1; }
grep -q '> Task version: v2' "$docs/2026-09-08-smoke/plan.md" || { echo "FAIL invalid input mutated root"; exit 1; }
echo ok

echo "== version refuses to archive uncommitted tracked documents =="
# `version` copies the superseded documents from the working tree, so a document
# already edited for the next version was archived as if it were the old one and
# `old/vN/` stopped recording what was approved. A real repository is required:
# the guard is `git ls-files` plus `git diff`, which a plain fixture cannot
# exercise.
write_dirty_fixture() {  # write_dirty_fixture <task-dir>
  mkdir -p "$1"
  printf '# PRD — Dirty\n> Task version: v2\n> Status: in_progress\n' > "$1/prd.md"
  printf '# Plan — Dirty\n> Task version: v2\n> Status: in_progress\n\n## Approval\n- Status: approved\n- Approved by: user\n- Approved at: 2026-09-09 12:00 +0000\n- Approved version: v2\n- Approved scope: PRD / Plan\n' > "$1/plan.md"
}
vroot="$tmp/version-dirty"
write_dirty_fixture "$vroot/TaskFlowDocs/2026-09-09-dirty"
(
  cd "$vroot" || exit 1
  git init -q .
  git config user.email smoke@example.invalid
  git config user.name smoke
  git add -A && git commit -q -m fixture
) || { echo "FAIL version fixture repository"; exit 1; }
dirty="$vroot/TaskFlowDocs/2026-09-09-dirty"
# The next version's content, written before the bump was taken: the case that
# silently polluted old/v1 for 2026-09-15-no-python-hooks.
printf '# PRD — Dirty\n> Task version: v2\n> Status: in_progress\n\n## Goal\n\nv3 CONTENT ALREADY WRITTEN\n' > "$dirty/prd.md"
dirty_before=$(digest "$dirty/prd.md")
if bash "$HERE/version" 2026-09-09-dirty v3 "$vroot" prd.md >/dev/null 2>&1; then
  echo "FAIL version archived an uncommitted tracked document"; exit 1
fi
[ ! -e "$dirty/old/v2" ] || { echo "FAIL rejected version still created the archive"; exit 1; }
[ "$dirty_before" = "$(digest "$dirty/prd.md")" ] || { echo "FAIL rejected version mutated the root document"; exit 1; }
grep -q '> Task version: v2' "$dirty/plan.md" || { echo "FAIL rejected version bumped the root Plan"; exit 1; }
# Committing the superseded version is the documented way out, and then the
# archive holds that committed content.
( cd "$vroot" && git add -A && git commit -q -m superseded ) || { echo "FAIL fixture commit"; exit 1; }
bash "$HERE/version" 2026-09-09-dirty v3 "$vroot" prd.md >/dev/null
[ -f "$dirty/old/v2/prd.md" ] || { echo "FAIL clean superseded version not archived"; exit 1; }
[ "$dirty_before" = "$(digest "$dirty/old/v2/prd.md")" ] || { echo "FAIL archive differs from the committed version"; exit 1; }
# Documents kept out of Git have no committed baseline to protect and stay
# archivable while dirty.
uroot="$tmp/version-untracked"
write_dirty_fixture "$uroot/TaskFlowDocs/2026-09-09-untracked"
printf '# PRD — Dirty\n> Task version: v2\n> Status: in_progress\n\n## Goal\n\nfile-mode edit\n' > "$uroot/TaskFlowDocs/2026-09-09-untracked/prd.md"
(
  cd "$uroot" || exit 1
  git init -q . && git config user.email smoke@example.invalid && git config user.name smoke
) || { echo "FAIL untracked fixture repository"; exit 1; }
bash "$HERE/version" 2026-09-09-untracked v3 "$uroot" prd.md >/dev/null ||
  { echo "FAIL untracked document refused"; exit 1; }
[ -f "$uroot/TaskFlowDocs/2026-09-09-untracked/old/v2/prd.md" ] || { echo "FAIL untracked document not archived"; exit 1; }
echo ok

echo "== task lifecycle dispatcher =="
lifecycle="$tmp/lifecycle"
mkdir -p "$lifecycle/verification-dir"
bash "$HERE/task" intake "Lifecycle smoke goal." "local fixture" --root "$lifecycle" >/dev/null
todo="$lifecycle/TaskFlowDocs/todo.md"
todo_id=$(awk '/^- ID: TF-/{print $3; exit}' "$todo")
before=$(digest "$todo")
if bash "$HERE/task" intake "Lifecycle smoke goal." "local fixture" --root "$lifecycle" >/dev/null 2>&1; then echo "FAIL duplicate goal accepted"; exit 1; fi
[ "$before" = "$(digest "$todo")" ] || { echo "FAIL duplicate goal mutated Todo"; exit 1; }
bash "$HERE/task" promote "$todo_id" 2026-09-10-lifecycle-smoke small --root "$lifecycle" >/dev/null
active="$lifecycle/TaskFlowDocs/2026-09-10-lifecycle-smoke"
[ -f "$active/prd.md" ] && [ -f "$active/plan.md" ] && [ ! -e "$active/spec.md" ] || { echo "FAIL small promotion artifacts"; exit 1; }
grep -q 'TaskFlowDocs/2026-09-10-lifecycle-smoke/' "$todo" || { echo "FAIL promotion Todo link"; exit 1; }
if bash "$HERE/task" state 2026-09-10-lifecycle-smoke in_progress --root "$lifecycle" >/dev/null 2>&1; then echo "FAIL unapproved state accepted"; exit 1; fi
grep -q '> Status: planning' "$active/plan.md" || { echo "FAIL rejected state mutated Plan"; exit 1; }
sed 's/- Status: requested/- Status: approved/; s/- Approved by: pending/- Approved by: user/; s/- Approved version: pending/- Approved version: v1/' "$active/plan.md" > "$active/plan.md.tmp"
mv "$active/plan.md.tmp" "$active/plan.md"
bash "$HERE/task" state 2026-09-10-lifecycle-smoke in_progress --root "$lifecycle" >/dev/null
if bash "$HERE/task" progress 2026-09-10-lifecycle-smoke 1 done --root "$lifecycle" >/dev/null 2>&1; then echo "FAIL unchecked Step accepted"; exit 1; fi
sed 's/- \[ \]/- [x]/g' "$active/plan.md" > "$active/plan.md.tmp"
mv "$active/plan.md.tmp" "$active/plan.md"
bash "$HERE/task" progress 2026-09-10-lifecycle-smoke 1 done "verification-dir" --root "$lifecycle" >/dev/null
grep -q 'Step 1: verification-dir' "$active/plan.md" || { echo "FAIL verification not recorded"; exit 1; }
if bash "$HERE/task" complete 2026-09-10-lifecycle-smoke --root "$lifecycle" >/dev/null 2>&1; then echo "FAIL completion without acceptance"; exit 1; fi
[ -d "$active" ] || { echo "FAIL rejected completion moved task"; exit 1; }
bash "$HERE/task" complete 2026-09-10-lifecycle-smoke --user-accepted --root "$lifecycle" >/dev/null
[ ! -d "$active" ] && [ -d "$lifecycle/TaskFlowDocs/achieved/2026-09-10-lifecycle-smoke" ] || { echo "FAIL lifecycle archive"; exit 1; }
grep -q -- '- Status: done' "$todo" || { echo "FAIL lifecycle Todo not done"; exit 1; }
# The next action `promote` wrote is only true before completion; an archived
# entry that still carries it claims outstanding work next to `Status: done`.
grep -q -- '- Next action: None — completed and archived\.' "$todo" || { echo "FAIL lifecycle Todo next action not cleared"; exit 1; }
# The entry already had the field, so it must have been replaced in place rather
# than joined by a second one.
[ "$(grep -c '^- Next action:' "$todo")" -eq 1 ] || { echo "FAIL lifecycle archive added a second next action:"; grep -n '^- Next action:' "$todo"; exit 1; }
grep -q -- '- Next action: Complete PRD' "$todo" && { echo "FAIL lifecycle archive kept the pre-completion next action"; exit 1; }
echo ok

echo "== approval gates block progress and completion =="
# `state in_progress` had this check from the start; `progress` and `complete`
# did not, so a task that was never approved could be marked done and archived.
gate="$tmp/gate"
mkdir -p "$gate"
bash "$HERE/task" intake "Gate smoke goal." "local fixture" --root "$gate" >/dev/null
gate_id=$(awk '/^- ID: TF-/{print $3; exit}' "$gate/TaskFlowDocs/todo.md")
bash "$HERE/task" promote "$gate_id" 2026-09-09-gate-smoke small --root "$gate" >/dev/null
gate_task="$gate/TaskFlowDocs/2026-09-09-gate-smoke"
gate_before=$(digest "$gate_task/plan.md")
if bash "$HERE/task" progress 2026-09-09-gate-smoke 1 done --root "$gate" >/dev/null 2>&1; then
  echo "FAIL progress accepted an unapproved task"; exit 1
fi
[ "$gate_before" = "$(digest "$gate_task/plan.md")" ] || { echo "FAIL rejected progress mutated the Plan"; exit 1; }
if bash "$HERE/task" complete 2026-09-09-gate-smoke --user-accepted --root "$gate" >/dev/null 2>&1; then
  echo "FAIL complete accepted an unapproved task"; exit 1
fi
[ -d "$gate_task" ] || { echo "FAIL rejected completion moved the task"; exit 1; }
grep -q '^> Status: planning$' "$gate_task/plan.md" || { echo "FAIL rejected completion changed the Plan status"; exit 1; }
# The template ships `pending` in every Approval field, so a version match alone
# still admits an approval copied from the previous version. The approver is what
# separates a real approval from the template.
sed 's/^- Status: requested$/- Status: approved/; s/^- Approved version: pending$/- Approved version: v1/' "$gate_task/plan.md" > "$gate_task/plan.md.tmp"
mv "$gate_task/plan.md.tmp" "$gate_task/plan.md"
if bash "$HERE/task" progress 2026-09-09-gate-smoke 1 done --root "$gate" >/dev/null 2>&1; then
  echo "FAIL progress accepted an approval with no approver"; exit 1
fi
sed 's/^- Approved by: pending$/- Approved by: user/' "$gate_task/plan.md" > "$gate_task/plan.md.tmp"
mv "$gate_task/plan.md.tmp" "$gate_task/plan.md"
sed 's/- \[ \]/- [x]/g' "$gate_task/plan.md" > "$gate_task/plan.md.tmp"
mv "$gate_task/plan.md.tmp" "$gate_task/plan.md"
bash "$HERE/task" progress 2026-09-09-gate-smoke 1 done --root "$gate" >/dev/null
# A version bump without re-approval: the Approval still names the version it
# superseded, which is exactly the state `hooks/version` leaves behind.
sed 's/^> Task version: v1$/> Task version: v2/' "$gate_task/plan.md" > "$gate_task/plan.md.tmp"
mv "$gate_task/plan.md.tmp" "$gate_task/plan.md"
if bash "$HERE/task" progress 2026-09-09-gate-smoke 1 in_progress --root "$gate" >/dev/null 2>&1; then
  echo "FAIL progress accepted a version bump without re-approval"; exit 1
fi
if bash "$HERE/task" complete 2026-09-09-gate-smoke --user-accepted --root "$gate" >/dev/null 2>&1; then
  echo "FAIL complete accepted a version bump without re-approval"; exit 1
fi
echo ok

echo "== task approve records the five-field block =="
ap="$tmp/approve"
mkdir -p "$ap"
bash "$HERE/task" intake "Approve smoke goal." "local fixture" --root "$ap" >/dev/null
ap_id=$(awk '/^- ID: TF-/{print $3; exit}' "$ap/TaskFlowDocs/todo.md")
bash "$HERE/task" promote "$ap_id" 2026-09-09-approve-smoke small --root "$ap" >/dev/null
ap_task="$ap/TaskFlowDocs/2026-09-09-approve-smoke"
# Missing Approval section: refuse, leave bytes alone.
ap_bad="$ap/TaskFlowDocs/2026-09-09-approve-bad"
mkdir -p "$ap_bad"
printf '# Plan — Bad\n> Task version: v1\n> Status: planning\n' > "$ap_bad/plan.md"
printf '# PRD\n> Task version: v1\n> Status: planning\n' > "$ap_bad/prd.md"
ap_bad_before=$(digest "$ap_bad/plan.md")
if bash "$HERE/task" approve 2026-09-09-approve-bad --root "$ap" >/dev/null 2>&1; then
  echo "FAIL approve accepted a plan with no Approval section"; exit 1
fi
[ "$ap_bad_before" = "$(digest "$ap_bad/plan.md")" ] || { echo "FAIL rejected approve mutated the Plan"; exit 1; }
# Stage gate: empty Skills blocks approve and leaves Approval pending.
ap_empty_before=$(digest "$ap_task/plan.md")
if bash "$HERE/task" approve 2026-09-09-approve-smoke --root "$ap" >/dev/null 2>&1; then
  echo "FAIL approve accepted an empty Skills / Tools Used"; exit 1
fi
[ "$ap_empty_before" = "$(digest "$ap_task/plan.md")" ] || { echo "FAIL empty-skills reject mutated the Plan"; exit 1; }
grep -q '^- Status: requested$' "$ap_task/plan.md" || { echo "FAIL empty-skills reject wrote Approval"; exit 1; }
# Replace the Skills body (do not append — leftover stage lines from a prior
# mutation would still be validated).
set_skills_body() {  # set_skills_body <plan> <stage-lines...>
  local plan="$1"; shift
  local lines=""
  while [ "$#" -gt 0 ]; do lines="$lines$1
"; shift; done
  awk -v body="$lines" '
    BEGIN { done = 0 }
    /^## Skills \/ Tools Used$/ { print; printf "%s", body; done = 1; next }
    done && /^## / { done = 0 }
    done { next }
    { print }
  ' "$plan" > "$plan.tmp" && mv "$plan.tmp" "$plan"
}
# Untagged invoke alone does not satisfy [PRD] (v2 stage rule).
set_skills_body "$ap_task/plan.md" \
  '- `some:requirements-skill` — purpose: frame requirements; outcome: succeeded; incorporated: PRD outline.'
if bash "$HERE/task" approve 2026-09-09-approve-smoke --root "$ap" >/dev/null 2>"$ap/untagged.err"; then
  echo "FAIL approve accepted untagged invoke without stage tags"; exit 1
fi
grep -q 'missing stage \[PRD\]' "$ap/untagged.err" \
  || { echo "FAIL untagged should miss stage"; cat "$ap/untagged.err"; exit 1; }
# Small: [PRD]+[Plan] placeholder invokes pass (shape only, no product allowlist).
set_skills_body "$ap_task/plan.md" \
  '- [PRD] `some:requirements-skill` — purpose: frame requirements; outcome: succeeded; incorporated: PRD outline.' \
  '- [Plan] `other:breakdown-tool` — purpose: split steps; outcome: succeeded; incorporated: plan steps.'
bash "$HERE/task" approve 2026-09-09-approve-smoke --root "$ap" >/dev/null
approval_fields="$(awk '
  /^## Approval$/ { p = 1; next }
  p && /^## / { exit }
  p && /^- Status:/ { print; next }
  p && /^- Approved by:/ { print; next }
  p && /^- Approved at:/ { print; next }
  p && /^- Approved version:/ { print; next }
  p && /^- Approved scope:/ { print; next }
' "$ap_task/plan.md")"
# Approved at is host-local date+time+zone; match prefix, not the clock.
printf '%s\n' "$approval_fields" | sed -n '1p' | grep -qx -- '- Status: approved' \
  || { echo "FAIL approve Status"; printf '%s\n' "$approval_fields"; exit 1; }
printf '%s\n' "$approval_fields" | sed -n '2p' | grep -qx -- '- Approved by: user' \
  || { echo "FAIL approve by default"; printf '%s\n' "$approval_fields"; exit 1; }
printf '%s\n' "$approval_fields" | sed -n '3p' | grep -q -- '^- Approved at: [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] ' \
  || { echo "FAIL approve at shape"; printf '%s\n' "$approval_fields"; exit 1; }
printf '%s\n' "$approval_fields" | sed -n '4p' | grep -qx -- '- Approved version: v1' \
  || { echo "FAIL approve version"; printf '%s\n' "$approval_fields"; exit 1; }
printf '%s\n' "$approval_fields" | sed -n '5p' | grep -qx -- '- Approved scope: PRD / Plan' \
  || { echo "FAIL approve scope small"; printf '%s\n' "$approval_fields"; exit 1; }
# Gate accepts the transcribed approval.
bash "$HERE/task" state 2026-09-09-approve-smoke in_progress --root "$ap" >/dev/null \
  || { echo "FAIL approve did not satisfy require_approval"; exit 1; }
# Large: custom approver; missing [Spec] must fail; then three stages pass.
bash "$HERE/task" intake "Approve smoke large goal." "local fixture" --root "$ap" >/dev/null
# Bare `# Todo` fixtures have no `## Items`, so intake appends: the new entry is last.
ap_id2=$(awk '/^- ID: TF-/{id=$3} END{print id}' "$ap/TaskFlowDocs/todo.md")
bash "$HERE/task" promote "$ap_id2" 2026-09-09-approve-large small --root "$ap" >/dev/null
ap_large="$ap/TaskFlowDocs/2026-09-09-approve-large"
printf '# Spec\n> Task version: v1\n> Status: planning\n' > "$ap_large/spec.md"
# PRD+Plan only → missing Spec stage.
set_skills_body "$ap_large/plan.md" \
  '- [PRD] Unaided — no capability applied to this phase; considered: requirements elicitation' \
  '- [Plan] Unaided — no capability applied to this phase; considered: work breakdown'
if bash "$HERE/task" approve 2026-09-09-approve-large alice --root "$ap" >/dev/null 2>"$ap/large.err"; then
  echo "FAIL large approve accepted missing [Spec] stage"; exit 1
fi
grep -q 'missing stage \[Spec\]' "$ap/large.err" || { echo "FAIL missing Spec message"; cat "$ap/large.err"; exit 1; }
grep -q '^- Status: requested$' "$ap_large/plan.md" || { echo "FAIL missing Spec reject wrote Approval"; exit 1; }
# Stage Unaided without considered → fail naming stage.
set_skills_body "$ap_large/plan.md" \
  '- [PRD] Unaided — no capability applied to this phase.' \
  '- [Spec] Unaided — no capability applied to this phase; considered: architecture and design' \
  '- [Plan] Unaided — no capability applied to this phase; considered: work breakdown'
if bash "$HERE/task" approve 2026-09-09-approve-large alice --root "$ap" >/dev/null 2>"$ap/large.err"; then
  echo "FAIL large approve accepted stage Unaided without considered:"; exit 1
fi
grep -q 'stage \[PRD\] Unaided needs considered:' "$ap/large.err" \
  || { echo "FAIL stage considered message"; cat "$ap/large.err"; exit 1; }
# Three stage Unaided lines with concept classes → pass (still no product names).
set_skills_body "$ap_large/plan.md" \
  '- [PRD] Unaided — no capability applied to this phase; considered: requirements elicitation' \
  '- [Spec] Unaided — no capability applied to this phase; considered: architecture and design' \
  '- [Plan] Unaided — no capability applied to this phase; considered: work breakdown'
bash "$HERE/task" approve 2026-09-09-approve-large alice --root "$ap" >/dev/null
approval_fields="$(awk '
  /^## Approval$/ { p = 1; next }
  p && /^## / { exit }
  p && /^- Approved by:/ { print; next }
  p && /^- Approved scope:/ { print; next }
' "$ap_large/plan.md")"
printf '%s\n' "$approval_fields" | grep -qx -- '- Approved by: alice' \
  || { echo "FAIL custom approver"; printf '%s\n' "$approval_fields"; exit 1; }
printf '%s\n' "$approval_fields" | grep -qx -- '- Approved scope: PRD / Spec / Plan' \
  || { echo "FAIL approve scope with spec"; printf '%s\n' "$approval_fields"; exit 1; }
# approve must not rewrite > Status: on the docs
grep -q '^> Status: in_progress$' "$ap_task/plan.md" || { echo "FAIL approve changed plan doc status"; exit 1; }
# Neutral stage gate wording is pinned.
grep -q 'missing stage \[' "$HERE/task" || { echo "FAIL stage gate message missing"; exit 1; }
grep -q 'phase-table concept class' "$HERE/task" || { echo "FAIL phase-table concept gate missing"; exit 1; }
grep -q 'require_stage PRD' "$HERE/task" || { echo "FAIL PRD stage required"; exit 1; }
echo ok

echo "== a task is isolated before its first document is written =="
# A task's first documents are written in Phase 1, so a promotion from the base
# working tree would put them on whatever branch happens to be checked out — and
# the next `git checkout` then refuses to move. The gate answers that at the only
# moment it can be answered cheaply. A plain `git init` fixture is the base tree;
# a `git worktree add` of it is the task tree; a directory outside Git is the
# case that must keep working, because `--root` is allowed to point anywhere.
iso="$tmp/isolation"
mkdir -p "$iso/TaskFlowDocs"
(
  cd "$iso" || exit 1
  git init -q .
  git config user.email smoke@example.invalid
  git config user.name smoke
  printf '# Todo inbox\n\n## Items\n\n## Seed\n\n- ID: TF-20260101-aa\n- Status: clarified\n- Priority: normal\n- Owner: smoke\n- Source: fixture\n- Added: 2026-01-01\n- Updated: 2026-01-01\n- Goal: seed\n- Task: Not promoted.\n- Next action: none\n' > TaskFlowDocs/todo.md
  printf 'fixture\n' > README.md
  git add -A && git commit -qm base
) || { echo "FAIL isolation fixture repository"; exit 1; }
iso_todo_digest=$(digest "$iso/TaskFlowDocs/todo.md")
# The command output cannot be captured inside the fixture repository: an
# untracked file there would make the "nothing was written" assertion fail for
# the wrong reason.
iso_out="$tmp/isolation-out"

set +e
bash "$HERE/task" promote TF-20260101-aa promoted-in-base small --root "$iso" > "$iso_out" 2>&1
iso_status=$?
set -e
[ "$iso_status" -eq 3 ] || { echo "FAIL promote in the base working tree exit code: $iso_status"; cat "$iso_out"; exit 1; }
grep -q 'STATUS: blocked' "$iso_out" || { echo "FAIL base-tree promote not blocked"; cat "$iso_out"; exit 1; }
grep -q 'not a task worktree' "$iso_out" || { echo "FAIL base-tree promote did not name the reason"; cat "$iso_out"; exit 1; }
# Everything the script can know is filled in, so the reader only picks <type>.
grep -q 'git worktree add \.worktrees/promoted-in-base -b <type>/promoted-in-base ' "$iso_out" \
  || { echo "FAIL base-tree promote did not print a runnable command with <task-id> and <base> filled in"; cat "$iso_out"; exit 1; }
grep -q '<type>' "$iso_out" || { echo "FAIL base-tree promote silently chose a branch prefix"; cat "$iso_out"; exit 1; }
grep -q 'feature | fix | docs | chore' "$iso_out" || { echo "FAIL base-tree promote did not list the legal prefixes"; cat "$iso_out"; exit 1; }
# Refused means nothing was written, not just nothing was committed.
[ ! -e "$iso/TaskFlowDocs/promoted-in-base" ] || { echo "FAIL blocked promote still created the task directory"; exit 1; }
[ "$iso_todo_digest" = "$(digest "$iso/TaskFlowDocs/todo.md")" ] || { echo "FAIL blocked promote still mutated Todo"; exit 1; }
[ -z "$(git -C "$iso" status --porcelain)" ] || { echo "FAIL blocked promote dirtied the working tree"; exit 1; }

# The same promotion from that repository's own linked worktree goes through.
(
  cd "$iso" || exit 1
  git worktree add -q .worktrees/task-tree -b chore/task-tree
) || { echo "FAIL isolation fixture worktree"; exit 1; }
bash "$HERE/task" promote TF-20260101-aa promoted-in-worktree small --root "$iso/.worktrees/task-tree" > "$iso_out" 2>&1 \
  || { echo "FAIL promote in a task worktree was refused:"; cat "$iso_out"; exit 1; }
[ -f "$iso/.worktrees/task-tree/TaskFlowDocs/promoted-in-worktree/plan.md" ] \
  || { echo "FAIL task worktree promotion did not write the task"; exit 1; }
grep -q 'not a task worktree' "$iso_out" && { echo "FAIL task worktree promotion printed the base-tree refusal"; cat "$iso_out"; exit 1; }

# Outside Git the gate does not apply: `--root` is allowed to be any directory,
# and refusing there would break callers who never had this problem.
iso_bare="$(mktemp -d "${TMPDIR:-/tmp}/taskflow-isolation-bare.XXXXXX")"
mkdir -p "$iso_bare/TaskFlowDocs"
cp "$iso/TaskFlowDocs/todo.md" "$iso_bare/TaskFlowDocs/todo.md"
bash "$HERE/task" promote TF-20260101-aa promoted-outside-git small --root "$iso_bare" > "$iso_out" 2>&1 \
  || { echo "FAIL promote outside a repository was refused:"; cat "$iso_out"; exit 1; }
[ -f "$iso_bare/TaskFlowDocs/promoted-outside-git/plan.md" ] \
  || { echo "FAIL promote outside a repository did not write the task"; exit 1; }
rm -rf "$iso_bare"

# `intake` is the other writer, and the one that actually dirties `todo.md`.
# It reports instead of refusing: triage should stay cheap.
bash "$HERE/task" intake "Isolation smoke goal." --root "$iso" > "$iso_out" 2>&1 \
  || { echo "FAIL intake in the base working tree was refused"; cat "$iso_out"; exit 1; }
grep -q 'intake OK:' "$iso_out" || { echo "FAIL base-tree intake did not report success"; cat "$iso_out"; exit 1; }
grep -q 'modified in the base working tree' "$iso_out" \
  || { echo "FAIL base-tree intake did not warn that Todo is now uncommitted"; cat "$iso_out"; exit 1; }
bash "$HERE/task" intake "Isolation smoke goal two." --root "$iso/.worktrees/task-tree" > "$iso_out" 2>&1 \
  || { echo "FAIL intake in a task worktree was refused"; cat "$iso_out"; exit 1; }
grep -q 'modified in the base working tree' "$iso_out" \
  && { echo "FAIL task worktree intake warned about the base working tree"; cat "$iso_out"; exit 1; }
iso_bare="$(mktemp -d "${TMPDIR:-/tmp}/taskflow-intake-bare.XXXXXX")"
mkdir -p "$iso_bare/TaskFlowDocs"
printf '# Todo inbox\n' > "$iso_bare/TaskFlowDocs/todo.md"
bash "$HERE/task" intake "Isolation smoke goal three." --root "$iso_bare" > "$iso_out" 2>&1 \
  || { echo "FAIL intake outside a repository was refused"; cat "$iso_out"; exit 1; }
grep -q 'modified in the base working tree' "$iso_out" \
  && { echo "FAIL intake outside a repository warned about a base working tree"; cat "$iso_out"; exit 1; }
rm -rf "$iso_bare"

# Git for Windows answers both `--git-dir` and `--absolute-git-dir` with a drive
# path (`D:/repo/.git/worktrees/x`), which is absolute there but starts with no
# `/`, so a caller that reads it as "relative" and prefixes `$root` gets a path
# that exists nowhere and calls every worktree a base tree. `D:/` is a relative
# path on Linux — a directory literally named `D:` — which is what makes a
# Windows-shaped answer injourable here.
iso_win="$tmp/isolation/drive-relative"
iso_gitbin="$tmp/isolation-gitbin"
iso_real_git="$(type -P git)"
mkdir -p "$iso_gitbin" "$iso_win/D:/repo/.git/worktrees/win" "$iso_win/TaskFlowDocs"
printf 'D:/repo/.git\n' > "$iso_win/D:/repo/.git/worktrees/win/commondir"
cp "$iso/TaskFlowDocs/todo.md" "$iso_win/TaskFlowDocs/todo.md"
cat > "$iso_gitbin/git" <<EOF
#!/usr/bin/env bash
case "\$*" in
  *--absolute-git-dir*) echo "D:/repo/.git/worktrees/win" ;;
  *--git-dir*)          echo "D:/repo/.git/worktrees/win" ;;
  *--show-toplevel*)    echo "D:/repo" ;;
  *)                    exec "$iso_real_git" "\$@" ;;
esac
EOF
chmod +x "$iso_gitbin/git"
(
  cd "$iso_win" || exit 1
  PATH="$iso_gitbin:$PATH" bash "$HERE/task" intake "Isolation smoke goal four." --root "$iso_win" > "$iso_out" 2>&1
) || { echo "FAIL intake under a drive-path git dir was refused"; cat "$iso_out"; exit 1; }
grep -q 'modified in the base working tree' "$iso_out" \
  && { echo "FAIL a drive-path absolute git dir was read as relative to the root"; cat "$iso_out"; exit 1; }
echo ok

echo "== TaskFlow packaged Skill contract =="
repo=$(cd "$HERE/.." && pwd)
skill="$repo/skills/taskflow"
[ -f "$skill/SKILL.md" ] && [ -f "$skill/agents/openai.yaml" ] || { echo "FAIL incomplete packaged Skill"; exit 1; }
[ ! -e "$repo/SKILL.md" ] && [ ! -e "$repo/agents" ] && [ ! -e "$repo/references" ] || { echo "FAIL duplicate root Skill"; exit 1; }
grep -q 'selection alone is not invocation' "$skill/SKILL.md" || { echo "FAIL selection/invocation boundary"; exit 1; }
grep -q 'does not require the selection or use of any particular capability' "$skill/SKILL.md" || { echo "FAIL autonomous choice boundary"; exit 1; }
grep -q 'Apply TaskFlow automatically only when the request asks to modify a repository or deliver a development artifact' "$skill/SKILL.md" || { echo "FAIL development applicability boundary"; exit 1; }
grep -q 'Do not create or update Todo/task documents for read-only explanation' "$skill/SKILL.md" || { echo "FAIL read-only exclusion"; exit 1; }
grep -q 'explicit user request to use `\$taskflow` opts any planning or research work' "$skill/SKILL.md" || { echo "FAIL explicit invocation override"; exit 1; }
grep -q 'never assume `origin` is the fork or `upstream` exists' "$skill/SKILL.md" || { echo "FAIL fork remote boundary"; exit 1; }
grep -q 'For missing `CONTRIBUTING.md` or `CODE_STYLE.md`' "$skill/SKILL.md" || { echo "FAIL baseline governance drafting"; exit 1; }
grep -q 'Create `ROADMAP.md` only after the user confirms product direction' "$skill/SKILL.md" || { echo "FAIL roadmap direction gate"; exit 1; }
grep -q 'never committed' "$skill/SKILL.md" && grep -q 'never committed' "$skill/references/artifacts.md" || { echo "FAIL personal supplement git boundary"; exit 1; }
echo ok

echo "== artifact language rule is documented without contradicting the parsers =="
# The rule splits one document into prose and machine-read structure. If it ever
# names a structural line as translatable, the hooks stop finding it, so pin both
# the rule and the English shape the parsers rely on.
grep -q '^## Artifact language$' "$skill/references/artifacts.md" || { echo "FAIL artifact language rule missing"; exit 1; }
grep -q "the lines they match stay English verbatim" "$skill/references/artifacts.md" || { echo "FAIL artifact language boundary missing"; exit 1; }
grep -q 'in the user.s working language' "$skill/SKILL.md" || { echo "FAIL SKILL language rule missing"; exit 1; }
grep -q 'user.s working language' "$repo/CODE_STYLE.md" || { echo "FAIL code style language rule missing"; exit 1; }
grep -q 'are not rewritten for language' "$skill/references/artifacts.md" || { echo "FAIL no-rewrite rule missing"; exit 1; }
for token in '^## Approval$' '^- Status:' '> Task version:' '### Step '; do
  grep -q -- "$token" "$skill/references/artifacts.md" || { echo "FAIL language rule does not pin: $token"; exit 1; }
done
echo ok

echo "== a release runs RELEASE.md instead of the task workflow =="
# A release that also takes the task path re-plans an existing procedure and
# copies RELEASE.md's checklist into a second document that then drifts from it.
# Pin that a release is out of the task workflow, and that the approval gate the
# task path would have recorded still exists inside the procedure.
grep -q '^## Release task documents$' "$skill/references/artifacts.md" || { echo "FAIL release rule missing"; exit 1; }
grep -q 'A release does not use task documents at all' "$skill/references/artifacts.md" || { echo "FAIL release rule does not exclude the task path"; exit 1; }
grep -q 'A release is the exception' "$skill/SKILL.md" || { echo "FAIL applicability gate does not exempt a release"; exit 1; }
grep -q 'the release owner approves the release commit before' "$skill/references/artifacts.md" || { echo "FAIL release rule dropped the approval gate"; exit 1; }
grep -q '^\*\*A release is the exception\.\*\*' "$repo/CONTRIBUTING.md" || { echo "FAIL contributing does not exempt a release"; exit 1; }
grep -q 'does not create a TaskFlow task or a `todo.md` item' "$repo/RELEASE.md" || { echo "FAIL RELEASE.md does not exclude the task path"; exit 1; }
echo ok

echo "== phases map to concept classes without naming a capability =="
grep -q '^| 1\. Define — PRD | `prd.md` | requirements elicitation' "$skill/SKILL.md" || { echo "FAIL define phase concept row"; exit 1; }
grep -q '^| 4\. Plan — execution contract | `plan.md` | work breakdown' "$skill/SKILL.md" || { echo "FAIL plan phase concept row"; exit 1; }
grep -q '^| 6\. Verify and review | acceptance and findings | testing strategy' "$skill/SKILL.md" || { echo "FAIL verify phase concept row"; exit 1; }
for heading in "1. Define — PRD" "2. Research — Reference" "3. Design — Spec decision" \
               "4. Plan — execution contract" "5. Build — implement by Plan" \
               "6. Verify and review" "7. Complete and archive"; do
  grep -q "^| $heading |" "$skill/SKILL.md" || { echo "FAIL concept table is missing: $heading"; exit 1; }
done
concept_table=$(sed -n '/^| Phase | Artifact | Equivalent concept class/,/^$/p' "$skill/SKILL.md")
[ -n "$concept_table" ] || { echo "FAIL concept table missing"; exit 1; }
if printf '%s' "$concept_table" | grep -qiE 'taskflow|claude|codex|agent-skills|openai|anthropic|mcp'; then
  echo "FAIL concept table names a product instead of a concept"; exit 1
fi
grep -q 'must be a choice, not an oversight' "$skill/SKILL.md" || { echo "FAIL unaided-phase signal missing"; exit 1; }
grep -q 'says what class to look for' "$skill/references/artifacts.md" || { echo "FAIL accounting rule pointer missing"; exit 1; }
echo ok

echo "== the capability record is required, not optional =="
# A section marked optional is the section that comes back empty, and an empty
# section cannot be told apart from an overlooked one. Pin the heading, the
# unaided fill line, and that no template still advertises it as optional.
grep -q '^## Skills / Tools Used$' "$skill/references/artifacts.md" || { echo "FAIL artifacts.md Plan outline heading is not the required one"; exit 1; }
grep -q '^## Skills / Tools Used$' "$HERE/task" || { echo "FAIL promote scaffold heading is not the required one"; exit 1; }
if grep -q 'Skills / Tools Used (Optional)' "$skill/references/artifacts.md" "$HERE/task"; then
  echo "FAIL a template still marks the capability record optional"; exit 1
fi
grep -q 'Unaided — no capability applied to this phase; considered:' "$skill/references/artifacts.md" \
  || { echo "FAIL the unaided fill pattern is not documented"; exit 1; }
# The exact wording lives in one place; SKILL.md names the shape and points at it,
# the way the release-document rule points at RELEASE.md instead of restating it.
grep -q '`Unaided — …` line' "$skill/SKILL.md" \
  || { echo "FAIL SKILL.md does not name the unaided shape"; exit 1; }
[ "$(grep -c 'Unaided — no capability applied to this phase' "$skill/SKILL.md")" -eq 0 ] \
  || { echo "FAIL SKILL.md duplicates the fill pattern instead of pointing at artifacts.md"; exit 1; }
grep -q 'is required, not optional' "$skill/references/artifacts.md" \
  || { echo "FAIL artifacts.md does not state the section is required"; exit 1; }
echo ok

echo "== repository-check is read-only and reports actionable status =="
check_root="$tmp/repository-check"
mkdir -p "$check_root/.git" "$check_root/TaskFlowDocs/repository-docs"
git -C "$check_root" init -q
printf '# Catalog\n' > "$check_root/TaskFlowDocs/repository-docs/index.md"
set +e
check_out=$(bash "$HERE/repository-check" "$check_root" 2>&1)
check_status=$?
set -e
echo "$check_out" | grep -q 'STATUS: needs-user-input' || { echo "FAIL repository-check status"; exit 1; }
[ "$check_status" -eq 2 ] || { echo "FAIL repository-check exit code"; exit 1; }
echo "$check_out" | grep -q 'Document CONTRIBUTING.md: missing' || { echo "FAIL repository-check governance finding"; exit 1; }
echo "$check_out" | grep -q 'Base: ambiguous' || { echo "FAIL repository-check base finding"; exit 1; }
echo ok

echo "== repository-check names uncommitted task artifacts without changing its verdict =="
# The gate stops a promotion from starting in the wrong tree; this report covers
# what the gate cannot see — artifacts already written, then left uncommitted.
# Everything else in the fixture is complete and tracked, including an upstream,
# so the exit code is `pass` and any change in it is the report's doing.
art_root="$tmp/repository-check-artifacts"
mkdir -p "$art_root/TaskFlowDocs/repository-docs"
git -C "$art_root" init -q
git -C "$art_root" config user.email smoke@example.invalid
git -C "$art_root" config user.name smoke
printf '# Catalog\n' > "$art_root/TaskFlowDocs/repository-docs/index.md"
printf 'CONTRIBUTING\n' > "$art_root/CONTRIBUTING.md"
printf 'CODE_STYLE\n' > "$art_root/CODE_STYLE.md"
git -C "$art_root" add -A && git -C "$art_root" commit -qm base
git -C "$art_root" remote add origin "$art_root"
git -C "$art_root" update-ref refs/remotes/origin/main HEAD
git -C "$art_root" branch -q -u origin/main
set +e
art_out=$(bash "$HERE/repository-check" "$art_root" 2>&1)
art_clean_status=$?
set -e
[ "$art_clean_status" -eq 0 ] || { echo "FAIL repository-check clean fixture is not pass: $art_clean_status"; cat "$art_out"; exit 1; }
echo "$art_out" | grep -q 'Task artifacts: none uncommitted' \
  || { echo "FAIL clean fixture reported task artifacts"; cat "$art_out"; exit 1; }

mkdir -p "$art_root/TaskFlowDocs/2026-09-01-misplaced"
printf '# PRD\n' > "$art_root/TaskFlowDocs/2026-09-01-misplaced/prd.md"
# Referenced by Todo so this section stays about uncommitted state only;
# orphan detection is exercised in its own section below.
printf '# Todo\n## Fixture\n- ID: T-20260901-01\n- Task: `TaskFlowDocs/2026-09-01-misplaced/`\n' \
  > "$art_root/TaskFlowDocs/todo.md"
set +e
art_out=$(bash "$HERE/repository-check" "$art_root" 2>&1)
art_status=$?
set -e
[ "$art_status" -eq "$art_clean_status" ] \
  || { echo "FAIL the task-artifact report changed the exit code: $art_status"; cat "$art_out"; exit 1; }
echo "$art_out" | grep -q 'STATUS: pass' || { echo "FAIL the task-artifact report changed the status"; cat "$art_out"; exit 1; }
echo "$art_out" | grep -q -- '- TaskFlowDocs/2026-09-01-misplaced/ (untracked)' \
  || { echo "FAIL misplaced task artifact not named"; cat "$art_out"; exit 1; }
echo "$art_out" | grep -q 'Orphan task directories: none' \
  || { echo "FAIL referenced artifact reported as orphan"; cat "$art_out"; exit 1; }
# A directory with no commit cannot be attributed to a branch, and the output must
# say what it can and cannot claim instead of letting the reader assume.
echo "$art_out" | grep -q 'follows you to whatever branch you check out' \
  || { echo "FAIL misplaced report omits the attribution boundary"; cat "$art_out"; exit 1; }

# Staged-but-uncommitted is still uncommitted, and is reported as its own case.
git -C "$art_root" add TaskFlowDocs/2026-09-01-misplaced
set +e
art_out=$(bash "$HERE/repository-check" "$art_root" 2>&1)
art_status=$?
set -e
[ "$art_status" -eq "$art_clean_status" ] || { echo "FAIL staged artifact changed the exit code"; cat "$art_out"; exit 1; }
echo "$art_out" | grep -q -- '- TaskFlowDocs/2026-09-01-misplaced/ (staged, not committed)' \
  || { echo "FAIL staged task artifact not reported as staged"; cat "$art_out"; exit 1; }

# Committing it is what puts it in this branch's history, so it stops being
# reported — the report tracks the checkout state, not the directory name.
git -C "$art_root" commit -qm task
set +e
art_out=$(bash "$HERE/repository-check" "$art_root" 2>&1)
set -e
echo "$art_out" | grep -q 'Task artifacts: none uncommitted' \
  || { echo "FAIL committed task artifact still reported"; cat "$art_out"; exit 1; }
echo "$art_out" | grep -q '2026-09-01-misplaced' \
  && { echo "FAIL committed task artifact named in the report"; cat "$art_out"; exit 1; }
echo ok

echo "== repository-check reports orphan task directories =="
orphan_root="$tmp/repository-check-orphans"
mkdir -p "$orphan_root/TaskFlowDocs/repository-docs"
git -C "$orphan_root" init -q
git -C "$orphan_root" config user.email smoke@example.invalid
git -C "$orphan_root" config user.name smoke
printf '# Catalog\n' > "$orphan_root/TaskFlowDocs/repository-docs/index.md"
printf 'CONTRIBUTING\n' > "$orphan_root/CONTRIBUTING.md"
printf 'CODE_STYLE\n' > "$orphan_root/CODE_STYLE.md"
printf '# Todo\n' > "$orphan_root/TaskFlowDocs/todo.md"
git -C "$orphan_root" add -A && git -C "$orphan_root" commit -qm base
git -C "$orphan_root" remote add origin "$orphan_root"
git -C "$orphan_root" update-ref refs/remotes/origin/main HEAD
git -C "$orphan_root" branch -q -u origin/main
# Unreferenced active dir → listed, exit 2
mkdir -p "$orphan_root/TaskFlowDocs/2026-01-01-lost"
printf '# PRD\n> Task version: v1\n' > "$orphan_root/TaskFlowDocs/2026-01-01-lost/prd.md"
printf '# Plan\n> Task version: v1\n' > "$orphan_root/TaskFlowDocs/2026-01-01-lost/plan.md"
set +e
orphan_out=$(bash "$HERE/repository-check" "$orphan_root" 2>&1)
orphan_status=$?
set -e
[ "$orphan_status" -eq 2 ] || { echo "FAIL orphan did not set needs: $orphan_status"; printf '%s\n' "$orphan_out"; exit 1; }
echo "$orphan_out" | grep -q 'STATUS: needs-user-input' || { echo "FAIL orphan status"; printf '%s\n' "$orphan_out"; exit 1; }
# Orphan lines have no trailing slash; the uncommitted-artifact line does.
echo "$orphan_out" | grep -q -- '^- TaskFlowDocs/2026-01-01-lost$' \
  || { echo "FAIL active orphan not named"; printf '%s\n' "$orphan_out"; exit 1; }
# Achieved orphan is listed too
mkdir -p "$orphan_root/TaskFlowDocs/achieved/2026-01-01-gone"
printf '# PRD\n> Task version: v1\n' > "$orphan_root/TaskFlowDocs/achieved/2026-01-01-gone/prd.md"
set +e
orphan_out=$(bash "$HERE/repository-check" "$orphan_root" 2>&1)
set -e
echo "$orphan_out" | grep -q -- '^- TaskFlowDocs/achieved/2026-01-01-gone$' \
  || { echo "FAIL achieved orphan not named"; printf '%s\n' "$orphan_out"; exit 1; }
# Referencing the active path clears it from the orphan list
printf '# Todo\n## Fixture\n- ID: T-20260101-01\n- Task: `TaskFlowDocs/2026-01-01-lost/`\n' \
  > "$orphan_root/TaskFlowDocs/todo.md"
set +e
orphan_out=$(bash "$HERE/repository-check" "$orphan_root" 2>&1)
orphan_status=$?
set -e
echo "$orphan_out" | grep -q -- '^- TaskFlowDocs/2026-01-01-lost$' \
  && { echo "FAIL referenced active dir still orphan"; printf '%s\n' "$orphan_out"; exit 1; }
echo "$orphan_out" | grep -q -- '^- TaskFlowDocs/achieved/2026-01-01-gone$' \
  || { echo "FAIL achieved orphan dropped early"; printf '%s\n' "$orphan_out"; exit 1; }
[ "$orphan_status" -eq 2 ] || { echo "FAIL remaining achieved orphan should keep needs"; printf '%s\n' "$orphan_out"; exit 1; }
# Clear achieved too → pass
printf '# Todo\n## Fixture\n- ID: T-20260101-01\n- Task: `TaskFlowDocs/2026-01-01-lost/`\n- Task: `TaskFlowDocs/achieved/2026-01-01-gone/`\n' \
  > "$orphan_root/TaskFlowDocs/todo.md"
set +e
orphan_out=$(bash "$HERE/repository-check" "$orphan_root" 2>&1)
orphan_status=$?
set -e
[ "$orphan_status" -eq 0 ] || { echo "FAIL clean-orphan fixture not pass: $orphan_status"; printf '%s\n' "$orphan_out"; exit 1; }
echo "$orphan_out" | grep -q 'Orphan task directories: none' \
  || { echo "FAIL empty orphan set should report none"; printf '%s\n' "$orphan_out"; exit 1; }
echo ok

echo "== todo merge driver keeps both branches' entries =="
# A real repository, so the assertion exercises `git merge` rather than a
# simulation of it. The driver is installed the way a user gets it, by the hook.
md="$tmp/merge-driver"
mkdir -p "$md"
git -C "$md" init -q
git -C "$md" symbolic-ref HEAD refs/heads/main
git -C "$md" config user.email smoke@example.invalid
git -C "$md" config user.name smoke
TASKFLOW_REPO_ROOT="$md" bash "$HERE/install-merge-driver"
mkdir -p "$md/TaskFlowDocs"
todo_write() {  # todo_write <file> <entries...>  (preamble, then one block per arg)
  local f="$1"
  shift
  { printf '# Todo inbox\n\n## Items\n\n'
    for e in "$@"; do printf '%s\n\n' "$e"; done
  } > "$f"
}
entry() {  # entry <heading> <id> <status>
  printf '## %s\n- ID: %s\n- Status: %s\n' "$1" "$2" "$3"
}
todo_write "$md/TaskFlowDocs/todo.md" "$(entry Base TF-20260101-01 done)"
git -C "$md" add -A
git -C "$md" commit -qm base

# Both entries deliberately end in the same two lines. That shared tail is what
# `merge=union` mishandles: it interleaves the two insertions and keeps the tail
# once, silently dropping a field from one entry. This fixture is that case.
git -C "$md" checkout -qb ours
todo_write "$md/TaskFlowDocs/todo.md" \
  "$(entry 'Task ours' TF-20260915-01 inbox)" "$(entry Base TF-20260101-01 done)"
git -C "$md" commit -qam ours
git -C "$md" checkout -q main
git -C "$md" checkout -qb theirs
todo_write "$md/TaskFlowDocs/todo.md" \
  "$(entry 'Task theirs' TF-20260915-02 inbox)" "$(entry Base TF-20260101-01 done)"
git -C "$md" commit -qam theirs
git -C "$md" checkout -q ours
git -C "$md" merge -q --no-edit theirs
merged="$md/TaskFlowDocs/todo.md"
grep -q '^## Task ours$' "$merged" || { echo "FAIL driver dropped our entry"; exit 1; }
grep -q '^## Task theirs$' "$merged" || { echo "FAIL driver dropped their entry"; exit 1; }
[ "$(grep -cE '^## Base$' "$merged")" -eq 1 ] || { echo "FAIL driver duplicated the shared entry"; exit 1; }
[ "$(grep -c '^- ID: ' "$merged")" -eq 3 ] || { echo "FAIL driver lost or duplicated an ID field"; exit 1; }
[ "$(grep -c '^- Status: ' "$merged")" -eq 3 ] || { echo "FAIL driver lost or duplicated a Status field (the merge=union failure)"; exit 1; }
grep -q '^<<<<<<<' "$merged" && { echo "FAIL driver conflicted on disjoint entries"; exit 1; }
# Ours keeps its position; their new entry is appended after, so a merge never
# reorders what the user already sees.
[ "$(grep -n '^## ' "$merged" | head -2 | tail -1 | cut -d: -f2-)" = "## Task ours" ] || { echo "FAIL driver reordered our entries"; exit 1; }
echo ok

echo "== todo merge driver still conflicts on one entry changed twice =="
git -C "$md" checkout -q -B edit-ours ours
# Via a temp file: the merge driver writes into the same path, and a redirect onto
# the file being read truncates it first, which would make this branch the base.
awk '/^- Status: / { sub(/inbox/, "done") } { print }' "$merged" > "$md/.todo.next"
mv "$md/.todo.next" "$md/TaskFlowDocs/todo.md"
git -C "$md" commit -qam 'ours: mark done'
git -C "$md" checkout -q -B edit-theirs theirs
todo_write "$md/TaskFlowDocs/todo.md" \
  "$(entry 'Task theirs' TF-20260915-02 in_progress)" \
  "$(entry Base TF-20260101-01 done)" \
  "$(entry 'Task ours' TF-20260915-01 cancelled)"
git -C "$md" commit -qam 'theirs: cancel ours instead'
git -C "$md" checkout -q edit-ours
set +e
git -C "$md" merge -q --no-edit edit-theirs >/dev/null 2>&1
edit_status=$?
set -e
[ "$edit_status" -ne 0 ] || { echo "FAIL merge of one edited entry succeeded silently"; exit 1; }
grep -q '^<<<<<<< ours$' "$md/TaskFlowDocs/todo.md" || { echo "FAIL no conflict markers for a real conflict"; exit 1; }
grep -q '^>>>>>>> theirs$' "$md/TaskFlowDocs/todo.md" || { echo "FAIL conflict markers not closed"; exit 1; }
git -C "$md" merge --abort 2>/dev/null || true
echo ok

echo "== todo merge driver takes a one-sided edit without conflicting =="
# The ordinary TaskFlow case: one branch archives its task and marks the entry
# `done` while another branch added its own entry and never touched this one.
git -C "$md" checkout -q -B side-other ours
todo_write "$md/TaskFlowDocs/todo.md" \
  "$(entry 'Task ours' TF-20260915-01 inbox)" \
  "$(entry 'Task side' TF-20260915-03 inbox)" \
  "$(entry Base TF-20260101-01 done)"
git -C "$md" commit -qam 'other: add an unrelated entry'
git -C "$md" checkout -q -B side-edit ours
awk '/^- ID: TF-20260915-01$/ { found = 1 } found && /^- Status: / { sub(/inbox/, "done"); found = 0 } { print }' \
  "$md/TaskFlowDocs/todo.md" > "$md/.todo.next"
mv "$md/.todo.next" "$md/TaskFlowDocs/todo.md"
git -C "$md" commit -qam 'edit: mark our own entry done'
git -C "$md" checkout -q side-other
git -C "$md" merge -q --no-edit side-edit
merged="$md/TaskFlowDocs/todo.md"
grep -q '^## Task side$' "$merged" || { echo "FAIL one-sided merge dropped the added entry"; exit 1; }
grep -q '^<<<<<<<' "$merged" && { echo "FAIL one-sided edit conflicted"; exit 1; }
# The edit must survive, and it must be the Edit branch's value that won.
[ "$(awk '/^- ID: TF-20260915-01$/ { f = 1 } f && /^- Status: / { print $3; exit }' "$merged")" = "done" ] \
  || { echo "FAIL one-sided edit was discarded"; exit 1; }
# Four entries: ours, theirs (kept from the merge above), the one this branch
# added, and the shared base.
[ "$(grep -c '^- ID: ' "$merged")" -eq 4 ] || { echo "FAIL one-sided merge lost an entry"; exit 1; }
echo ok

echo "== todo merge driver treats ## Removed as a deletion, not a second entry =="
# The failure this locks: one branch runs task remove (live section gone,
# tombstone under ## Removed); the other leaves the live entry alone. The old
# driver keyed the whole Removed blob by the first tombstone's full ID suffix,
# never matched the live copy, and kept it as "only they have it".
rm_drv="$tmp/merge-removed"
mkdir -p "$rm_drv"
git -C "$rm_drv" init -q
git -C "$rm_drv" symbolic-ref HEAD refs/heads/main
git -C "$rm_drv" config user.email smoke@example.invalid
git -C "$rm_drv" config user.name smoke
TASKFLOW_REPO_ROOT="$rm_drv" bash "$HERE/install-merge-driver"
mkdir -p "$rm_drv/TaskFlowDocs"
todo_write "$rm_drv/TaskFlowDocs/todo.md" "$(entry Base TF-20260101-01 done)"
git -C "$rm_drv" add -A
git -C "$rm_drv" commit -qm base

# Ours: delete the live entry and record it (what task remove writes).
git -C "$rm_drv" checkout -qb del
{
  printf '# Todo inbox\n\n## Items\n\n'
  printf '%s\n\n' "$(entry Base TF-20260101-01 done)"
  printf '## Removed\n\n- ID: TF-20260101-02 (removed 2026-01-01: gone)\n'
} > "$rm_drv/TaskFlowDocs/todo.md"
git -C "$rm_drv" commit -qam 'ours: remove TF-02'

# Theirs: add the live entry only (never sees the remove).
git -C "$rm_drv" checkout -q main
git -C "$rm_drv" checkout -qb keep
todo_write "$rm_drv/TaskFlowDocs/todo.md" \
  "$(entry 'Still live' TF-20260101-02 inbox)" \
  "$(entry Base TF-20260101-01 done)"
git -C "$rm_drv" commit -qam 'theirs: still has live TF-02'

git -C "$rm_drv" checkout -q del
git -C "$rm_drv" merge -q --no-edit keep
merged="$rm_drv/TaskFlowDocs/todo.md"
grep -q 'TF-20260101-02 (removed 2026-01-01: gone)' "$merged" \
  || { echo "FAIL delete/keep merge dropped the tombstone"; cat "$merged"; exit 1; }
grep -q '^## Still live$' "$merged" \
  && { echo "FAIL delete/keep merge resurrected the live entry"; cat "$merged"; exit 1; }
[ "$(grep -c '^- ID: TF-20260101-02' "$merged")" -eq 1 ] \
  || { echo "FAIL TF-02 is not exactly one record after merge"; grep -n 'TF-20260101-02' "$merged"; exit 1; }
grep -q '^<<<<<<<' "$merged" && { echo "FAIL deletion merge conflicted"; exit 1; }

# Symmetric: theirs deleted TF-03, ours kept the live entry alone.
git -C "$rm_drv" checkout -q -B del3 main
{
  printf '# Todo inbox\n\n## Items\n\n'
  printf '%s\n\n' "$(entry Base TF-20260101-01 done)"
  printf '## Removed\n\n- ID: TF-20260101-03 (removed 2026-01-01: other)\n'
} > "$rm_drv/TaskFlowDocs/todo.md"
git -C "$rm_drv" commit -qam 'del3: remove TF-03'
git -C "$rm_drv" checkout -q -B keep3 main
todo_write "$rm_drv/TaskFlowDocs/todo.md" \
  "$(entry 'Other live' TF-20260101-03 inbox)" \
  "$(entry Base TF-20260101-01 done)"
git -C "$rm_drv" commit -qam 'keep3: live TF-03'
git -C "$rm_drv" checkout -q del3
git -C "$rm_drv" merge -q --no-edit keep3
merged="$rm_drv/TaskFlowDocs/todo.md"
grep -q 'TF-20260101-03 (removed 2026-01-01: other)' "$merged" \
  || { echo "FAIL reverse delete/keep dropped the tombstone"; cat "$merged"; exit 1; }
grep -q '^## Other live$' "$merged" \
  && { echo "FAIL reverse delete/keep resurrected the live entry"; cat "$merged"; exit 1; }
grep -q '^<<<<<<<' "$merged" && { echo "FAIL reverse deletion merge conflicted"; exit 1; }

# Both sides add different tombstones: union, not conflict.
git -C "$rm_drv" checkout -q -B both-a main
{
  printf '# Todo inbox\n\n## Items\n\n%s\n\n' "$(entry Base TF-20260101-01 done)"
  printf '## Removed\n\n- ID: TF-20260101-0a (removed 2026-01-01: a)\n'
} > "$rm_drv/TaskFlowDocs/todo.md"
git -C "$rm_drv" commit -qam 'both-a'
git -C "$rm_drv" checkout -q -B both-b main
{
  printf '# Todo inbox\n\n## Items\n\n%s\n\n' "$(entry Base TF-20260101-01 done)"
  printf '## Removed\n\n- ID: TF-20260101-0b (removed 2026-01-01: b)\n'
} > "$rm_drv/TaskFlowDocs/todo.md"
git -C "$rm_drv" commit -qam 'both-b'
git -C "$rm_drv" checkout -q both-a
git -C "$rm_drv" merge -q --no-edit both-b
merged="$rm_drv/TaskFlowDocs/todo.md"
grep -q 'TF-20260101-0a (removed' "$merged" || { echo "FAIL union lost tombstone a"; cat "$merged"; exit 1; }
grep -q 'TF-20260101-0b (removed' "$merged" || { echo "FAIL union lost tombstone b"; cat "$merged"; exit 1; }
[ "$(grep -c '^## Removed$' "$merged")" -eq 1 ] || { echo "FAIL union opened a second ## Removed"; exit 1; }
grep -q '^<<<<<<<' "$merged" && { echo "FAIL tombstone union conflicted"; exit 1; }
echo ok

echo "== merge driver installation is local, idempotent, and silent =="
install_root="$tmp/install"
mkdir -p "$install_root"
git -C "$install_root" init -q
expected="bash '$HERE/merge-todo' %O %A %B"
install_out="$(TASKFLOW_REPO_ROOT="$install_root" bash "$HERE/install-merge-driver" 2>&1)"
[ -z "$install_out" ] || { echo "FAIL installer was not silent:"; printf '%s\n' "$install_out"; exit 1; }
[ "$(git -C "$install_root" config --local --get merge.taskflow-todo.driver)" = "$expected" ] \
  || { echo "FAIL installer did not configure the driver"; exit 1; }
info="$(git -C "$install_root" rev-parse --git-path info/attributes)"
case "$info" in /*) ;; *) info="$install_root/$info" ;; esac
[ "$(grep -cxF 'TaskFlowDocs/todo.md merge=taskflow-todo' "$info")" = 1 ] \
  || { echo "FAIL installer did not set the attribute"; exit 1; }
# `git check-attr` is the assertion that matters: it reads the same sources Git
# does, so it also catches an attribute line written into the wrong file.
[ "$(git -C "$install_root" check-attr merge -- TaskFlowDocs/todo.md | awk '{print $NF}')" = "taskflow-todo" ] \
  || { echo "FAIL Git does not resolve the merge attribute"; exit 1; }
# Second run: same config, still one attribute line, still silent.
install_out="$(TASKFLOW_REPO_ROOT="$install_root" bash "$HERE/install-merge-driver" 2>&1)"
[ -z "$install_out" ] || { echo "FAIL second install was not silent"; exit 1; }
[ "$(grep -cxF 'TaskFlowDocs/todo.md merge=taskflow-todo' "$info")" = 1 ] \
  || { echo "FAIL second install duplicated the attribute"; exit 1; }
# A tracked .gitattributes must not be required, and must not be created.
[ -f "$install_root/.gitattributes" ] && { echo "FAIL installer wrote a tracked file"; exit 1; }
# Nothing outside the repository: the global config is untouched.
git config --global --get merge.taskflow-todo.driver >/dev/null 2>&1 \
  && { echo "FAIL installer wrote global config"; exit 1; }
# A TaskFlow root that is not a Git repository at all must be a silent no-op:
# `git config --local` outside a repository prints a fatal error otherwise.
non_git="$tmp/install-non-git"
mkdir -p "$non_git"
install_out="$(TASKFLOW_REPO_ROOT="$non_git" bash "$HERE/install-merge-driver" 2>&1)"
[ -z "$install_out" ] || { echo "FAIL installer spoke on a non-Git root:"; printf '%s\n' "$install_out"; exit 1; }
[ -z "$(ls -A "$non_git")" ] || { echo "FAIL installer wrote into a non-Git root"; exit 1; }
echo ok

echo "== Todo IDs are derived from the goal, not from a shared counter =="
# The bug this prevents: two branches cut from the same base both run the day's
# first intake, both compute "-01", and a merge that keeps both entries leaves two
# entries claiming one ID. A digest of the goal makes the branches agree instead.
id_a="$tmp/id-a"; id_b="$tmp/id-b"
mkdir -p "$id_a" "$id_b"
# `intake` prints "intake OK: <id>"; the ID itself is the last field.
intake() { bash "$HERE/task" intake "$1" "fixture" --root "$2" | awk '{ print $NF }'; }
first="$(intake "Todo ID determinism, first goal." "$id_a")"
second="$(intake "Todo ID determinism, second goal." "$id_a")"
[ "$first" != "$second" ] || { echo "FAIL two goals got one ID: $first"; exit 1; }
case "$first" in TF-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;; *)
  echo "FAIL ID is not TF-<yyyymmdd>-<6 hex>: $first"; exit 1 ;;
esac
# The same goal in an independent clone must produce the same ID, or the two
# branches would merge as two entries for one task.
clone_first="$(intake "Todo ID determinism, first goal." "$id_b")"
[ "$clone_first" = "$first" ] || { echo "FAIL same goal got different IDs: $first vs $clone_first"; exit 1; }
# Re-intaking the same goal still fails as a duplicate rather than silently
# allocating a fresh ID for it.
if bash "$HERE/task" intake "Todo ID determinism, first goal." "fixture" --root "$id_a" >/dev/null 2>&1; then
  echo "FAIL duplicate goal accepted"; exit 1
fi
grep -q "^- ID: $first$" "$id_a/TaskFlowDocs/todo.md" || { echo "FAIL ID not written"; exit 1; }
[ "$(grep -c '^- ID: ' "$id_a/TaskFlowDocs/todo.md")" -eq 2 ] || { echo "FAIL duplicate goal wrote an entry"; exit 1; }

# The end the two mechanisms exist for: two branches cut from one base each intake
# their own goal on the same day, then merge. A shared counter would hand both of
# them "-01"; deterministic IDs give them different keys, so the driver sees two
# distinct entries and keeps both without a conflict.
par="$tmp/parallel-intake"
mkdir -p "$par"
git -C "$par" init -q
git -C "$par" symbolic-ref HEAD refs/heads/main
git -C "$par" config user.email smoke@example.invalid
git -C "$par" config user.name smoke
TASKFLOW_REPO_ROOT="$par" bash "$HERE/install-merge-driver"
bash "$HERE/task" intake "The goal both branches start from." "fixture" --root "$par" >/dev/null
git -C "$par" add -A
git -C "$par" commit -qm base
git -C "$par" checkout -qb left
bash "$HERE/task" intake "The goal only the left branch took." "fixture" --root "$par" >/dev/null
left_id="$(awk '/^- ID: /{ print $3 }' "$par/TaskFlowDocs/todo.md" | tail -1)"
git -C "$par" commit -qam 'left: intake its goal'
git -C "$par" checkout -q main && git -C "$par" checkout -qb right
bash "$HERE/task" intake "The goal only the right branch took." "fixture" --root "$par" >/dev/null
right_id="$(awk '/^- ID: /{ print $3 }' "$par/TaskFlowDocs/todo.md" | tail -1)"
git -C "$par" commit -qam 'right: intake its goal'
[ "$left_id" != "$right_id" ] || { echo "FAIL both branches allocated $left_id"; exit 1; }
git -C "$par" checkout -q left
git -C "$par" merge -q --no-edit right
[ "$(grep -c '^- ID: ' "$par/TaskFlowDocs/todo.md")" -eq 3 ] \
  || { echo "FAIL parallel intake lost an entry:"; grep '^- ID: ' "$par/TaskFlowDocs/todo.md"; exit 1; }
grep -q '^<<<<<<<' "$par/TaskFlowDocs/todo.md" && { echo "FAIL parallel intake conflicted"; exit 1; }
echo ok

echo "== intake inserts at the top of ## Items, never after ## Removed =="
# The old intake always appended at EOF. With `## Removed` last, the new live
# entry landed in the deleted region — outside `## Items` and inside the range
# `todo-check` reads for authorized deletions.
ins_root="$tmp/intake-insert"
mkdir -p "$ins_root/TaskFlowDocs"
cat > "$ins_root/TaskFlowDocs/todo.md" <<'EOF'
# Todo inbox

## Status flow

`inbox → clarified → promoted → in_progress → done/cancelled`

## Items

<!-- Add new items at the top using the template below. -->
## Seed entry

- ID: TF-20260101-aa
- Status: clarified
- Priority: normal
- Owner: smoke
- Source: fixture
- Added: 2026-01-01
- Updated: 2026-01-01
- Goal: seed
- Task: Not promoted.
- Next action: none

## Removed

- ID: TF-20260101-bb (removed 2026-01-01: fixture)
EOF
ins_out="$tmp/intake-insert-out"
ins_id="$(bash "$HERE/task" intake "New entry must sit under Items." "fixture" --root "$ins_root" > "$ins_out" && awk '{ print $NF }' "$ins_out")"
ins_todo="$ins_root/TaskFlowDocs/todo.md"
ins_items="$(grep -n '^## Items$' "$ins_todo" | cut -d: -f1)"
ins_new="$(grep -n '^## New entry must sit under Items$' "$ins_todo" | cut -d: -f1)"
ins_seed="$(grep -n '^## Seed entry$' "$ins_todo" | cut -d: -f1)"
ins_rem="$(grep -n '^## Removed$' "$ins_todo" | cut -d: -f1)"
[ -n "$ins_items" ] && [ -n "$ins_new" ] && [ -n "$ins_seed" ] && [ -n "$ins_rem" ] \
  || { echo "FAIL insert fixture missing a section heading"; cat "$ins_todo"; exit 1; }
[ "$ins_items" -lt "$ins_new" ] && [ "$ins_new" -lt "$ins_seed" ] && [ "$ins_seed" -lt "$ins_rem" ] \
  || { echo "FAIL new entry not between Items and Removed (items=$ins_items new=$ins_new seed=$ins_seed rem=$ins_rem)"; grep -n '^## ' "$ins_todo"; exit 1; }
sed -n '/^## Removed$/,/^## /p' "$ins_todo" | grep -q "^- ID: $ins_id$" \
  && { echo "FAIL new ID appears inside ## Removed: $ins_id"; exit 1; }
# Goal-derived heading is what `promote` will use as the task directory name.
grep -qx -- '## New entry must sit under Items' "$ins_todo" \
  || { echo "FAIL new heading is not the Goal-derived title"; exit 1; }

# R2: no `## Items`, but `## Removed` exists — insert before Removed, not after.
ins2="$tmp/intake-no-items"
mkdir -p "$ins2/TaskFlowDocs"
cat > "$ins2/TaskFlowDocs/todo.md" <<'EOF'
# Todo inbox

## Removed

- ID: TF-20260101-bb (removed 2026-01-01: fixture)
EOF
bash "$HERE/task" intake "Before removed when Items is absent." "fixture" --root "$ins2" >/dev/null
ins2_new="$(grep -n '^## Before removed when Items is absent$' "$ins2/TaskFlowDocs/todo.md" | cut -d: -f1)"
ins2_rem="$(grep -n '^## Removed$' "$ins2/TaskFlowDocs/todo.md" | cut -d: -f1)"
[ -n "$ins2_new" ] && [ -n "$ins2_rem" ] && [ "$ins2_new" -lt "$ins2_rem" ] \
  || { echo "FAIL entry did not land before ## Removed when Items is absent"; cat "$ins2/TaskFlowDocs/todo.md"; exit 1; }

# R3: bare `# Todo` keeps append-at-EOF so existing minimal fixtures stay valid.
ins3="$tmp/intake-bare"
mkdir -p "$ins3/TaskFlowDocs"
printf '# Todo\n' > "$ins3/TaskFlowDocs/todo.md"
bash "$HERE/task" intake "Bare file still accepts intake." "fixture" --root "$ins3" >/dev/null
grep -qx -- '## Bare file still accepts intake' "$ins3/TaskFlowDocs/todo.md" \
  || { echo "FAIL bare fixture did not get a heading"; cat "$ins3/TaskFlowDocs/todo.md"; exit 1; }
echo ok

echo "== task next writes the deterministic Todo fields and lands Notes before Updated =="
# The point of the command is tokens: the fields it writes are templated from
# state the Agent already has, and hand-writing them costs a read of the whole
# Todo file. So the assertions below are about position and byte-fidelity, not
# just about the new value being present -- a `next` that appends to the end of
# the entry would put a Notes bullet below `- Updated:`, which is exactly the
# shape a hand edit gets wrong.
nf="$tmp/next-fields"
mkdir -p "$nf/TaskFlowDocs"
# Entry `aa` carries the post-promote shape: the Notes block sits above a trailing
# field, so "append at the end of the entry" and "append at the end of the Notes
# block" are distinguishable. Without a field after Notes the two are the same
# write and the test would pass either way.
printf '%s\n' \
  '# Todo inbox' '' '## Items' '' '## Seed' '' \
  '- ID: TF-20260101-aa' '- Status: inbox' '- Priority: normal' '- Owner: smoke' \
  '- Source: fixture' '- Added: 2026-01-01' \
  '- Goal: seed' '- Task: Not promoted.' '- Next action: old action.' \
  '- Notes: first bullet.' '- second bullet.' '- Updated: 2026-01-01' \
  '' '## Sparse' '' \
  '- ID: TF-20260101-bb' '- Status: done' '- Priority: normal' '- Owner: smoke' \
  '- Source: fixture' '- Added: 2026-01-01' '- Goal: sparse entry' \
  '- Task: `TaskFlowDocs/achieved/2026-01-01-sparse/`' '' '## Spare' '' \
  '- ID: TF-20260101-cc' '- Status: inbox' '- Priority: normal' '- Owner: smoke' \
  '- Source: fixture' '- Added: 2026-01-01' '- Goal: spare entry' \
  '- Task: Not promoted.' > "$nf/TaskFlowDocs/todo.md"

bash "$HERE/task" next TF-20260101-aa "new action." "third bullet." --root "$nf" >/dev/null

# The two rewritten fields, and nothing else, changed.
grep -qx -- '- Next action: new action.' "$nf/TaskFlowDocs/todo.md" || { echo "FAIL Next action not written"; exit 1; }
grep -qx -- "- Updated: $(date +%Y-%m-%d)" "$nf/TaskFlowDocs/todo.md" \
  || { echo "FAIL Updated not refreshed"; exit 1; }
grep -qx -- '- Next action: old action.' "$nf/TaskFlowDocs/todo.md" \
  && { echo "FAIL the old Next action survived"; exit 1; }
[ "$(grep -c '^- Next action: ' "$nf/TaskFlowDocs/todo.md")" -eq 1 ] \
  || { echo "FAIL next added or removed a Next action line"; exit 1; }
[ "$(grep -c '^- Updated: ' "$nf/TaskFlowDocs/todo.md")" -eq 1 ] \
  || { echo "FAIL next added or removed an Updated line"; exit 1; }

# The Notes bullet joins the block it belongs to: after the bullets already
# there, and still above `- Updated:`. Both halves matter -- the block can end
# with a field line, so "insert after the last bullet" and "insert before the
# first field line after Notes" have to agree.
awk '/^- Notes: first bullet\.$/{ n = NR }
     /^- third bullet\.$/{ t = NR }
     /^- Updated: /{ u = NR }
     END { exit !(n && t && u && n < t && t < u) }' "$nf/TaskFlowDocs/todo.md" \
  || { echo "FAIL Notes bullet did not land at the end of the Notes block, above Updated:"; sed -n '/TF-20260101-aa/,/^$/p' "$nf/TaskFlowDocs/todo.md"; exit 1; }
# The entry keeps every field it had: this is an edit, not a rewrite.
for f in ID Status Priority Owner Source Added Goal Task; do
  grep -q "^- $f: " "$nf/TaskFlowDocs/todo.md" || { echo "FAIL next dropped the $f field"; exit 1; }
done

# A field that is absent is added rather than failing the write: `archive` takes
# the same line over Todo shape, and a hand-written entry may not carry them.
bash "$HERE/task" next TF-20260101-bb "reopened for v2." --root "$nf" >/dev/null
grep -qx -- '- Next action: reopened for v2.' "$nf/TaskFlowDocs/todo.md" \
  || { echo "FAIL absent Next action was not added"; exit 1; }
grep -qx -- "- Updated: $(date +%Y-%m-%d)" "$nf/TaskFlowDocs/todo.md" \
  || { echo "FAIL absent Updated was not added"; exit 1; }
# Added next to the Status line the entry already had, not merely somewhere in
# the file: a stray line elsewhere would satisfy a bare grep.
awk '/^- ID: TF-20260101-bb$/{ f = 1 }
     f && /^- Status: done$/{ s = NR }
     f && /^- Next action: reopened for v2\.$/{ a = NR }
     END { exit !(s && a && a == s + 1) }' "$nf/TaskFlowDocs/todo.md" \
  || { echo "FAIL Next action was not added directly after Status:"; sed -n '/TF-20260101-bb/,$p' "$nf/TaskFlowDocs/todo.md"; exit 1; }
# The archived entry is addressed by ID alone -- its `Task:` link points into
# `achieved/`, where a task-id lookup would not find it.
grep -q 'achieved/2026-01-01-sparse' "$nf/TaskFlowDocs/todo.md" || { echo "FAIL fixture lost its achieved link"; exit 1; }

# An unknown ID is refused, and the file is left exactly as it was.
before="$(digest "$nf/TaskFlowDocs/todo.md")"
if bash "$HERE/task" next TF-20260101-zz "x." --root "$nf" >/dev/null 2>&1; then
  echo "FAIL unknown Todo ID accepted"; exit 1
fi
[ "$before" = "$(digest "$nf/TaskFlowDocs/todo.md")" ] || { echo "FAIL refused next still mutated Todo"; exit 1; }
echo ok

echo "== task get prints one entry and not the Todo file =="
# The other half of the token saving: the caller asks for one entry instead of
# reading all of `todo.md`. What has to hold is the *shape* of the output -- the
# entry's field lines, verbatim, in file order -- because the callers that parse
# these lines positionally (`awk '{print $NF}'`) depend on the field name staying
# the first word.
get_out="$tmp/next-get-out"
bash "$HERE/task" get TF-20260101-aa --root "$nf" > "$get_out"
# The entry's own fields, and nothing from a sibling entry or a heading.
grep -qx -- '- ID: TF-20260101-aa' "$get_out" || { echo "FAIL get did not print the entry"; cat "$get_out"; exit 1; }
grep -q 'TF-20260101-bb' "$get_out" && { echo "FAIL get printed a sibling entry"; cat "$get_out"; exit 1; }
grep -q '^## ' "$get_out" && { echo "FAIL get printed a section heading"; cat "$get_out"; exit 1; }
grep -q '^[[:space:]]*$' "$get_out" && { echo "FAIL get printed a blank line"; cat "$get_out"; exit 1; }
grep -q '^# Todo inbox' "$get_out" && { echo "FAIL get printed the file header"; cat "$get_out"; exit 1; }
# Verbatim and in file order: the same `- ` lines, in the order todo.md holds
# them. Rebuilding the lines would still satisfy a bare presence check, so the
# comparison is against the file's own slice.
sed -n '/^- ID: TF-20260101-aa$/,/^- Updated: /p' "$nf/TaskFlowDocs/todo.md" > "$tmp/get-expected"
diff -u "$tmp/get-expected" "$get_out" || { echo "FAIL get output is not the entry's field lines verbatim"; exit 1; }
# Positional parsing keeps working: the value, not the whole line.
[ "$(awk '/^- ID:/{ print $NF }' "$get_out")" = "TF-20260101-aa" ] \
  || { echo "FAIL get output is not positionally parseable"; exit 1; }
# Reading never writes.
before_get="$(digest "$nf/TaskFlowDocs/todo.md")"
bash "$HERE/task" get TF-20260101-bb --root "$nf" >/dev/null
[ "$before_get" = "$(digest "$nf/TaskFlowDocs/todo.md")" ] || { echo "FAIL get mutated Todo"; exit 1; }
if bash "$HERE/task" get TF-20260101-zz --root "$nf" >/dev/null 2>&1; then
  echo "FAIL unknown Todo ID accepted by get"; exit 1
fi
# What `next` writes, `get` reads back: the two are halves of one round trip.
# `sed` rather than `awk '{print $NF}'` because the value contains spaces -- the
# positional guarantee above is about the ID, which is one word.
bash "$HERE/task" next TF-20260101-aa "round trip." "round trip note." --root "$nf" >/dev/null
readback="$(bash "$HERE/task" get TF-20260101-aa --root "$nf" | sed -n 's/^- Next action: //p')"
[ "$readback" = "round trip." ] \
  || { echo "FAIL get did not read back what next wrote: $readback"; exit 1; }
# The v1 command's own fields survive v2's addition: `get` must not have been
# implemented by rerouting the internal `TASKFLOW_CMD=get`, whose shape is
# "title line, then the fields named in TASKFLOW_KEYS".
[ "$(grep -c 'TASKFLOW_CMD=get' "$HERE/task")" -eq 3 ] \
  || { echo "FAIL the internal get callers changed"; exit 1; }

# Notes continuations are part of the entry body. They are often indented, and
# a column-0 `- ` filter dropped them with no warning — the caller saw a
# complete-looking entry that was missing its later bullets.
notes_root="$tmp/get-notes"
mkdir -p "$notes_root/TaskFlowDocs"
printf '%s\n' \
  '# Todo inbox' '' '## Items' '' '## Notes probe' '' \
  '- ID: TF-20260101-ee' '- Status: inbox' '- Priority: normal' '- Owner: smoke' \
  '- Source: fixture' '- Added: 2026-01-01' '- Updated: 2026-01-01' \
  '- Goal: notes probe' '- Task: Not promoted.' '- Next action: none' \
  '- Notes: first line' \
  '  - second line indented' \
  '  no dash third line' \
  > "$notes_root/TaskFlowDocs/todo.md"
bash "$HERE/task" get TF-20260101-ee --root "$notes_root" > "$tmp/get-notes-out"
grep -qxF -- '  - second line indented' "$tmp/get-notes-out" \
  || { echo "FAIL get dropped the indented Notes bullet"; cat "$tmp/get-notes-out"; exit 1; }
grep -qxF -- '  no dash third line' "$tmp/get-notes-out" \
  || { echo "FAIL get dropped the indented Notes continuation"; cat "$tmp/get-notes-out"; exit 1; }
grep -q '^[[:space:]]*$' "$tmp/get-notes-out" \
  && { echo "FAIL get printed a blank line in the Notes fixture"; exit 1; }
grep -q '^## ' "$tmp/get-notes-out" \
  && { echo "FAIL get printed a heading in the Notes fixture"; exit 1; }
# Still every non-blank body line, verbatim and in order — not "fields plus
# whatever the filter liked".
sed -n '/^- ID: TF-20260101-ee$/,/^  no dash third line$/p' \
  "$notes_root/TaskFlowDocs/todo.md" > "$tmp/get-notes-expected"
diff -u "$tmp/get-notes-expected" "$tmp/get-notes-out" \
  || { echo "FAIL get Notes output is not the entry body verbatim"; exit 1; }
echo ok

echo "== task remove records the deletion that todo-check must not call a drop =="
# An authorized deletion and a merge that silently lost an entry are the same
# observable event, so the deletion has to be stated before it happens. What has
# to hold: the record is written where todo-check reads it, the entry is gone
# from the entry list, and a promoted entry cannot be deleted out from under its
# task directory.
rm_out="$tmp/remove-out"
bash "$HERE/task" remove TF-20260101-cc "superseded by TF-20260101-aa" --root "$nf" > "$rm_out"
grep -q 'remove OK: TF-20260101-cc' "$rm_out" || { echo "FAIL remove did not report success"; cat "$rm_out"; exit 1; }
awk '/^## Removed$/ { f = 1; next } f && /^## / { f = 0 } f' "$nf/TaskFlowDocs/todo.md" > "$tmp/removed-section"
grep -q -- "- ID: TF-20260101-cc (removed $(date +%Y-%m-%d): superseded by TF-20260101-aa)" "$tmp/removed-section" \
  || { echo "FAIL the deletion was not recorded in ## Removed"; cat "$tmp/removed-section"; exit 1; }
# The entry itself is gone, list and all -- not just its ID line blanked out.
# The record names the ID, so the count is what distinguishes "deleted" from
# "deleted and also recorded".
[ "$(grep -c 'TF-20260101-cc' "$nf/TaskFlowDocs/todo.md")" -eq 1 ] \
  || { echo "FAIL the removed entry has more than its record left in the file"; exit 1; }
grep -q '^## Spare' "$nf/TaskFlowDocs/todo.md" \
  && { echo "FAIL the removed entry's heading survived"; exit 1; }
# The deletion did not take its neighbours or the file's other sections with it.
grep -qx -- '- ID: TF-20260101-aa' "$nf/TaskFlowDocs/todo.md" || { echo "FAIL remove took a sibling entry"; exit 1; }
grep -q '^# Todo inbox' "$nf/TaskFlowDocs/todo.md" || { echo "FAIL remove ate the file header"; exit 1; }
grep -q '^## Items' "$nf/TaskFlowDocs/todo.md" || { echo "FAIL remove ate the items heading"; exit 1; }
# A second deletion appends to the same section rather than opening a second one,
# which is what keeps the record readable and the check's parse unambiguous.
printf '%s\n' '' '## Loose' '' \
  '- ID: TF-20260101-dd' '- Status: cancelled' '- Priority: normal' '- Owner: smoke' \
  '- Source: fixture' '- Added: 2026-01-01' '- Goal: loose entry' \
  '- Task: Not promoted.' >> "$nf/TaskFlowDocs/todo.md"
bash "$HERE/task" remove TF-20260101-dd "second deletion" --root "$nf" >/dev/null
[ "$(grep -c '^## Removed$' "$nf/TaskFlowDocs/todo.md")" -eq 1 ] \
  || { echo "FAIL a second removal opened a second ## Removed section"; exit 1; }
[ "$(awk '/^## Removed$/ { f = 1; next } f && /^## / { f = 0 } f && /^- ID:/' "$nf/TaskFlowDocs/todo.md" | wc -l | tr -d ' ')" -eq 2 ] \
  || { echo "FAIL the second deletion was not recorded"; exit 1; }
# A promoted entry is refused: deleting it would leave its task directory with
# no Todo record, which is the orphan this workflow keeps out.
promoted="$tmp/remove-promoted"
mkdir -p "$promoted/TaskFlowDocs/2026-01-01-promoted"
printf '# Plan\n> Task version: v1\n> Status: ready\n' > "$promoted/TaskFlowDocs/2026-01-01-promoted/plan.md"
printf '# Todo inbox\n\n## Items\n\n## Promoted\n\n- ID: TF-20260101-pp\n- Status: promoted\n- Task: `TaskFlowDocs/2026-01-01-promoted/`\n' > "$promoted/TaskFlowDocs/todo.md"
if bash "$HERE/task" remove TF-20260101-pp "not allowed" --root "$promoted" > "$tmp/remove-promoted-out" 2>&1; then
  echo "FAIL remove deleted the entry of a promoted task"; cat "$tmp/remove-promoted-out"; exit 1
fi
grep -qx -- '- ID: TF-20260101-pp' "$promoted/TaskFlowDocs/todo.md" \
  || { echo "FAIL the refused remove still deleted the entry"; exit 1; }
# An unknown ID and an empty reason are refused before anything is written.
if bash "$HERE/task" remove TF-20990101-zz "unknown" --root "$nf" >/dev/null 2>&1; then
  echo "FAIL remove accepted an unknown Todo ID"; exit 1
fi
if bash "$HERE/task" remove TF-20260101-aa "" --root "$nf" >/dev/null 2>&1; then
  echo "FAIL remove accepted an empty reason"; exit 1
fi
echo ok

echo "== release-check catches version drift and a bad marketplace pin =="
# Release literals live in five files and nothing else compares them: the checks
# in RELEASE.md covered the two manifests and left the CHANGELOG section, both
# README samples, and the marketplace `ref`/`sha` pair to the release author. Each
# case below is a drift that shipped silently before.
rel="$tmp/release-check"
mkdir -p "$rel/.claude-plugin" "$rel/.codex-plugin" "$rel/.codebuddy-plugin"
printf '{\n  "name": "taskflow",\n  "version": "9.9.9"\n}\n' > "$rel/.claude-plugin/plugin.json"
printf '{\n  "name": "taskflow",\n  "version": "9.9.9+codex.20260915"\n}\n' > "$rel/.codex-plugin/plugin.json"
printf '{\n  "name": "taskflow",\n  "version": "9.9.9+codebuddy.20260917"\n}\n' > "$rel/.codebuddy-plugin/plugin.json"
# The dsh bundle manifest carries no cachebuster: dsh installs it through pnpm.
printf '{\n  "name": "dsh-taskflow",\n  "version": "9.9.9"\n}\n' > "$rel/package.json"
printf '# Changelog\n\n## [9.9.9] — 2026-09-15\n' > "$rel/CHANGELOG.md"
# Two samples per README, matching the shipped files: the `claude plugin list`
# sample and the `codebuddy plugin list` sample. Both carry a literal a release
# moves, and reading only the first is the gap the section below pins shut.
printf '# Readme\n\n```bash\n#   taskflow@taskflow    Version: 9.9.9    Status: enabled\n```\n\n```bash\n#     Version: 9.9.9\n```\n' > "$rel/README.md"
cp "$rel/README.md" "$rel/README.zh-CN.md"
git -C "$rel" init -q
git -C "$rel" config user.email smoke@example.invalid
git -C "$rel" config user.name smoke
git -C "$rel" add -A
git -C "$rel" commit -qm init
git -C "$rel" tag v9.9.9
printf '{\n  "plugins": [\n    {\n      "source": {\n        "ref": "v9.9.9",\n        "sha": "%s"\n      }\n    }\n  ]\n}\n' "$(git -C "$rel" rev-parse HEAD)" \
  > "$rel/.claude-plugin/marketplace.json"
cp "$rel/.claude-plugin/marketplace.json" "$rel/.codebuddy-plugin/marketplace.json"

bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1 || { echo "FAIL consistent release rejected:"; cat "$rel/out"; exit 1; }
grep -q 'STATUS: pass' "$rel/out" || { echo "FAIL consistent release did not pass"; cat "$rel/out"; exit 1; }
# Both catalogs are checked, so a pin moved in one and not the other is caught.
grep -q 'Marketplace pin (.claude-plugin/marketplace.json)' "$rel/out" \
  || { echo "FAIL Claude Code catalog pin not checked"; cat "$rel/out"; exit 1; }
grep -q 'Marketplace pin (.codebuddy-plugin/marketplace.json)' "$rel/out" \
  || { echo "FAIL CodeBuddy catalog pin not checked"; cat "$rel/out"; exit 1; }

# One README sample left on the previous version.
sed 's/Version: 9.9.9/Version: 9.9.8/' "$rel/README.md" > "$rel/README.tmp"; mv "$rel/README.tmp" "$rel/README.md"
if bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1; then echo "FAIL stale README sample accepted"; exit 1; fi
grep -q 'README.md says 9.9.8' "$rel/out" || { echo "FAIL stale README sample not named"; cat "$rel/out"; exit 1; }
cp "$rel/README.zh-CN.md" "$rel/README.md"

# The SECOND sample line in one file. The first version of this check read only
# the first sample per README, so this drift passed `STATUS: pass` on the real
# repository: two literals a release has to move were compared by nothing. The
# file is written out rather than sed'd by line number so the sample that is stale
# is unambiguous in the test itself.
stale_second='# Readme

```bash
#   taskflow@taskflow    Version: 9.9.9    Status: enabled
```

```bash
#     Version: 9.9.8
```
'
printf '%s\n' "$stale_second" > "$rel/README.md"
if bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1; then echo "FAIL stale second README sample accepted"; exit 1; fi
grep -q 'README.md sample 2 says 9.9.8' "$rel/out" \
  || { echo "FAIL stale second README sample not named by position"; cat "$rel/out"; exit 1; }
cp "$rel/README.zh-CN.md" "$rel/README.md"
# Both literals are reported, not just the first, so the output shows which
# sample a release still has to move.
bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1
grep -q 'README.md (plugin list sample): 9.9.9' "$rel/out" \
  || { echo "FAIL first README sample not reported"; cat "$rel/out"; exit 1; }
grep -q 'README.md (plugin list sample 2): 9.9.9' "$rel/out" \
  || { echo "FAIL second README sample not reported"; cat "$rel/out"; exit 1; }
# A README with no sample line at all is a mismatch, not a skipped file.
printf '# Readme\n\nNothing to see.\n' > "$rel/README.md"
if bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1; then echo "FAIL README with no sample accepted"; exit 1; fi
grep -q "README.md has no 'Version:' plugin-list sample" "$rel/out" \
  || { echo "FAIL README with no sample not named"; cat "$rel/out"; exit 1; }
# A third sample line is compared too: the rule is "every sample", not "two".
third_stale='# Readme

```bash
#   taskflow@taskflow    Version: 9.9.9    Status: enabled
```

```bash
#     Version: 9.9.9
```

```bash
#     Version: 9.9.8
```
'
printf '%s\n' "$third_stale" > "$rel/README.md"
if bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1; then echo "FAIL stale third README sample accepted"; exit 1; fi
grep -q 'README.md sample 3 says 9.9.8' "$rel/out" \
  || { echo "FAIL stale third README sample not named"; cat "$rel/out"; exit 1; }
cp "$rel/README.zh-CN.md" "$rel/README.md"

# A CHANGELOG whose newest section is not the version being released.
sed 's/^## \[9.9.9\]/## [9.9.8]/' "$rel/CHANGELOG.md" > "$rel/CHANGELOG.tmp"; mv "$rel/CHANGELOG.tmp" "$rel/CHANGELOG.md"
if bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1; then echo "FAIL stale CHANGELOG section accepted"; exit 1; fi
grep -q 'CHANGELOG.md says 9.9.8' "$rel/out" || { echo "FAIL stale CHANGELOG section not named"; cat "$rel/out"; exit 1; }
sed 's/^## \[9.9.8\]/## [9.9.9]/' "$rel/CHANGELOG.md" > "$rel/CHANGELOG.tmp"; mv "$rel/CHANGELOG.tmp" "$rel/CHANGELOG.md"

# Codex cachebuster: the release number agrees, the suffix is not compared.
sed 's/9\.9\.9+codex\.20260915/9.9.9+codex.20991231/' "$rel/.codex-plugin/plugin.json" > "$rel/c.tmp"; mv "$rel/c.tmp" "$rel/.codex-plugin/plugin.json"
bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1 || { echo "FAIL cachebuster suffix compared as a version"; cat "$rel/out"; exit 1; }

# CodeBuddy cachebuster behaves the same way, and its release number is compared.
sed 's/9\.9\.9+codebuddy\.20260917/9.9.9+codebuddy.20991231/' "$rel/.codebuddy-plugin/plugin.json" > "$rel/c.tmp"; mv "$rel/c.tmp" "$rel/.codebuddy-plugin/plugin.json"
bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1 || { echo "FAIL CodeBuddy cachebuster suffix compared as a version"; cat "$rel/out"; exit 1; }
sed 's/9\.9\.9+codebuddy\.20991231/9.9.8+codebuddy.20991231/' "$rel/.codebuddy-plugin/plugin.json" > "$rel/c.tmp"; mv "$rel/c.tmp" "$rel/.codebuddy-plugin/plugin.json"
if bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1; then echo "FAIL stale CodeBuddy manifest accepted"; exit 1; fi
grep -q '.codebuddy-plugin/plugin.json says 9.9.8' "$rel/out" || { echo "FAIL stale CodeBuddy manifest not named"; cat "$rel/out"; exit 1; }
sed 's/9\.9\.8+codebuddy\.20991231/9.9.9+codebuddy.20260917/' "$rel/.codebuddy-plugin/plugin.json" > "$rel/c.tmp"; mv "$rel/c.tmp" "$rel/.codebuddy-plugin/plugin.json"

# The dsh bundle manifest is compared the same way, without a suffix to strip.
sed 's/"version": "9\.9\.9"/"version": "9.9.8"/' "$rel/package.json" > "$rel/c.tmp"; mv "$rel/c.tmp" "$rel/package.json"
if bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1; then echo "FAIL stale dsh manifest accepted"; exit 1; fi
grep -q 'package.json says 9.9.8' "$rel/out" || { echo "FAIL stale dsh manifest not named"; cat "$rel/out"; exit 1; }
sed 's/"version": "9\.9\.8"/"version": "9.9.9"/' "$rel/package.json" > "$rel/c.tmp"; mv "$rel/c.tmp" "$rel/package.json"

# The pin and the tag must name one commit; this is what Claude Code refuses at
# install time as `sha_pin_mismatch`, and it is the one failure a release cannot
# notice by comparing version numbers.
sed 's/9\.9\.9+codex\.20991231/9.9.9+codex.20260915/' "$rel/.codex-plugin/plugin.json" > "$rel/c.tmp"; mv "$rel/c.tmp" "$rel/.codex-plugin/plugin.json"
sed 's/"sha": "[0-9a-f]*"/"sha": "0000000000000000000000000000000000000000"/' "$rel/.claude-plugin/marketplace.json" > "$rel/m.tmp"
mv "$rel/m.tmp" "$rel/.claude-plugin/marketplace.json"
if bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1; then echo "FAIL mismatched sha accepted"; exit 1; fi
grep -q 'but sha says 0000000000000000000000000000000000000000' "$rel/out" || { echo "FAIL mismatched sha not named"; cat "$rel/out"; exit 1; }

# The pin staying on the previous release while the next one is prepared is the
# normal mid-release state, so it must not be reported as a mismatch.
git -C "$rel" tag v9.9.8
for catalog in "$rel/.claude-plugin/marketplace.json" "$rel/.codebuddy-plugin/marketplace.json"; do
  sed 's/"ref": "v9.9.9"/"ref": "v9.9.8"/; s/"sha": "0000000000000000000000000000000000000000"/"sha": "'"$(git -C "$rel" rev-parse HEAD)"'"/' \
    "$catalog" > "$rel/m.tmp"; mv "$rel/m.tmp" "$catalog"
done
bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1 || { echo "FAIL pin on the previous release rejected"; cat "$rel/out"; exit 1; }

# One catalog corrected and the other left behind is a real per-host install
# difference, so it must be caught rather than passed by the first match.
sed 's/"sha": "[0-9a-f]*"/"sha": "0000000000000000000000000000000000000000"/' "$rel/.codebuddy-plugin/marketplace.json" > "$rel/m.tmp"
mv "$rel/m.tmp" "$rel/.codebuddy-plugin/marketplace.json"
if bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1; then echo "FAIL catalog pin drift accepted"; exit 1; fi
grep -q '.codebuddy-plugin/marketplace.json ref v9.9.8 is' "$rel/out" || { echo "FAIL catalog pin drift not named"; cat "$rel/out"; exit 1; }
sed 's/"sha": "0000000000000000000000000000000000000000"/"sha": "'"$(git -C "$rel" rev-parse HEAD)"'"/' "$rel/.codebuddy-plugin/marketplace.json" > "$rel/m.tmp"
mv "$rel/m.tmp" "$rel/.codebuddy-plugin/marketplace.json"

# A manifest whose version is not X.Y.Z at all must be rejected rather than
# compared: `devel` is never equal to the release literal, but a shape that slips
# past the equality loop silently would leave the release unverified.
sed 's/"version": "9\.9\.9+codebuddy\.20260917"/"version": "devel+codebuddy.20260917"/' "$rel/.codebuddy-plugin/plugin.json" > "$rel/c.tmp"
mv "$rel/c.tmp" "$rel/.codebuddy-plugin/plugin.json"
if bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1; then echo "FAIL non-X.Y.Z manifest accepted"; exit 1; fi
grep -q '.codebuddy-plugin/plugin.json version is not X.Y.Z' "$rel/out" \
  || { echo "FAIL non-X.Y.Z manifest not named"; cat "$rel/out"; exit 1; }
sed 's/"version": "devel+codebuddy\.20260917"/"version": "9.9.9+codebuddy.20260917"/' "$rel/.codebuddy-plugin/plugin.json" > "$rel/c.tmp"
mv "$rel/c.tmp" "$rel/.codebuddy-plugin/plugin.json"

# The pin is read from the `source` object, not from the first string in the file
# that carries the field name. A decoy plugin entry whose own `ref`/`sha` precede
# the real one is the shape a flat scan would silently mis-read; the decoy names a
# tag that is present locally on purpose, so a wrong read does not merely look
# like a missing tag and the case isolates where the value came from.
decoy_sha="$(git -C "$rel" rev-parse HEAD)"
cp "$rel/.claude-plugin/marketplace.json" "$rel/m.bak"
sed 's/^  "plugins": \[$/  "plugins": [\n    {\n      "name": "decoy",\n      "source": {\n        "ref": "v9.9.8",\n        "sha": "'"$decoy_sha"'"\n      }\n    },/' \
  "$rel/m.bak" > "$rel/.claude-plugin/marketplace.json"
cp "$rel/.claude-plugin/marketplace.json" "$rel/.codebuddy-plugin/marketplace.json"
bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1 \
  || { echo "FAIL pinned source object rejected when a decoy entry precedes it"; cat "$rel/out"; exit 1; }
grep -q 'Marketplace pin (.claude-plugin/marketplace.json): v9.9.7 ->' "$rel/out" \
  && { echo "FAIL decoy entry was read instead of the pinned source object"; cat "$rel/out"; exit 1; }
grep -q 'Marketplace pin (.claude-plugin/marketplace.json): v9.9.8 ->' "$rel/out" \
  || { echo "FAIL the pinned source object was not the value read"; cat "$rel/out"; exit 1; }

# The pin is read from the `source` object, so a plugin entry after it that names a
# different tag is not the pin either. The decoy is placed *after* the real entry,
# which is where a whole-file scan that takes the last match would land.
sed 's/^  \]$/    },\n    {\n      "name": "decoy-after",\n      "source": {\n        "ref": "v9.9.7",\n        "sha": "'"$decoy_sha"'"\n      }\n    }\n  ]/' \
  "$rel/m.bak" > "$rel/.claude-plugin/marketplace.json"
cp "$rel/.claude-plugin/marketplace.json" "$rel/.codebuddy-plugin/marketplace.json"
bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1 \
  || { echo "FAIL pinned source object rejected when a decoy entry follows it"; cat "$rel/out"; exit 1; }
grep -q 'Marketplace pin (.claude-plugin/marketplace.json): v9.9.7 ->' "$rel/out" \
  && { echo "FAIL a trailing entry displaced the pinned source object"; cat "$rel/out"; exit 1; }
grep -q 'Marketplace pin (.claude-plugin/marketplace.json): v9.9.8 ->' "$rel/out" \
  || { echo "FAIL the pinned source object was not the value read after a trailing decoy"; cat "$rel/out"; exit 1; }

cp "$rel/m.bak" "$rel/.claude-plugin/marketplace.json"
cp "$rel/m.bak" "$rel/.codebuddy-plugin/marketplace.json"
rm -f "$rel/m.bak"

# A tag that is not present locally is a blocked check, not a version mismatch:
# releasing without fetched tags would otherwise compare against nothing.
git -C "$rel" tag -d v9.9.8 >/dev/null
if bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1; then echo "FAIL missing ref tag accepted"; exit 1; fi
grep -q 'is not present locally' "$rel/out" || { echo "FAIL missing ref tag not named"; cat "$rel/out"; exit 1; }

# A missing manifest blocks rather than reports: exit 3 is the documented
# blocked status, distinct from needs-user-input.
rm "$rel/CHANGELOG.md"
set +e
bash "$HERE/release-check" "$rel" >"$rel/out" 2>&1
rel_status=$?
set -e
[ "$rel_status" -eq 3 ] || { echo "FAIL missing manifest exit code: $rel_status"; cat "$rel/out"; exit 1; }
grep -q 'STATUS: blocked' "$rel/out" || { echo "FAIL missing manifest not blocked"; cat "$rel/out"; exit 1; }
echo ok

echo "== release-version writes every literal, and refuses before it writes any =="
# The eight literals are one approved version string transcribed into six files,
# so writing them by hand spends tokens on a mechanical edit and is the step that
# actually drifts. The command's whole contract is "one call, or nothing": every
# assertion below either checks a written literal or checks that a refusal left
# the tree byte-identical.
rv="$tmp/release-version"
mkdir -p "$rv/.claude-plugin" "$rv/.codex-plugin" "$rv/.codebuddy-plugin"
printf '{\n  "name": "taskflow",\n  "version": "9.9.9",\n  "engines": {\n    "node": "9.9.9"\n  }\n}\n' > "$rv/.claude-plugin/plugin.json"
printf '{\n  "name": "taskflow",\n  "version": "9.9.9+codex.20260915"\n}\n' > "$rv/.codex-plugin/plugin.json"
printf '{\n  "name": "taskflow",\n  "version": "9.9.9+codebuddy.20260917"\n}\n' > "$rv/.codebuddy-plugin/plugin.json"
printf '{\n  "name": "dsh-taskflow",\n  "version": "9.9.9"\n}\n' > "$rv/package.json"
printf '# Changelog\n\n## [9.9.8] — 2026-09-14\n\nOld.\n' > "$rv/CHANGELOG.md"
printf '# Readme\n\n```bash\n#   taskflow@taskflow    Version: 9.9.9    Status: enabled\n```\n\n```bash\n#     Version: 9.9.9\n```\n' > "$rv/README.md"
cp "$rv/README.md" "$rv/README.zh-CN.md"

# Each refusal is checked by digest, so "refused" cannot mean "wrote half of it".
# The captured output lives in `$tmp`, not in the fixture: anything written
# inside the fixture would be committed by `git add -A` below.
rv_digest() { find "$rv" -type f | sort | xargs cat | cksum; }
rv_before="$(rv_digest)"

# The release notes bind the literals to the tagged commit, so a version with no
# section is refused: writing the literals first is what leaves the notes in a
# commit the tag does not name.
if bash "$HERE/release-version" 9.9.10 "$rv" >"$tmp/rv-out" 2>&1; then
  echo "FAIL release-version ran without a CHANGELOG section"; cat "$tmp/rv-out"; exit 1
fi
grep -q "no '## \[9.9.10\]' section" "$tmp/rv-out" || { echo "FAIL missing-section refusal not explained"; cat "$tmp/rv-out"; exit 1; }
# Malformed, and not an increase: both are transcription errors, not releases.
if bash "$HERE/release-version" 9.9 "$rv" >"$tmp/rv-out" 2>&1; then echo "FAIL malformed version accepted"; exit 1; fi
grep -q 'must be X.Y.Z' "$tmp/rv-out" || { echo "FAIL malformed version not explained"; cat "$tmp/rv-out"; exit 1; }
if bash "$HERE/release-version" 9.9.9 "$rv" >"$tmp/rv-out" 2>&1; then echo "FAIL unchanged version accepted"; exit 1; fi
grep -q 'does not follow 9.9.9' "$tmp/rv-out" || { echo "FAIL unchanged version not explained"; cat "$tmp/rv-out"; exit 1; }
if bash "$HERE/release-version" 9.9.8 "$rv" >"$tmp/rv-out" 2>&1; then echo "FAIL downgrade accepted"; exit 1; fi
[ "$rv_before" = "$(rv_digest)" ] || { echo "FAIL a refusal mutated the tree"; exit 1; }

# A manifest with two `version` keys is refused rather than guessed at, and the
# refusal lands before anything is written.
rv_two="$tmp/release-version-two"
cp -r "$rv" "$rv_two"
printf '# Changelog\n\n## [9.9.10] — 2026-09-15\n' >> "$rv_two/CHANGELOG.md"
printf '{\n  "name": "t",\n  "version": "9.9.9",\n  "version": "9.9.9"\n}\n' > "$rv_two/.claude-plugin/plugin.json"
rv_two_digest() { find "$rv_two" -type f | sort | xargs cat | cksum; }
rv_two_before="$(rv_two_digest)"
if bash "$HERE/release-version" 9.9.10 "$rv_two" >"$tmp/rv-two-out" 2>&1; then
  echo "FAIL a manifest with two version keys was rewritten"; exit 1
fi
grep -q "has 2 'version' keys" "$tmp/rv-two-out" || { echo "FAIL duplicate version key not explained"; cat "$tmp/rv-two-out"; exit 1; }
[ "$rv_two_before" = "$(rv_two_digest)" ] || { echo "FAIL the duplicate-key refusal mutated the tree"; exit 1; }

# A file already carrying the target version is a refusal, not a silent no-op:
# the usual cause is a hand edit that moved one literal already, and the release
# author has to know the command is no longer the one that wrote this version.
rv_done="$tmp/release-version-done"
cp -r "$rv" "$rv_done"
printf '# Changelog\n\n## [9.9.10] — 2026-09-15\n' >> "$rv_done/CHANGELOG.md"
printf '# Readme\n\n```bash\n#   taskflow@taskflow    Version: 9.9.10    Status: enabled\n```\n\n```bash\n#     Version: 9.9.10\n```\n' > "$rv_done/README.md"
if bash "$HERE/release-version" 9.9.10 "$rv_done" >"$tmp/rv-done-out" 2>&1; then
  echo "FAIL a file already at the target version was overwritten silently"; exit 1
fi
grep -q 'README.md already says 9.9.10' "$tmp/rv-done-out" \
  || { echo "FAIL the already-at-target refusal was not named"; cat "$tmp/rv-done-out"; exit 1; }
# The manifest must not have been written on the way to discovering that.
grep -q '"version": "9.9.9"' "$rv_done/.claude-plugin/plugin.json" \
  || { echo "FAIL a partial write preceded the already-at-target refusal"; exit 1; }

# The success path: the section exists, so the literals move and release-check
# agrees immediately. That agreement is the point — no second edit, no drift.
printf '# Changelog\n\n## [9.9.10] — 2026-09-15\n\nNew.\n' > "$rv/CHANGELOG.md"
bash "$HERE/release-version" 9.9.10 "$rv" >"$tmp/rv-out" 2>&1 || { echo "FAIL release-version refused a valid release:"; cat "$tmp/rv-out"; exit 1; }
grep -q 'release-version OK: 9.9.9 -> 9.9.10 (8 literals in 6 files)' "$tmp/rv-out" \
  || { echo "FAIL release-version did not report all eight literals"; cat "$tmp/rv-out"; exit 1; }
grep -q '"version": "9.9.10"' "$rv/.claude-plugin/plugin.json" || { echo "FAIL claude manifest not written"; exit 1; }
grep -q '"version": "9.9.10"' "$rv/package.json" || { echo "FAIL dsh manifest not written"; exit 1; }
# The cachebuster survives with today's date, not the fixture's old one.
grep -q "\"version\": \"9.9.10+codex.$(date +%Y%m%d)\"" "$rv/.codex-plugin/plugin.json" \
  || { echo "FAIL codex cachebuster not rewritten"; cat "$rv/.codex-plugin/plugin.json"; exit 1; }
grep -q "\"version\": \"9.9.10+codebuddy.$(date +%Y%m%d)\"" "$rv/.codebuddy-plugin/plugin.json" \
  || { echo "FAIL codebuddy cachebuster not rewritten"; cat "$rv/.codebuddy-plugin/plugin.json"; exit 1; }
# A nested key that happens to hold the same string is not the manifest version.
grep -q '"node": "9.9.9"' "$rv/.claude-plugin/plugin.json" \
  || { echo "FAIL a nested value was rewritten with the manifest version"; cat "$rv/.claude-plugin/plugin.json"; exit 1; }
# Both sample lines in both READMEs.
[ "$(grep -c 'Version: 9.9.10' "$rv/README.md")" -eq 2 ] \
  || { echo "FAIL README.md literals not all rewritten:"; grep -n 'Version:' "$rv/README.md"; exit 1; }
[ "$(grep -c 'Version: 9.9.10' "$rv/README.zh-CN.md")" -eq 2 ] \
  || { echo "FAIL README.zh-CN.md literals not all rewritten:"; grep -n 'Version:' "$rv/README.zh-CN.md"; exit 1; }
git -C "$rv" init -q
git -C "$rv" config user.email smoke@example.invalid
git -C "$rv" config user.name smoke
git -C "$rv" add -A
git -C "$rv" commit -qm release
git -C "$rv" tag v9.9.10
printf '{\n  "plugins": [\n    {\n      "source": {\n        "ref": "v9.9.10",\n        "sha": "%s"\n      }\n    }\n  ]\n}\n' "$(git -C "$rv" rev-parse HEAD)" \
  > "$rv/.claude-plugin/marketplace.json"
cp "$rv/.claude-plugin/marketplace.json" "$rv/.codebuddy-plugin/marketplace.json"
bash "$HERE/release-check" "$rv" >"$tmp/rv-out" 2>&1 || { echo "FAIL release-check rejected what release-version wrote:"; cat "$tmp/rv-out"; exit 1; }
grep -q 'STATUS: pass' "$tmp/rv-out" || { echo "FAIL release-version output did not pass release-check"; cat "$tmp/rv-out"; exit 1; }

# The pin window is the range the tag does not cover: from the tagged commit to
# the commit that recorded the pin. `RELEASE.md` makes that one commit, and the
# only files it may carry are the two catalogs — so the cases below are built by
# amending that commit, which is exactly the shape being guarded: the pin commit
# turning out to carry something more.
git -C "$rv" add -A
git -C "$rv" commit -qm 'pin the marketplace'
bash "$HERE/release-check" "$rv" >"$tmp/rv-out" 2>&1 || { echo "FAIL a catalogs-only pin commit was rejected:"; cat "$tmp/rv-out"; exit 1; }
grep -q 'STATUS: pass' "$tmp/rv-out" || { echo "FAIL a catalogs-only pin commit did not pass"; cat "$tmp/rv-out"; exit 1; }

# A task document in the window is exempt: it is not shipped with the release, so
# it cannot make the pin ship code the tag does not name.
mkdir -p "$rv/TaskFlowDocs/some-task"
printf '# Plan\n' > "$rv/TaskFlowDocs/some-task/plan.md"
git -C "$rv" add -A
git -C "$rv" commit -q --amend --no-edit
bash "$HERE/release-check" "$rv" >"$tmp/rv-out" 2>&1 || { echo "FAIL a TaskFlowDocs path in the pin window was reported:"; cat "$tmp/rv-out"; exit 1; }
grep -q 'STATUS: pass' "$tmp/rv-out" || { echo "FAIL a TaskFlowDocs path in the pin window did not pass"; cat "$tmp/rv-out"; exit 1; }

# Anything else in that commit is the failure this rule exists for: it would ship
# under the pin without being in the release commit the tag names, and nothing
# else in the release would notice.
printf '#!/bin/sh\n' > "$rv/hooks-stray.sh"
git -C "$rv" add -A
git -C "$rv" commit -q --amend --no-edit
if bash "$HERE/release-check" "$rv" >"$tmp/rv-out" 2>&1; then echo "FAIL a stray file in the pin window was accepted"; cat "$tmp/rv-out"; exit 1; fi
grep -q 'carries changes outside the pin: hooks-stray.sh' "$tmp/rv-out" \
  || { echo "FAIL the stray path was not named"; cat "$tmp/rv-out"; exit 1; }
echo ok

echo "== todo-check reports an entry a merge dropped =="
# The check exists because a hosted-platform merge resolved a conflict by taking
# one side wholesale and a whole Todo section left `main` with no conflict marker.
# The fixture reproduces that resolution in a real repository rather than
# simulating it: a genuine conflicting merge, then `--ours` for the todo file.
tc="$tmp/todo-check"
mkdir -p "$tc/TaskFlowDocs"
git -C "$tc" init -q
git -C "$tc" symbolic-ref HEAD refs/heads/main
git -C "$tc" config user.email smoke@example.invalid
git -C "$tc" config user.name smoke
tc_write() {  # tc_write <file> <entry-block>...
  local f="$1"
  shift
  { printf '# Todo inbox\n\n## Items\n\n'
    for e in "$@"; do printf '%s\n\n' "$e"; done
  } > "$f"
}
tc_entry() { printf '## %s\n- ID: %s\n- Status: %s\n' "$1" "$2" "$3"; }
tc_todo="$tc/TaskFlowDocs/todo.md"

# The root commit predates TaskFlowDocs, so one parent in the last case has no
# Todo file at all. Every later case branches from `base`.
mkdir -p "$tc/src"
printf 'fixture\n' > "$tc/src/README.md"
git -C "$tc" add -A
git -C "$tc" commit -qm root
git -C "$tc" tag root

# Both base entries sit above the shared anchor and are never edited by the
# append-only branches, so the two additions land on the same hunk and conflict.
tc_write "$tc_todo" "$(tc_entry Base1 TF-20260101-01 done)" "$(tc_entry Base2 TF-20260101-02 done)"
git -C "$tc" add -A
git -C "$tc" commit -qm base
git -C "$tc" tag base

# A non-merge commit is never a drop, even when it edits Todo. The guard matters
# because deleting an entry by hand is an intentional edit, not a merge that
# silently resolved a conflict — only a merge result is this check's business.
tc_write "$tc_todo" "$(tc_entry Base1 TF-20260101-01 done)" "$(tc_entry Base2 TF-20260101-02 done)" \
  "$(tc_entry Plain TF-20260101-03 inbox)"
git -C "$tc" commit -qam 'plain commit adds an entry'
set +e
bash "$HERE/todo-check" "$tc" > "$tc/out" 2>&1
tc_status=$?
set -e
[ "$tc_status" -eq 0 ] || { echo "FAIL clean non-merge commit rejected ($tc_status):"; cat "$tc/out"; exit 1; }
grep -q 'STATUS: pass' "$tc/out" || { echo "FAIL clean non-merge commit did not pass"; cat "$tc/out"; exit 1; }
tc_write "$tc_todo" "$(tc_entry Base1 TF-20260101-01 done)" "$(tc_entry Base2 TF-20260101-02 done)"
git -C "$tc" commit -qam 'plain commit removes an entry by hand'
set +e
bash "$HERE/todo-check" "$tc" > "$tc/out" 2>&1
tc_status=$?
set -e
[ "$tc_status" -eq 0 ] || { echo "FAIL hand-deleted entry in a plain commit rejected ($tc_status):"; cat "$tc/out"; exit 1; }
git -C "$tc" reset -q --hard 'HEAD~1'

# Both branches append at the same anchor, which is what made the real merge
# conflict; resolving it by keeping this branch's file is what dropped the entry.
git -C "$tc" checkout -qb theirs "$(git -C "$tc" rev-parse base)"
tc_write "$tc_todo" "$(tc_entry Base1 TF-20260101-01 done)" "$(tc_entry Base2 TF-20260101-02 done)" \
  "$(tc_entry TheirOnly TF-20260101-77 inbox)"
git -C "$tc" commit -qam 'theirs: add TF-20260101-77'
git -C "$tc" checkout -qb ours "$(git -C "$tc" rev-parse base)"
tc_write "$tc_todo" "$(tc_entry Base1 TF-20260101-01 done)" "$(tc_entry Base2 TF-20260101-02 done)" \
  "$(tc_entry OursOnly TF-20260101-88 inbox)"
git -C "$tc" commit -qam 'ours: add TF-20260101-88'
set +e
git -C "$tc" merge -q --no-edit theirs >/dev/null 2>&1
tc_merge=$?
set -e
[ "$tc_merge" -ne 0 ] || { echo "FAIL fixture merge did not conflict; the drop case is not reproduced"; exit 1; }
git -C "$tc" checkout --ours "$tc_todo"
git -C "$tc" add "$tc_todo"
git -C "$tc" commit -qm 'merge resolving todo by keeping ours (the platform behaviour)'
tc_merge_rev="$(git -C "$tc" rev-parse HEAD)"
grep -q 'TF-20260101-77' "$tc_todo" && { echo "FAIL fixture kept the entry it is supposed to drop"; exit 1; }

# Put `main` on that merge, so the drop sits on the branch the range cases below
# audit — which is what happened for real: the loss reached `main`. `main` cannot
# fast-forward here (it carries the plain-commit cases), so it is reset to it.
git -C "$tc" checkout -q main
git -C "$tc" reset -q --hard "$tc_merge_rev"
[ "$(git -C "$tc" rev-parse HEAD)" = "$tc_merge_rev" ] || { echo "FAIL fixture main is not the drop merge"; exit 1; }

set +e
bash "$HERE/todo-check" "$tc" "$tc_merge_rev" > "$tc/out" 2>&1
tc_status=$?
set -e
[ "$tc_status" -eq 2 ] || { echo "FAIL dropped entry exit code: $tc_status"; cat "$tc/out"; exit 1; }
grep -q "TF-20260101-77 present in .* but missing from" "$tc/out" || { echo "FAIL dropped entry not named with its parent"; cat "$tc/out"; exit 1; }
grep -q 'STATUS: needs-user-input' "$tc/out" || { echo "FAIL dropped entry not reported as needs-user-input"; cat "$tc/out"; exit 1; }
grep -q 'TF-20260101-88' "$tc/out" && { echo "FAIL check blamed an entry the merge kept"; cat "$tc/out"; exit 1; }

# A merge that kept everything must pass. Ours edits an entry the other side
# never touches while theirs appends, so the two hunks are disjoint and Git
# merges them without a conflict.
git -C "$tc" checkout -qb good "$(git -C "$tc" rev-parse base)"
awk '/^- ID: TF-20260101-01$/ { f = 1 } f && /^- Status: / { sub(/done/, "in_progress"); f = 0 } { print }' \
  "$tc_todo" > "$tc/.todo.next"
mv "$tc/.todo.next" "$tc_todo"
git -C "$tc" commit -qam 'good: edit our own entry'
git -C "$tc" merge -q --no-edit theirs
bash "$HERE/todo-check" "$tc" > "$tc/out" 2>&1 ||
  { echo "FAIL merge that kept both entries rejected:"; cat "$tc/out"; exit 1; }
grep -q 'STATUS: pass' "$tc/out" || { echo "FAIL good merge did not pass"; cat "$tc/out"; exit 1; }

# A parent that has no Todo file yet must be skipped, not treated as losing
# everything: this is a repository adopting TaskFlowDocs mid-history. The branch
# is cut from `root` and carries its own commit, so merging it into `main` is a
# real merge with one parent that predates `TaskFlowDocs/todo.md` entirely.
git -C "$tc" checkout -qb nofile "$(git -C "$tc" rev-parse root)"
printf 'branch\n' > "$tc/src/branch.txt"
git -C "$tc" add -A
git -C "$tc" commit -qm 'nofile: a commit before TaskFlowDocs existed'
git -C "$tc" checkout -q main
git -C "$tc" merge -q --no-edit nofile
bash "$HERE/todo-check" "$tc" > "$tc/out" 2>&1 ||
  { echo "FAIL parent without a Todo file was not skipped:"; cat "$tc/out"; exit 1; }
grep -q 'no TaskFlowDocs/todo.md; skipped' "$tc/out" || { echo "FAIL parent without a Todo file not reported as skipped"; cat "$tc/out"; exit 1; }
grep -q 'STATUS: pass' "$tc/out" || { echo "FAIL parent without a Todo file did not pass"; cat "$tc/out"; exit 1; }

# An unresolvable commit and a non-repository are blocked, not a pass.
set +e
bash "$HERE/todo-check" "$tc" does-not-exist > "$tc/out" 2>&1
tc_status=$?
set -e
[ "$tc_status" -eq 3 ] || { echo "FAIL unresolvable commit exit code: $tc_status"; cat "$tc/out"; exit 1; }
grep -q 'STATUS: blocked' "$tc/out" || { echo "FAIL unresolvable commit not blocked"; cat "$tc/out"; exit 1; }

# A directory outside any repository blocks too. It is created beside the OS
# temp root rather than under `$tmp`, so the assertion cannot be defeated by a
# caller who passed a `$tmp` that happens to live inside a Git repository.
notrepo="$(mktemp -d "${TMPDIR:-/tmp}/taskflow-not-a-repo.XXXXXX")"
set +e
bash "$HERE/todo-check" "$notrepo" > "$tc/out" 2>&1
tc_status=$?
set -e
rm -rf "$notrepo"
[ "$tc_status" -eq 3 ] || { echo "FAIL non-repository exit code: $tc_status"; cat "$tc/out"; exit 1; }
grep -q 'STATUS: blocked' "$tc/out" || { echo "FAIL non-repository not blocked"; cat "$tc/out"; exit 1; }

# Range mode is what CI runs, because a hosted-platform merge is only visible
# after it lands: the push that carries it is audited as one unit. The fixture
# already holds the drop (`$tc_merge_rev`) and the good merge, so the range cases
# reuse that history rather than building a second repository.
set +e
bash "$HERE/todo-check" "$tc" "$(git -C "$tc" rev-parse base)..HEAD" > "$tc/out" 2>&1
tc_status=$?
set -e
[ "$tc_status" -eq 2 ] || { echo "FAIL range containing a drop exit code: $tc_status"; cat "$tc/out"; exit 1; }
grep -q "TF-20260101-77 present in .* but missing from" "$tc/out" || { echo "FAIL range did not name the dropped entry"; cat "$tc/out"; exit 1; }
grep -q 'Merge commits in range:' "$tc/out" || { echo "FAIL range did not report how many merges it audited"; cat "$tc/out"; exit 1; }
grep -q 'STATUS: needs-user-input' "$tc/out" || { echo "FAIL range with a drop not reported as needs-user-input"; cat "$tc/out"; exit 1; }

# The drop is at the *tip's ancestor*, not the tip. A range that starts after it
# must pass, which is the whole reason the range form exists: auditing only the
# tip is what let the real loss through.
set +e
bash "$HERE/todo-check" "$tc" "$tc_merge_rev..HEAD" > "$tc/out" 2>&1
tc_status=$?
set -e
[ "$tc_status" -eq 0 ] || { echo "FAIL range excluding the drop exit code: $tc_status"; cat "$tc/out"; exit 1; }
grep -q 'STATUS: pass' "$tc/out" || { echo "FAIL range excluding the drop did not pass"; cat "$tc/out"; exit 1; }

# An empty range and a range with no merge commits are both clean pushes, not
# unusable arguments: pass, so a normal push is not reported as broken.
set +e
bash "$HERE/todo-check" "$tc" "HEAD..HEAD" > "$tc/out" 2>&1
tc_status=$?
set -e
[ "$tc_status" -eq 0 ] || { echo "FAIL empty range exit code: $tc_status"; cat "$tc/out"; exit 1; }
grep -q 'Merge commits in range: 0' "$tc/out" || { echo "FAIL empty range not reported as zero merges"; cat "$tc/out"; exit 1; }

# A range that cannot be resolved is blocked. An unusable argument must never
# read as a clean push, or a typo in CI would silently stop the audit.
set +e
bash "$HERE/todo-check" "$tc" "nope..also-nope" > "$tc/out" 2>&1
tc_status=$?
set -e
[ "$tc_status" -eq 3 ] || { echo "FAIL bad range exit code: $tc_status"; cat "$tc/out"; exit 1; }
grep -q 'Cannot resolve range' "$tc/out" || { echo "FAIL bad range not reported as unresolvable"; cat "$tc/out"; exit 1; }
grep -q 'STATUS: blocked' "$tc/out" || { echo "FAIL bad range not blocked"; cat "$tc/out"; exit 1; }

# The degenerate single-commit path CI falls back to (all-zero `before`) has to
# agree with the range form on the same commit, or the two answers would differ
# by event type alone.
set +e
bash "$HERE/todo-check" "$tc" "$tc_merge_rev" > "$tc/out" 2>&1
tc_status=$?
set -e
[ "$tc_status" -eq 2 ] || { echo "FAIL single-commit fallback exit code: $tc_status"; cat "$tc/out"; exit 1; }

# A stale tombstone may be deleted while the live ID stays (data cleanup after a
# resurrection). ids_at must key both sides by the first token, or the parent's
# "- ID: TF-x (removed …)" line looks like an entry whose name is the whole
# parenthetical and the merge is reported as a drop — which is what failed CI
# on PR #50 when the false v1.0.7 tombstone for 985164 was removed.
tc_write "$tc_todo" \
  "$(tc_entry Keep TF-20260101-91 inbox)" \
  "$(tc_entry Base1 TF-20260101-01 done)"
{
  printf '## Removed\n\n- ID: TF-20260101-91 (removed 2026-01-01: stale twin)\n'
} >> "$tc_todo"
git -C "$tc" add -A
git -C "$tc" commit -qm 'parent: live TF-91 plus a stale tombstone'
tc_twin_parent="$(git -C "$tc" rev-parse HEAD)"
tc_write "$tc_todo" \
  "$(tc_entry Keep TF-20260101-91 inbox)" \
  "$(tc_entry Base1 TF-20260101-01 done)"
git -C "$tc" commit -qam 'child: drop only the stale tombstone, keep live TF-91'
set +e
bash "$HERE/todo-check" "$tc" "$tc_twin_parent" > "$tc/out" 2>&1
tc_status=$?
set -e
[ "$tc_status" -eq 0 ] || { echo "FAIL dropping a stale tombstone while keeping the live ID was reported as a drop ($tc_status):"; cat "$tc/out"; exit 1; }
grep -q 'STATUS: pass' "$tc/out" || { echo "FAIL tombstone-drop cleanup did not pass"; cat "$tc/out"; exit 1; }
echo ok

echo "== the dsh wiring runs session-start the way dsh runs it =="
# dsh's Claude Code bridge substitutes ${CLAUDE_PLUGIN_ROOT} in the command string
# and runs it through a `bash -c` seam, exporting only CLAUDE_PROJECT_DIR. The
# command therefore sets CLAUDE_PLUGIN_ROOT itself, and this section proves why it
# has to: without the prefix the hook takes its fallback branch, emits a top-level
# additionalContext, and dsh's codec -- which reads only the nested
# hookSpecificOutput.additionalContext -- discards the context silently. That
# failure is invisible to every other check here, because the hook still exits 0
# and still prints JSON.
dsh_cmd="$(sed -n 's/.*"command":[[:space:]]*"\(.*\)".*/\1/p' "$HERE/hooks-dsh.json" | head -1)"
[ -n "$dsh_cmd" ] || { echo "FAIL hooks-dsh.json declares no command"; exit 1; }
case "$dsh_cmd" in
  CLAUDE_PLUGIN_ROOT=*) ;;
  *) echo "FAIL hooks-dsh.json command does not set CLAUDE_PLUGIN_ROOT: dsh's codec would discard the hook's output"; exit 1 ;;
esac
dsh_resolved="$(printf '%s' "$dsh_cmd" | sed "s|\${CLAUDE_PLUGIN_ROOT}|$HERE/..|g")"
dsh_out="$(printf '{"hook_event_name":"SessionStart","cwd":"%s","session_id":"smoke"}\n' "$tmp" \
  | (cd "$tmp" && CLAUDE_PROJECT_DIR="$tmp" bash -c "$dsh_resolved" 2>&1))" || {
  echo "FAIL the dsh wiring command did not run:"; printf '%s\n' "$dsh_out"; exit 1
}
printf '%s' "$dsh_out" | grep -q '"hookSpecificOutput"' || {
  echo "FAIL the dsh wiring produced a top-level context dsh would discard:"
  printf '%s\n' "$dsh_out"; exit 1
}
printf '%s' "$dsh_out" | grep -q '"hookEventName": *"SessionStart"' || {
  echo "FAIL the dsh wiring output carries no matching hookEventName:"
  printf '%s\n' "$dsh_out"; exit 1
}
echo ok

echo "== the hook launcher executes the way the harness executes it =="
# Claude Code runs the plugin `command` verbatim through the platform shell, so
# the first token has to be an executable file. Both halves matter and neither is
# implied by the other: the mode in the Git tree decides what a clone installs
# (a 100644 entry installs 644 and dies with "Permission denied", exit 126), and
# a filesystem that reports every file executable -- a drvfs mount, some network
# shares -- hides that from any check that only stats the file. The index is
# therefore read directly when this checkout has one.
# Every other section here calls `bash "$HERE/<hook>"` explicitly, which is why a
# launcher that nothing can execute still left a green suite: the harness's own
# invocation was the one form never exercised.
if git -C "$HERE" ls-files --error-unmatch run-hook.cmd >/dev/null 2>&1; then
  launcher_mode="$(git -C "$HERE" ls-files -s run-hook.cmd | awk '{print $1}')"
  [ "$launcher_mode" = "100755" ] || {
    echo "FAIL run-hook.cmd is recorded as $launcher_mode, not 100755: it installs non-executable and every Unix hook fails with 'Permission denied'"
    exit 1
  }
fi
# The real thing, run as the harness runs it: the path alone, no `bash` prefix.
# Name resolution differs too -- the tree needs `bash` on `$PATH` for the
# scripts it launches, and the harness inherits no such guarantee from us.
exec_out="$(cd "$tmp" && CLAUDE_PLUGIN_ROOT="$HERE/.." TASKFLOW_REPO_ROOT="$tmp" \
  PATH="$PATH:/usr/bin:/bin" sh -c "\"$HERE/run-hook.cmd\" session-start" 2>&1)" || {
  echo "FAIL run-hook.cmd could not be executed directly:"
  printf '%s\n' "$exec_out"
  exit 1
}
echo "$exec_out" | grep -q '"hookSpecificOutput"' || {
  echo "FAIL direct execution produced no hook output:"
  printf '%s\n' "$exec_out"
  exit 1
}
echo ok

echo "ALL SMOKE PASSED"
