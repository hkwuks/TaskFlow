#!/usr/bin/env bash
# repository-docs-context — synchronize the routing record and print compact routes.
# POSIX shell + awk only: the plugin must run with no language runtime available.
set -euo pipefail
shopt -s nullglob

repo_root="${TASKFLOW_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")}"
phase="${TASKFLOW_PHASE:-auto}"
task_id="${TASKFLOW_TASK_ID:-}"
# Byte-order collation keeps glob and sort order identical across hosts, which is
# what makes the index byte-stable.
LC_ALL=C
export LC_ALL

docs="$repo_root/TaskFlowDocs/repository-docs"
index="$docs/index.md"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

fail() { echo "$*" >&2; exit 1; }

# --- phase inference -------------------------------------------------------
if [ "$phase" = "auto" ]; then
  inferred=""
  candidates=""
  if [ -n "$task_id" ]; then
    candidates="$repo_root/TaskFlowDocs/$task_id/plan.md"
  else
    # nullglob makes an unmatched pattern disappear, so a plan-less repository
    # yields no candidates rather than a literal pattern or an `ls` of the cwd.
    candidates="$repo_root"/TaskFlowDocs/20*/plan.md
  fi
  for plan in $candidates; do
    [ -f "$plan" ] || continue
    status=$(sed -n 's/^> Status: *//p' "$plan" | head -1)
    case "$status" in
      planning|ready) mapped=design ;;
      in_progress)    mapped=code ;;
      checking)       mapped=review ;;
      *)              continue ;;
    esac
    case " $inferred " in *" $mapped "*) ;; *) inferred="$inferred $mapped" ;; esac
  done
  # shellcheck disable=SC2086
  set -- $inferred
  if [ "$#" -eq 1 ]; then phase="$1"; else phase="unclassified"; fi
fi

# --- entry assembly --------------------------------------------------------
# Entries are tab-separated: kind, path, phases, status-override ("-" = derive).
# `known` must grow with every added entry: it is what stops a carried-over row
# and a derived candidate from both claiming the same path on the next run.
: > "$work/entries"
: > "$work/known"
have_known() { grep -Fxq "$1" "$work/known"; }
add_entry() {
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >> "$work/entries"
  printf '%s\n' "$2" >> "$work/known"
}

add_entry repository-guidance README.md design,roadmap -
add_entry repository-guidance README.zh-CN.md design,roadmap -
add_entry repository-rule LICENSE all -
add_entry repository-rule CONTRIBUTING.md design,code,commit,pr,release -
add_entry repository-rule CODE_STYLE.md code,review -
add_entry repository-guidance ROADMAP.md design,roadmap,release -
add_entry repository-rule .github/pull_request_template.md pr -
add_entry repository-rule .github/CODEOWNERS pr,review -
add_entry repository-rule CODE_OF_CONDUCT.md all -
add_entry repository-rule SECURITY.md code,review,release -
add_entry repository-rule RELEASE.md release -
add_entry repository-rule CHANGELOG.md release -

# Personal rules live only in personal.md beside index.md: one file, each rule
# its own section with its own scope. Other *.md siblings are not personal rules.
# Every recognized repository-owned path above is listed at its conventional
# source location and is never copied in here.
if [ -f "$docs/personal.md" ]; then
  relative="TaskFlowDocs/repository-docs/personal.md"
  have_known "$relative" || add_entry personal-rule "$relative" all local-only
fi

# validate_relative_path — fail before any write on a path that could escape the
# repository. ".." and absolute or drive-qualified paths are rejected outright;
# the resolved parent directory is then checked against the resolved root so a
# symlinked directory cannot smuggle the target outside either.
validate_relative_path() {
  local candidate="$1" dir resolved root_real
  candidate="$(printf '%s' "$candidate" | tr '\\' '/')"
  candidate="$(printf '%s' "$candidate" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  [ -n "$candidate" ] || fail "unsafe repository-document path: '$1'"
  case "$candidate" in
    /*) fail "unsafe repository-document path: '$1'" ;;
    [A-Za-z]:/*) fail "unsafe repository-document path: '$1'" ;;
  esac
  case "/$candidate/" in
    */../*) fail "unsafe repository-document path: '$1'" ;;
  esac
  dir="$(dirname "$candidate")"
  if [ -d "$repo_root/$dir" ]; then
    resolved="$(cd "$repo_root/$dir" && pwd -P)"
    root_real="$(cd "$repo_root" && pwd -P)"
    case "$resolved/" in
      "$root_real"/*) ;;
      *) fail "repository-document path escapes repository: '$1'" ;;
    esac
  fi
}

# --- carry over rows this run does not derive -------------------------------
# A carried-over row keeps its recorded class, phases, and status; a personal
# rule is derived from the live scan above, so a removed one must not survive as
# a stale row.
#
# This reader is deliberately tolerant, because the file it reads is a record
# that every TaskFlow version has written and that a repository may hold from an
# older release. Its purpose is to recover routing context, so a shape it cannot
# recognize costs a session its routing — an unrecognized row is therefore only
# rejected when it cannot be read as a row at all.
#
# Columns are located by the header names, not by position, so every shape
# in the wild parses:
#   * `| Class | Source | Exists | Last checked |` — four columns, no status and
#     no phases (an earlier shape, still in another repository);
#   * `| Class | Source path | Phases | Exists | Last checked | Status |` — seven
#     (this repository until 2026-09-21, TaskFlow 1.0.8 and earlier) or eight;
#   * `| Class | Source path | Phases | Exists | Status |` — six (current).
# A path cell may or may not be backticked, and a status may be a lowercase
# token, a hyphenated token, or a short space-separated label.
#
# Two things stay enforced. A row is rejected when the header names a Status
# column and that cell holds a date, because a row that lost its status cell
# carries a date there and laundering that date into the rendered index is the
# failure this check exists to prevent — a date starts with a digit and never
# reads as a status. A row is also rejected when the header is absent and the row
# cannot be read positionally, which is what keeps a file of malformed rows from
# being accepted as an empty index.
if [ -f "$index" ]; then
  awk -v out="$work/oldrows" '
    BEGIN { FS = "" }
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    # A status is words, not a date or a bare number: the first character has to
    # be a letter, which is what keeps `2026-09-21` from passing as one.
    function isstatus(s) { return s ~ /^[A-Za-z][A-Za-z0-9-]*( [A-Za-z][A-Za-z0-9-]*)*$/ }
    function isdate(s) { return s ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ }
    function istablehead(s) { return s ~ /^\| *---/ }
    /^\|/ {
      if (istablehead($0)) next
      n = split($0, f, "|")
      for (i = 2; i <= n - 1; i++) f[i] = trim(f[i])
      # The first pipe row names the columns when it names both Class and Source.
      # A row that names neither is not a header — it is data, or it is malformed
      # — so the header question is settled once and the row falls through to the
      # positional parse rather than being consumed as a header it is not.
      if (!headseen) {
        headseen = 1
        ci = pi = hi = ei = si = 0
        for (i = 2; i <= n - 1; i++) {
          if (f[i] == "Class") ci = i
          else if (f[i] == "Source" || f[i] == "Source path") pi = i
          else if (f[i] == "Phases") hi = i
          else if (f[i] == "Exists") ei = i
          else if (f[i] == "Status") si = i
        }
        if (ci && pi) { havehead = 1; headn = n; next }
      }
      if (havehead) {
        if (n != headn) { bad++; next }
        kind = f[ci]; path = f[pi]
        phases = hi ? f[hi] : "all"
        exists = ei ? f[ei] : ""
        if (si) {
          status = f[si]
          if (!isstatus(status)) { bad++; next }
        } else {
          status = (exists == "no") ? "optional" : "ready"
        }
      } else {
        # No header to read the shape from, so fall back to the positional form
        # this reader has always accepted.
        if (n < 6 || n > 9) { bad++; next }
        kind = f[2]; path = f[3]; phases = f[4]
        status = f[n - 1]
        if (!isstatus(status)) { bad++; next }
      }
      if (path ~ /^`[^`]+`$/) { gsub(/`/, "", path) }
      if (path == "") { bad++; next }
      # When the header named the columns, the path cell is known rather than
      # guessed, so only a date there is suspect — it means the cells of the row
      # have shifted. The shape heuristic must not run in that case: a one-word path
      # like `LICENSE` is indistinguishable from a status by shape, and rejecting
      # it would drop a real repository document. With no header the cell is a
      # guess, so a date or a status shape there is more likely a shifted cell
      # than a path, and the row is rejected rather than carried over with a
      # wrong path.
      badpath = isdate(path) || (!havehead && isstatus(path))
      if (badpath) { bad++; next }
      print kind "\t" path "\t" phases "\t" status >> out
    }
    END { if (bad) print bad > "/dev/stderr" }
  ' "$index" 2> "$work/badcount" || fail "repository-document index contains an invalid row"
  [ ! -s "$work/badcount" ] || fail "repository-document index contains an invalid row"
  # An index with no recognizable rows (header only) is valid but leaves no file.
  [ -f "$work/oldrows" ] || : > "$work/oldrows"

  while IFS="$(printf '\t')" read -r kind relative phases status; do
    [ -n "$relative" ] || continue
    validate_relative_path "$relative"
    case "$relative" in TaskFlowDocs/repository-docs/*) continue ;; esac
    have_known "$relative" && continue
    add_entry "$kind" "$relative" "$phases" "$status"
  done < "$work/oldrows"
fi

for path in "$repo_root"/*GOVERNANCE*.md; do
  relative="$(basename "$path")"
  have_known "$relative" && continue
  add_entry candidate "$relative" review needs-review
done

# --- derive rows -----------------------------------------------------------
optional_paths=" .github/CODEOWNERS CODE_OF_CONDUCT.md SECURITY.md RELEASE.md CHANGELOG.md "
: > "$work/rows"
phase_matches() {
  [ "$phase" = "all" ] && return 0
  case ",$1," in *",all,"*) return 0 ;; esac
  case ",$1," in *",$phase,"*) return 0 ;; esac
  return 1
}

while IFS="$(printf '\t')" read -r kind relative phases override; do
  [ -n "$relative" ] || continue
  if [ -f "$repo_root/$relative" ]; then exists=yes; else exists=no; fi
  if [ "$override" = "-" ]; then
    if [ "$exists" = yes ]; then
      status=ready
    else
      case "$optional_paths" in *" $relative "*) status=optional ;; *) status=missing ;; esac
    fi
  else
    status="$override"
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$kind" "$relative" "$phases" "$exists" "$status" >> "$work/rows"
done < "$work/entries"

# --- render ----------------------------------------------------------------
{
  printf '# Repository documents\n\n'
  printf 'This index is the authoritative routing and check record for repository documents. The documents at their repository-relative source paths remain authoritative for policy content. Maintain this record first, route by phase from it, then read the routed sources. Do not copy source policy text here.\n\n'
  printf '| Class | Source path | Phases | Exists | Status |\n'
  printf '| --- | --- | --- | --- | --- |\n'
  cut -f1-5 "$work/rows" | awk -F'\t' '{ printf "| %s | `%s` | %s | %s | %s |\n", $1, $2, $3, $4, $5 }'
  printf '\n## Personal rules\n\n'
  printf 'Personal rules live in `TaskFlowDocs/repository-docs/personal.md`: one file, each rule in its own section with its own scope. They are local-only, never committed, and cannot override repository documents.\n'
  if cut -f1 "$work/rows" | grep -qx personal-rule; then
    printf 'Status: present (cataloged in the table above).\n'
  else
    printf 'Status: not present.\n'
  fi
} > "$work/index.new"

# --- write -----------------------------------------------------------------
mkdir -p "$docs"
lock="$docs/index.md.lock"
if ! mkdir "$lock" 2>/dev/null; then
  fail "repository-docs index is busy: $lock"
fi
trap 'rmdir "$lock" 2>/dev/null || true; rm -rf "$work"' EXIT
if [ ! -f "$index" ] || ! cmp -s "$work/index.new" "$index"; then
  temporary="$(mktemp "$docs/index.md.XXXXXX")"
  cat "$work/index.new" > "$temporary"
  mv "$temporary" "$index"
fi

# --- routes ----------------------------------------------------------------
echo "# Repository document routes ($phase)"
[ -n "$task_id" ] && echo "- Current task: TaskFlowDocs/$task_id/"
echo "- Read routing record first: TaskFlowDocs/repository-docs/index.md"
if [ "$phase" = unclassified ]; then
  echo "- Phase is unclear; classify the current work before following phase-specific routes."
fi
list=""
while IFS="$(printf '\t')" read -r kind relative phases exists status; do
  [ "$exists" = yes ] || continue
  [ "$status" = ready ] || continue
  phase_matches "$phases" || continue
  list="$list, $relative"
done < "$work/rows"
[ -z "$list" ] || echo "- Read authoritative sources: ${list#, }"

list=""
while IFS="$(printf '\t')" read -r kind relative phases exists status; do
  [ "$kind" = personal-rule ] || continue
  list="$list, $relative"
done < "$work/rows"
[ -z "$list" ] || echo "- Local personal rules (local-only, never committed; they cannot override the sources above): ${list#, }"

list=""
while IFS="$(printf '\t')" read -r kind relative phases exists status; do
  [ "$exists" = no ] || continue
  [ "$status" = missing ] || continue
  phase_matches "$phases" || continue
  list="$list, $relative"
done < "$work/rows"
[ -z "$list" ] || echo "- Missing catalog entries: ${list#, }"

list=""
while IFS="$(printf '\t')" read -r kind relative phases exists status; do
  [ "$status" = needs-review ] || continue
  list="$list, $relative"
done < "$work/rows"
[ -z "$list" ] || echo "- Needs review before routing: ${list#, }"

echo "- Record applicable paths and incorporated conclusions in the active task plan.md."
