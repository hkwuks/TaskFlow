#!/usr/bin/env bash
# repository-docs-context — synchronize the routing record and print compact routes.
set -euo pipefail

repo_root="${TASKFLOW_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")}"
phase="${TASKFLOW_PHASE:-auto}"
task_id="${TASKFLOW_TASK_ID:-}"
python_cmd="$(bash "$(dirname "$0")/python-runtime")"

"$python_cmd" - "$repo_root" "$phase" "$task_id" <<'PY'
import datetime, os, pathlib, re, sys, tempfile

root = pathlib.Path(sys.argv[1]).resolve()
phase = sys.argv[2].strip().lower()
task_id = sys.argv[3].strip()
docs = root / "TaskFlowDocs" / "repository-docs"
index = docs / "index.md"
today = datetime.date.today().isoformat()

def validate_relative_path(value: str) -> str:
    """Return a repository-relative POSIX path or fail before any write."""
    candidate = value.strip().replace("\\", "/")
    pure = pathlib.PurePosixPath(candidate)
    if (not candidate or pure.is_absolute() or ".." in pure.parts or
            re.match(r"^[A-Za-z]:/", candidate)):
        raise ValueError(f"unsafe repository-document path: {value!r}")
    resolved = (root / pathlib.Path(*pure.parts)).resolve()
    try:
        resolved.relative_to(root)
    except ValueError as exc:
        raise ValueError(f"repository-document path escapes repository: {value!r}") from exc
    return pure.as_posix()

entries = [
    ("repository-guidance", "README.md", "design,roadmap"),
    ("repository-guidance", "README.zh-CN.md", "design,roadmap"),
    ("repository-rule", "LICENSE", "all"),
    ("repository-rule", "CONTRIBUTING.md", "code,commit,pr,release"),
    ("repository-rule", "CODE_STYLE.md", "code,review"),
    ("repository-guidance", "ROADMAP.md", "design,roadmap,release"),
    ("repository-rule", ".github/pull_request_template.md", "pr"),
    ("repository-rule", ".github/CODEOWNERS", "pr,review"),
    ("repository-rule", "CODE_OF_CONDUCT.md", "all"),
    ("repository-rule", "SECURITY.md", "code,review,release"),
    ("repository-rule", "RELEASE.md", "release"),
    ("repository-rule", "CHANGELOG.md", "release"),
]
optional_paths = {
    ".github/CODEOWNERS", "CODE_OF_CONDUCT.md", "SECURITY.md",
    "RELEASE.md", "CHANGELOG.md",
}

if phase == "auto":
    inferred = set()
    plans = []
    if task_id:
        candidate = root / "TaskFlowDocs" / task_id / "plan.md"
        if candidate.is_file():
            plans.append(candidate)
    else:
        plans = list((root / "TaskFlowDocs").glob("20*/plan.md"))
    for plan in plans:
        content = plan.read_text(encoding="utf-8")
        status = next((line.split(":", 1)[1].strip() for line in content.splitlines()
                       if line.startswith("> Status:")), "")
        mapped = {"planning": "design", "ready": "design", "in_progress": "code",
                  "checking": "review"}.get(status)
        if mapped:
            inferred.add(mapped)
    phase = inferred.pop() if len(inferred) == 1 else "unclassified"

# Personal supplements sit directly in repository-docs/, so their identity comes
# from the class column: every recognized repository-owned path above is listed by
# its conventional source location and is never copied in here.
owned = {path for _, path, _ in entries}
for path in sorted(docs.glob("*.md")):
    if path.name == "index.md":
        continue
    relative = path.relative_to(root).as_posix()
    if relative not in owned:
        entries.append(("personal-rule", relative, "all", "local-only"))

known = {entry[1] for entry in entries}
old = index.read_text(encoding="utf-8") if index.exists() else ""
table_rows = [line for line in old.splitlines()
              if line.startswith("|") and not line.startswith(("| ---", "| Class |"))]
parsed_rows = []
for match in re.finditer(r"(?m)^\| ([^|]+) \| `([^`]+)` \| ([^|]+) \| ([^|]+) \| ([^|]+) \| ([^|]+) \|$", old):
    kind, relative, phases, exists, checked, status = (value.strip() for value in match.groups())
    relative = validate_relative_path(relative)
    # Personal rules live beside this record and are derived from the live scan
    # above, so a removed one must not survive as a carried-over stale row.
    if not relative.startswith("TaskFlowDocs/repository-docs/"):
        if relative not in known:
            entries.append((kind, relative, phases, status))
            known.add(relative)
    parsed_rows.append(match.group(0))
if set(table_rows) - set(parsed_rows):
    raise ValueError("repository-document index contains an invalid row")

for path in sorted(root.glob("*GOVERNANCE*.md")):
    relative = path.relative_to(root).as_posix()
    if relative not in known:
        entries.append(("candidate", relative, "review", "needs-review"))

rows = []
for entry in entries:
    kind, relative, phases = entry[:3]
    exists = (root / relative).is_file()
    status = entry[3] if len(entry) == 4 else (
        "ready" if exists else ("optional" if relative in optional_paths else "missing"))
    rows.append((kind, relative, phases, "yes" if exists else "no", today, status))

text = """# Repository documents

> Last checked: {today}

This index is the authoritative routing and check record for repository documents. The documents at their repository-relative source paths remain authoritative for policy content. Maintain this record first, route by phase from it, then read the routed sources. Do not copy source policy text here.

| Class | Source path | Phases | Exists | Last checked | Status |
| --- | --- | --- | --- | --- | --- |
{rows}

## Personal rules

{personal}
""".format(
    today=today,
    rows="\n".join(f"| {k} | `{p}` | {ph} | {ex} | {checked} | {status} |"
                     for k, p, ph, ex, checked, status in rows),
    personal=("Cataloged above when present; they are local-only and never committed."
              if any(r[0] == "personal-rule" for r in rows) else "None."),
)

docs.mkdir(parents=True, exist_ok=True)
lock = docs / "index.md.lock"
try:
    lock.mkdir()
except FileExistsError:
    raise SystemExit(f"repository-docs index is busy: {lock}")
try:
    if old != text:
        fd, temporary = tempfile.mkstemp(dir=docs, prefix="index.md.", suffix=".tmp")
        try:
            with os.fdopen(fd, "w", encoding="utf-8", newline="") as stream:
                stream.write(text)
            os.replace(temporary, index)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
finally:
    lock.rmdir()

selected = [row for row in rows if row[3] == "yes" and
            row[5] == "ready" and
            (phase == "all" or "all" in row[2].split(",") or phase in row[2].split(","))]
personal = [row[1] for row in rows if row[0] == "personal-rule"]
missing = [row[1] for row in rows if row[3] == "no" and row[5] == "missing" and
           (phase == "all" or "all" in row[2].split(",") or phase in row[2].split(","))]
print(f"# Repository document routes ({phase})")
if task_id:
    print(f"- Current task: TaskFlowDocs/{task_id}/")
print("- Read routing record first: TaskFlowDocs/repository-docs/index.md")
if phase == "unclassified":
    print("- Phase is unclear; classify the current work before following phase-specific routes.")
if selected:
    print("- Read authoritative sources: " + ", ".join(row[1] for row in selected))
if personal:
    print("- Local personal rules (local-only, never committed; they cannot override the sources above): "
          + ", ".join(personal))
if missing:
    print("- Missing catalog entries: " + ", ".join(missing))
review = [row[1] for row in rows if row[5] == "needs-review"]
if review:
    print("- Needs review before routing: " + ", ".join(review))
print("- Record applicable paths and incorporated conclusions in the active task plan.md.")
PY
