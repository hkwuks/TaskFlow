#!/usr/bin/env bash
# The caller supplies a new fixture directory; no existing files are removed.
set -euo pipefail
[ "$#" -eq 1 ] || { echo 'usage: test-remote-todo <new-fixture-directory>' >&2; exit 1; }
fixture="$1"
[ ! -e "$fixture" ] || { echo 'fixture already exists' >&2; exit 1; }
mkdir -p "$fixture/TaskFlowDocs"
fixture="$(cd "$fixture" && pwd -P)"
HERE="$(cd "$(dirname "$0")" && pwd)"
remote="$HERE/remote-todo"
mode() { bash "$remote" mode --root "$fixture"; }
validate() { bash "$remote" validate --root "$fixture"; }
reject() { if "$@" >/dev/null 2>&1; then echo 'FAIL expected refusal' >&2; exit 1; fi; }
[ "$(mode)" = local ] || { echo 'FAIL missing config must default to local' >&2; exit 1; }
printf 'remote\nwork\tgithub\tgithub.com\towner/repo\nlab\tgitlab\tgit.example.org\tgroup/sub/repo\n' > "$fixture/TaskFlowDocs/remote-todos.conf"
[ "$(mode)" = remote ] || { echo 'FAIL remote mode' >&2; exit 1; }
validate >/dev/null
printf 'remote\nwork\tgithub\tgithub.com\towner/repo\nwork\tgitlab\tgitlab.com\tgroup/repo\n' > "$fixture/TaskFlowDocs/remote-todos.conf"
reject validate
printf 'remote\nwork\tgithub\tuser:password@github.com\towner/repo\n' > "$fixture/TaskFlowDocs/remote-todos.conf"
reject validate
printf 'remote\nwork\tgithub\tgithub.com\towner/repo?token=secret\n' > "$fixture/TaskFlowDocs/remote-todos.conf"
reject validate
printf 'remote\nwork\tgithub\tgithub.com\towner/repo\ninvalid\n' > "$fixture/TaskFlowDocs/remote-todos.conf"
reject validate
echo 'PASS remote todo config'