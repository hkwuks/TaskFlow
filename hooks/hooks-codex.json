{
  "description": "TaskFlow lifecycle hooks: SessionStart state summary, per-prompt in-flight task reminder, and the pre-write capability gate (Codex CLI plugin form).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/session-start\"",
            "commandWindows": "cmd.exe /d /c call \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" session-start"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/capability-evidence\"",
            "commandWindows": "cmd.exe /d /c call \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" capability-evidence"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/prompt-reminder\"",
            "commandWindows": "cmd.exe /d /c call \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" prompt-reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/capability-gate\"",
            "commandWindows": "cmd.exe /d /c call \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" capability-gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/capability-evidence\"",
            "commandWindows": "cmd.exe /d /c call \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" capability-evidence"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/base-status-reminder\"",
            "commandWindows": "cmd.exe /d /c call \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" base-status-reminder",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/external-evidence\"",
            "commandWindows": "cmd.exe /d /c call \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" external-evidence"
          }
        ]
      }
    ]
  }
}
