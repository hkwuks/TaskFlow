{
  "description": "TaskFlow lifecycle hooks: SessionStart state summary (Codex CLI plugin form).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/session-start\"",
            "commandWindows": "\"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" session-start"
          }
        ]
      }
    ]
  }
}
