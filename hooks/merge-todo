#!/usr/bin/env bash
# merge-todo — resolve TaskFlowDocs/todo.md by Todo entry instead of by line.
#
# Installed as the `taskflow-todo` merge driver for `TaskFlowDocs/todo.md` (see
# `.gitattributes`). Git invokes it with three paths in this order: the common
# ancestor (%O), our version (%A), and their version (%B). The driver must leave
# the resolution in %A and exit 0; a nonzero exit tells Git the merge failed.
#
# Scope: this is not a general three-way merge. It answers the one case that
# actually occurs — two branches each added a Todo entry, or touched different
# entries — and refuses the rest.
#
# Rules:
#   * The preamble before the first `## ` heading comes from ours.
#   * An entry is identified by its `- ID:` value's first whitespace token, or
#     by its heading when it has no ID yet. Entries are matched by that key,
#     not by position. `## Removed` is always keyed `head:Removed` so the
#     tombstone block matches across sides regardless of which record is first.
#   * An entry present on only one side is taken from that side — unless the
#     other side's `## Removed` names that ID, in which case the deletion wins
#     and the lone live copy is not emitted (a tombstone is not a second entry).
#   * An entry both sides have, byte-identical, is taken once.
#   * An entry only one side changed relative to the ancestor is taken from that
#     side — this is the ordinary case, two branches each touching their own entry.
#   * Two different `## Removed` bodies are unioned by tombstone ID, not
#     conflicted: parallel removes are ordinary.
#   * An entry both sides changed differently is a real conflict: rewrite %A with
#     Git conflict markers and exit 1, so `git merge` reports it.
#   * Order is ours, then the entries only theirs, appended, so a merge cannot
#     reorder entries the user already sees.
#
# The ancestor is consulted only to tell "we changed it" from "they did". A live
# Todo entry disappears only by moving into `## Removed` (hooks/task remove);
# that move must survive a merge rather than resurrect on the other side.
#
# ONE awk PROCESS, DELIBERATELY. The first implementation split the three sides
# and then answered every lookup with a `grep | head | cut` pipeline, so a
# 125-entry file cost roughly a thousand process starts. Measured 2026-11-04 on
# Windows/Git Bash: 154-227 seconds for one merge, against ~150 ms per process.
# That is not merely slow — it is long enough for a caller to time the merge out,
# and an interrupted run leaves %A exactly as Git handed it over, so `git merge`
# reports success with one side's file and no driver result. Measured on PR #117:
# that merge commit's todo.md was byte-identical to the ours side. The rules
# above are therefore evaluated in memory, over one pass per side.
#
# WRITE ONCE, AT THE END. The result is built beside %A and copied over only
# after the whole decision is made, so a run that dies partway leaves %A holding
# Git's original content. A nonzero exit then tells Git the merge failed, which
# is the honest report; a half-written %A is the silent one. The conflict case is
# the exception the format requires: the markers go into %A and the exit code
# says the merge needs a human.
#
# Extensionless, like every other TaskFlow hook, so Claude Code Windows
# auto-detection never interferes.

set -euo pipefail
LC_ALL=C
export LC_ALL

# Git passes them in this order: ancestor, ours, theirs.
[ "$#" -eq 3 ] || { echo "usage: merge-todo <ancestor> <ours> <theirs>" >&2; exit 2; }
base="$1"; ours="$2"; theirs="$3"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
result="$work/result"
flag="$work/conflict"

# One pass per side, no subprocesses. Sides are read in the order base, ours,
# theirs, so FNR==1 marks a new side.
#
# Every index is one flat array keyed `side SUBSEP key`. The 2-D spelling
# `idx[side, key]` is the same array, but `k in idx[side]` — which the first
# draft of this file used — names a *slice* no awk implements, and gawk aborts
# the whole merge with "attempt to use a scalar value as array". SUBSEP is what
# makes that membership test expressible in POSIX awk.
#
# The separator between records is `\n\n` after a body whose trailing newlines
# were stripped — how the previous implementation's emit() normalized it.
awk -v ofile="$result" -v flagfile="$flag" '
  function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }

  # The first `- ID:` value in a record, as its first whitespace token. A
  # tombstone line is `- ID: TF-x (removed …)`, so taking the first token is what
  # lets a deletion match the live entry it replaces.
  #
  # The separator is `[ \t\r\n]+`, not `[ \t]+`: a whole record is passed in, so
  # the ID is followed by a newline, and a token split that ignores newlines
  # returns `TF-x\n-` — an ID that matches nothing, including its own tombstone.
  function first_id(text,   t, p, v, a) {
    t = text
    while ((p = index(t, "- ID:")) > 0) {
      t = substr(t, p + 1)
      v = trim(substr(t, 6))
      if (v != "") { split(v, a, /[ \t\r\n]+/); return a[1] }
    }
    return ""
  }

  function flush(s) {
    if (n[s] == 0) return
    body[s, n[s]] = buf[s]
    sub(/\n+$/, "", body[s, n[s]])
  }

  # `hk` arrives already prefixed (`"head:" heading`), because that is the shape
  # the heading index stores. Prefixing it again would key every lookup to
  # `head:head:…` and silently match nothing.
  function match_of(k, hk) {
    if ((3 SUBSEP k) in kidx) return kidx[3 SUBSEP k]
    if ((3 SUBSEP hk) in hidx) return hidx[3 SUBSEP hk]
    return 0
  }
  function base_of(k, hk) {
    if ((1 SUBSEP k) in kidx) return kidx[1 SUBSEP k]
    if ((1 SUBSEP hk) in hidx) return hidx[1 SUBSEP hk]
    return 0
  }
  function id_of(k) { return (substr(k, 1, 3) == "id:") ? substr(k, 4) : "" }
  function emit(text) { printf "%s\n\n", text > ofile }

  # A new side starts at FNR==1, but the line itself still belongs to it: it is
  # either the first line of the preamble or a `## ` heading. Taking `next` here
  # would drop the first line of every side, and this file opens with
  # `## Item template`, so that one line is the whole template heading. The
  # previous side is flushed first, or its last entry is dropped the same way.
  FNR == 1 {
    if (side > 0) flush(side)
    side++
    n[side] = 0
    pre[side] = ""
    buf[side] = ""
  }
  /^## / {
    flush(side)
    n[side]++
    h = $0
    sub(/^##[ \t]*/, "", h)
    h = trim(h)
    head[side, n[side]] = h
    # `## Removed` is one section holding every tombstone, so it never keys off
    # its first record: always the literal heading key.
    ekey[side, n[side]] = (h == "Removed") ? "head:Removed" : "id:" first_id($0)
    buf[side] = $0 "\n"
    next
  }
  {
    if (n[side] == 0) pre[side] = pre[side] $0 "\n"
    else              buf[side] = buf[side] $0 "\n"
  }

  END {
    flush(side)
    # A heading line cannot carry an ID, so a key that came out as bare "id:" is
    # resolved from the body now that the whole record is known. Falling back to
    # the heading is what keeps an entry without an ID matchable at all.
    for (s = 1; s <= 3; s++) {
      for (i = 1; i <= n[s]; i++) {
        k = ekey[s, i]
        if (k == "id:") {
          k = first_id(body[s, i])
          ekey[s, i] = (k != "") ? "id:" k : "head:" head[s, i]
        }
      }
    }

    for (s = 1; s <= 3; s++) {
      for (i = 1; i <= n[s]; i++) {
        k = ekey[s, i]
        if (!((s SUBSEP k) in kidx)) kidx[s SUBSEP k] = i
        hk = "head:" head[s, i]
        if (!((s SUBSEP hk) in hidx)) hidx[s SUBSEP hk] = i
      }
      # Tombstone IDs on this side, for the "deletion wins" rule. Every `- ID:`
      # in the section, because one `## Removed` holds all of them.
      for (i = 1; i <= n[s]; i++) {
        if (head[s, i] != "Removed") continue
        t = body[s, i]
        while ((p = index(t, "- ID:")) > 0) {
          t = substr(t, p + 1)
          v = trim(substr(t, 6))
          if (v == "") continue
          split(v, a, /[ \t\r\n]+/)
          tomb[s SUBSEP a[1]] = 1
        }
      }
    }

    printf "%s", pre[2] > ofile
    conflict = 0

    for (i = 1; i <= n[2]; i++) {
      k = ekey[2, i]
      hk = "head:" head[2, i]
      j = match_of(k, hk)
      if (j == 0) {
        # Only we have it: we added it, or they removed it. Deletion wins — a
        # live copy whose ID sits in their `## Removed` must not come back.
        id = id_of(k)
        if (id != "" && ((3 SUBSEP id) in tomb)) continue
        emit(body[2, i])
        continue
      }
      if (body[2, i] == body[3, j]) { emit(body[2, i]); continue }
      b = base_of(k, hk)
      if (hk == "head:Removed") {
        if (b != 0 && body[2, i] == body[1, b]) { emit(body[3, j]); continue }
        if (b != 0 && body[3, j] == body[1, b]) { emit(body[2, i]); continue }
        # Both sides added or edited tombstones: union by ID under our heading,
        # which is not a conflict — parallel removes are ordinary.
        out = body[2, i]
        t = body[3, j]
        while ((p = index(t, "- ID:")) > 0) {
          t = substr(t, p + 1)
          line = t
          q = index(t, "\n")
          if (q > 0) line = substr(t, 1, q - 1)
          v = trim(substr(line, 6))
          if (v == "") continue
          split(v, a, /[ \t\r\n]+/)
          if (!((2 SUBSEP a[1]) in tomb)) out = out "\n" line
        }
        emit(out)
        continue
      }
      if (b != 0 && body[2, i] == body[1, b]) { emit(body[3, j]); continue }
      if (b != 0 && body[3, j] == body[1, b]) { emit(body[2, i]); continue }
      # Both sides changed this record, or it is new on both sides under one
      # key. Report it the way Git would, so the normal conflict-review workflow
      # applies instead of a silent pick.
      conflict = 1
      printf "<<<<<<< ours\n%s\n=======\n%s\n>>>>>>> theirs\n\n", body[2, i], body[3, j] > ofile
    }

    for (i = 1; i <= n[3]; i++) {
      k = ekey[3, i]
      hk = "head:" head[3, i]
      if (((2 SUBSEP k) in kidx) || ((2 SUBSEP hk) in hidx)) continue
      id = id_of(k)
      if (id != "" && ((2 SUBSEP id) in tomb)) continue
      emit(body[3, i])
    }

    close(ofile)
    printf "%d\n", conflict > flagfile
    close(flagfile)
  }
' "$base" "$ours" "$theirs"

# One write, after the decision: a run that died above left %A as Git gave it,
# and this line never ran.
cp "$result" "$ours"
# The markers are in %A now, so the caller's conflict-review path applies; the
# nonzero exit is what makes `git merge` report the conflict at all.
[ "$(cat "$flag")" = "0" ]
