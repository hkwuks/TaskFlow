#!/usr/bin/env bash
set -euo pipefail
[ "$#" -eq 1 ] || { echo 'usage: test-remote-todo-detach-task <new-fixture-directory>' >&2; exit 1; }
fixture="$1"
[ ! -e "$fixture" ] || { echo 'fixture already exists' >&2; exit 1; }
mkdir -p "$fixture/TaskFlowDocs/2026-11-16-demo" "$fixture/TaskFlowDocs/remote-todo-links" "$fixture/bin" "$fixture/tmp"
fixture="$(cd "$fixture" && pwd -P)"
HERE="$(cd "$(dirname "$0")" && pwd)"
printf 'remote\nmain\tgithub\tgithub.com\towner/repo\n' > "$fixture/TaskFlowDocs/remote-todos.conf"
printf 'github\tgithub.com\towner/repo\t17\n' > "$fixture/TaskFlowDocs/2026-11-16-demo/remote-issue"
printf 'pending\t0123456789abcdef0123456789abcdef\tgithub\tgithub.com\towner/repo\nconfirmed\t17\nstage-synced\tplanning\n' > "$fixture/TaskFlowDocs/remote-todo-links/TF-20261116-abcdef"
printf '# PRD\n> Task version: v1\n> Status: planning\n' > "$fixture/TaskFlowDocs/2026-11-16-demo/prd.md"
printf '# Plan\n> Task version: v1\n> Status: planning\n' > "$fixture/TaskFlowDocs/2026-11-16-demo/plan.md"
printf '## Task\n- ID: TF-20261116-abcdef\n- Status: promoted\n- Updated: 2026-11-16\n- Goal: Original goal\n- Task: `TaskFlowDocs/2026-11-16-demo/`\n' > "$fixture/TaskFlowDocs/todo.md"
cat > "$fixture/bin/gh" <<'EOF'
#!/usr/bin/env bash
case "${2:-}" in
  *'/labels?per_page=100') printf '%s\n' "$*" | sed -n 's/.*\.name == "\([^"]*\)".*/\1/p'; exit 0 ;;
esac
case " $* " in *' --method '*) echo 'unexpected remote mutation' >&2; exit 1 ;; esac
printf '%s\n' '{"number":17,"title":"Latest remote title","body":"Latest remote description","state":"open","created_at":"2026-01-02T00:00:00Z","labels":["taskflow:planning"]}'
EOF
chmod +x "$fixture/bin/gh"
if PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" migrate-to-local main 17 --root "$fixture" >/dev/null 2>&1; then echo 'FAIL implicit task detach'; exit 1; fi
PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" migrate-to-local main 17 --detach --root "$fixture" > "$fixture/out"
grep -q 'Original goal' "$fixture/TaskFlowDocs/todo.md" || { echo 'FAIL original task entry lost'; exit 1; }
grep -q 'Latest remote description' "$fixture/TaskFlowDocs/remote-todo-links/task-2026-11-16-demo-copy.md" || { echo 'FAIL missing task copy'; exit 1; }
printf 'other\tgithub\tGITHUB.COM\tOWNER/REPO\n' >> "$fixture/TaskFlowDocs/remote-todos.conf"
PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" migrate-to-local other 17 --detach --root "$fixture" >/dev/null || { echo 'FAIL case variant did not match detached Issue'; exit 1; }
[ -f "$fixture/TaskFlowDocs/remote-todo-links/task-2026-11-16-demo.detached" ] || { echo 'FAIL missing task detach'; exit 1; }
grep -q "$(printf 'detached-task\t2026-11-16-demo')" "$fixture/TaskFlowDocs/remote-todo-links/TF-20261116-abcdef.detached" || { echo 'FAIL missing Todo detach'; exit 1; }
PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" list --root "$fixture" > "$fixture/list"
grep -q 'Original goal' "$fixture/list" || { echo 'FAIL detached local task hidden'; exit 1; }
mkdir -p "$fixture/TaskFlowDocs/2026-11-16-other"
printf '# PRD\n' > "$fixture/TaskFlowDocs/2026-11-16-other/prd.md"
printf '# Plan\n' > "$fixture/TaskFlowDocs/2026-11-16-other/plan.md"
PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" link main 17 2026-11-16-other --root "$fixture" > "$fixture/relink" || { echo 'FAIL detached issue could not link to another task'; exit 1; }
PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" migrate-to-local main 17 --detach --root "$fixture" > "$fixture/detach-other" || { echo 'FAIL cannot detach active task after previous detachment'; exit 1; }
[ -f "$fixture/TaskFlowDocs/remote-todo-links/task-2026-11-16-other.detached" ] || { echo 'FAIL wrong task detached'; exit 1; }
cat > "$fixture/bin/gh" <<'EOF'
#!/usr/bin/env bash
case "${2:-}" in
  *'/labels?per_page=100') printf '%s\n' "$*" | sed -n 's/.*\.name == "\([^"]*\)".*/\1/p'; exit 0 ;;
esac
exit 1
EOF
chmod +x "$fixture/bin/gh"
PATH="$fixture/bin:$PATH" TMPDIR="$fixture/tmp" bash "$HERE/task" state 2026-11-16-demo planning --root "$fixture" > "$fixture/state-out" || { echo 'FAIL detached task still required remote'; exit 1; }
grep -q '^> Status: planning' "$fixture/TaskFlowDocs/2026-11-16-demo/prd.md" || { echo 'FAIL local task state'; exit 1; }
second="$fixture/local-only"
mkdir -p "$second/TaskFlowDocs/2026-11-16-demo" "$second/TaskFlowDocs/remote-todo-links" "$second/tmp"
printf 'github\tgithub.com\towner/repo\t17\n' > "$second/TaskFlowDocs/2026-11-16-demo/remote-issue"
printf 'detached\tgithub\tgithub.com\towner/repo\t17\n' > "$second/TaskFlowDocs/remote-todo-links/task-2026-11-16-demo.detached"
printf '# PRD\n> Task version: v1\n> Status: planning\n' > "$second/TaskFlowDocs/2026-11-16-demo/prd.md"
printf '# Plan\n> Task version: v1\n> Status: planning\n' > "$second/TaskFlowDocs/2026-11-16-demo/plan.md"
printf '## Task\n- ID: TF-20261116-abcdef\n- Status: promoted\n- Updated: 2026-11-16\n- Goal: Local\n- Task: `TaskFlowDocs/2026-11-16-demo/`\n' > "$second/TaskFlowDocs/todo.md"
PATH="$fixture/bin:$PATH" TMPDIR="$second/tmp" bash "$HERE/task" state 2026-11-16-demo planning --root "$second" >/dev/null || { echo 'FAIL detached task needs remote config'; exit 1; }
printf 'remote\nmain\tgithub\tgithub.com\towner/repo\n' > "$second/TaskFlowDocs/remote-todos.conf"
printf 'pending\t0123456789abcdef0123456789abcdef\tgithub\tgithub.com\towner/repo\nconfirmed\t17\nstage-synced\tplanning\n' > "$second/TaskFlowDocs/remote-todo-links/TF-20261116-abcdef"
printf 'detached-task\t2026-11-16-demo\n' > "$second/TaskFlowDocs/remote-todo-links/TF-20261116-abcdef.detached"
cat > "$fixture/bin/gh" <<'EOF'
#!/usr/bin/env bash
case " $* " in *' --method '*) echo 'unexpected remote mutation' >&2; exit 1 ;; esac
printf '{"number":17,"title":"Remote","body":"new body","created_at":"2026-01-02T00:00:00Z","state":"open","labels":["taskflow:%s"]}\n' "${REMOTE_PHASE:-planning}"
EOF
chmod +x "$fixture/bin/gh"
mkdir -p "$fixture/TaskFlowDocs/2026-11-16-third"
printf 'github\tgithub.com\towner/repo\t17\n' > "$fixture/TaskFlowDocs/2026-11-16-third/remote-issue"
if PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" reattach-task 2026-11-16-demo --root "$fixture" > "$fixture/reattach-conflict" 2>&1; then echo 'FAIL reattached an Issue already linked elsewhere'; exit 1; fi
grep -qi 'another task' "$fixture/reattach-conflict" || { echo 'FAIL missing association conflict'; exit 1; }
if PATH="$fixture/bin:$PATH" REMOTE_PHASE=ready bash "$HERE/remote-todo" reattach-task 2026-11-16-demo --root "$second" > "$fixture/reattach-mismatch" 2>&1; then echo 'FAIL reattached differing phases'; exit 1; fi
[ -f "$second/TaskFlowDocs/remote-todo-links/task-2026-11-16-demo.detached" ] || { echo 'FAIL phase mismatch lost detachment'; exit 1; }
mkdir "$second/TaskFlowDocs/remote-todo-links/.lock-TF-20261116-abcdef"
if PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" reattach-task 2026-11-16-demo --root "$second" > "$fixture/reattach-busy" 2>&1; then echo 'FAIL reattached while Todo locked'; exit 1; fi
[ -d "$second/TaskFlowDocs/remote-todo-links/.lock-TF-20261116-abcdef" ] || { echo 'FAIL removed another operation lock'; exit 1; }
rmdir "$second/TaskFlowDocs/remote-todo-links/.lock-TF-20261116-abcdef"
printf '# Old copy\n- Source: https://github.com/owner/repo/issues/17\n    old body\n    <!-- taskflow-copy-complete:task-2026-11-16-demo -->\n' > "$second/TaskFlowDocs/remote-todo-links/task-2026-11-16-demo-copy.md"
PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" reattach-task 2026-11-16-demo --root "$second" > "$fixture/reattach" || { echo 'FAIL could not reattach task'; exit 1; }
[ ! -e "$second/TaskFlowDocs/remote-todo-links/task-2026-11-16-demo.detached" ] || { echo 'FAIL task remains detached'; exit 1; }
compgen -G "$second/TaskFlowDocs/remote-todo-links/task-2026-11-16-demo.detached.history-*" >/dev/null || { echo 'FAIL detach history lost'; exit 1; }
[ ! -e "$second/TaskFlowDocs/remote-todo-links/TF-20261116-abcdef.detached" ] || { echo 'FAIL Todo mapping remains detached'; exit 1; }
compgen -G "$second/TaskFlowDocs/remote-todo-links/TF-20261116-abcdef.detached.history-*" >/dev/null || { echo 'FAIL Todo detach history lost'; exit 1; }
if PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" stage-task 2026-11-16-demo planning --root "$second" > "$fixture/resync" 2>&1; then echo 'FAIL reattached task did not attempt remote synchronization'; exit 1; fi
grep -qi 'unknown' "$fixture/resync" || { echo 'FAIL remote update attempt not reported'; exit 1; }
PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" migrate-to-local main 17 --detach --root "$second" >/dev/null || { echo 'FAIL repeat detach'; exit 1; }
grep -q 'new body' "$second/TaskFlowDocs/remote-todo-links/task-2026-11-16-demo-copy.md" || { echo 'FAIL repeat detach did not refresh copy'; exit 1; }
[ -f "$second/TaskFlowDocs/remote-todo-links/TF-20261116-abcdef.detached" ] || { echo 'FAIL repeat detach did not detach Todo mapping'; exit 1; }
compgen -G "$second/TaskFlowDocs/remote-todo-links/task-2026-11-16-demo-copy.md.history-*" >/dev/null || { echo 'FAIL previous copy not retained'; exit 1; }
lab="$fixture/lab"
mkdir -p "$lab/TaskFlowDocs/2026-11-16-demo" "$lab/TaskFlowDocs/remote-todo-links"
printf 'remote\nlab\tgitlab\tgit.example.org\tgroup/repo\n' > "$lab/TaskFlowDocs/remote-todos.conf"
printf 'gitlab\tgit.example.org\tgroup/repo\t19\n' > "$lab/TaskFlowDocs/2026-11-16-demo/remote-issue"
printf 'detached\tgitlab\tgit.example.org\tgroup/repo\t19\n' > "$lab/TaskFlowDocs/remote-todo-links/task-2026-11-16-demo.detached"
printf '# PRD\n> Status: planning\n' > "$lab/TaskFlowDocs/2026-11-16-demo/prd.md"
printf '# Plan\n> Status: planning\n' > "$lab/TaskFlowDocs/2026-11-16-demo/plan.md"
cat > "$fixture/bin/glab" <<'EOF'
#!/usr/bin/env bash
case "$2" in *group%2Frepo/issues/19) ;; *) exit 1 ;; esac
printf '%s\n' '{"iid":19,"state":"opened","labels":["taskflow:planning"]}'
EOF
chmod +x "$fixture/bin/glab"
PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" reattach-task 2026-11-16-demo --root "$lab" > "$fixture/reattach-lab" || { echo 'FAIL GitLab reattachment'; exit 1; }
[ ! -e "$lab/TaskFlowDocs/remote-todo-links/task-2026-11-16-demo.detached" ] || { echo 'FAIL GitLab task remains detached'; exit 1; }
echo 'PASS remote todo task detach'