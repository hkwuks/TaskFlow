#!/usr/bin/env bash
# archive — full archive transaction for one TaskFlow task (cross-platform).
# Usage: archive <task-id> [root]
# Moves TaskFlowDocs/<task-id> -> TaskFlowDocs/achieved/<task-id>, updates the
# linked Todo item's Task: path and Status to done, then verifies:
#   active path absent | achieved path exists | achieved root PRD+Plan completed
# Approval is never touched. On any failure the directory move and the Todo
# rewrite are undone when they had already started; exit 1.
# Git is never invoked: on success the script prints the exact stage lines and
# states that the archive commit belongs on the current branch.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
task="$1"; root="${2:-$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")}"
# Before the name is joined into a path, not after: every check below is a test
# on `$docs/$task`, so a name carrying `..` is answered by the join rather than
# by this script. The `mv` at the end is the one that can carry a directory from
# outside this repository into `achieved/`.
bash "$HERE/task-id" "$task" || exit 1
docs="$root/TaskFlowDocs"
[ -d "$docs/$task" ] || { echo "no active task $docs/$task"; exit 1; }
[ ! -e "$docs/achieved/$task" ] || { echo "achieved/$task already exists"; exit 1; }

# 1. authoritative completion must already be recorded by the Agent
grep -q '> Status: completed' "$docs/$task/prd.md" || { echo "prd.md not completed"; exit 1; }
grep -q '> Status: completed' "$docs/$task/plan.md" || { echo "plan.md not completed"; exit 1; }

todo="$docs/todo.md"
[ -f "$todo" ] || { echo "todo.md missing; archive not started"; exit 1; }
if ! grep -q "\`TaskFlowDocs/$task/\`" "$todo"; then
  echo "Todo entry for $task missing; archive not started"; exit 1
fi

# Undo whatever step 2–4 already did, so a failure never leaves active and
# achieved both present, a half-rewritten Todo beside a moved directory, or a
# Todo record appended to a Plan whose entry is about to come back.
#   * the entry was compacted to the fields triage still needs; whatever prose it
#     carried is on the achieved Plan under `## Todo Record`.
# A moved directory, a compacted entry, and a Plan that never received the prose
# are the one combination that must not survive a failure.
rollback() {  # rollback <moved> <todo-bak> <plan-bak>
  local moved="$1" bak="$2" planbak="${3:-}"
  if [ "$moved" = "1" ] && [ -d "$docs/achieved/$task" ] && [ ! -d "$docs/$task" ]; then
    mv "$docs/achieved/$task" "$docs/$task" || true
  fi
  if [ -n "$planbak" ] && [ -f "$planbak" ]; then
    cp "$planbak" "$docs/$task/plan.md" || true
  fi
  if [ -n "$bak" ] && [ -f "$bak" ]; then
    mv "$bak" "$todo" || true
  fi
}

# 2. move whole dir
[ -d "$docs/achieved" ] || mkdir -p "$docs/achieved"
moved=0
todo_bak="$(mktemp "$docs/.taskflow-archive.XXXXXX")"
cp "$todo" "$todo_bak"
if ! mv "$docs/$task" "$docs/achieved/$task"; then
  rm -f "$todo_bak"
  echo "archive FAILED: could not move $docs/$task"
  exit 1
fi
moved=1

# 3. move the entry's prose into the achieved Plan, then compact the entry.
#
#    A done entry was 78% of this file, and most of that was prose an Agent
#    accumulated while working the task: Notes, and continuation lines under
#    other fields. The prose is not a duplicate of the achieved documents —
#    measured over 195 sentences, 2 appear verbatim in the archived Plan — so it
#    is moved, never dropped, and only once the destination exists.
#
#    The destination is `## Todo Record` in the achieved plan.md. Appending is
#    idempotent: an existing section is not appended to again.
prose_tmp="$(mktemp "$docs/.taskflow-archive-prose.XXXXXX")"
plan="$docs/achieved/$task/plan.md"
plan_bak=""
if [ -f "$plan" ]; then
  plan_bak="$(mktemp "$docs/.taskflow-archive-plan.XXXXXX")"
  cp "$plan" "$plan_bak"
fi

# 4. rewrite the entry: keep the heading and the fields triage still needs,
#    and nothing else. `- Notes:` contributes its own value as well as its
#    continuation lines — that value is where most of the prose lives.
if ! awk -v task="$task" -v next_action='None — completed and archived.' -v prosek="$prose_tmp" '
  function ltrim(s) { sub(/^[[:space:]]+/, "", s); return s }
  function rtrim(s) { sub(/[[:space:]]+$/, "", s); return s }
  function trim(s) { return rtrim(ltrim(s)) }
  function is_blank(s) { return s ~ /^[[:space:]]*$/ }
  # A field line is "- Name:"; Notes continuation bullets are "- " too, which is
  # why the closing colon is required. The same rule `hooks/task` uses.
  function fieldname(s,   n) { n = index(s, ":"); return substr(s, 3, n - 3) }
  { n++; line[n] = $0 }
  END {
    needle = "`TaskFlowDocs/" task "/`"
    found = 0
    for (i = 1; i <= n; i++) {
      if (index(line[i], "## ") == 1) start = i
      if (index(line[i], needle)) { found = 1; break }
    }
    if (!found) { for (i = 1; i <= n; i++) print line[i]; exit 0 }
    finish = n + 1
    for (i = start + 1; i <= n; i++) {
      if (index(line[i], "## ") == 1) { finish = i; break }
    }

    idv = ""; goalv = ""
    for (i = start + 1; i < finish; i++) {
      if (index(line[i], "- ID:") == 1 && idv == "") idv = trim(substr(line[i], 6))
      if (index(line[i], "- Goal:") == 1 && goalv == "") goalv = trim(substr(line[i], 8))
    }
    # Entries written before the ID field existed carry it in the heading only,
    # which is also why `task get` could not find them. Two safeguards, both
    # learned from the archive that already exists:
    #   * the ID must not already belong to another entry. Seven heading IDs in
    #     this repository history collide with the real ID of a later entry,
    #     because the old numbering ran per day-of-work and was reused —
    #     backfilling those would make `task get` address the wrong entry;
    #   * the heading is checked against the pattern rather than guessed, so a
    #     section that is not an entry (`## Item template`) gains no ID.
    if (idv == "") {
      h = trim(substr(line[start], 3))
      if (match(h, /^(TF|T)-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9A-Za-z-]+/)) {
        cand = substr(h, 1, RLENGTH)
        # Scanned across the whole file, not just this entry: the collision that
        # matters is with the real ID of a *different* entry.
        taken = 0
        for (i = 1; i <= n; i++) if (index(line[i], "- ID: " cand) == 1) taken = 1
        if (!taken) idv = cand
      }
    }

    # Prose: for every field block, the non-blank lines that are not field
    # lines, plus the `- Notes:` value itself because that is where most of the
    # prose sits. Written straight out in its destination shape — a tab-separated
    # round trip would have had to survive newlines inside a field, which it does
    # not, and a block that is already markdown needs no re-encoding.
    np = 0; cur = 0; curname = ""
    for (i = start + 1; i < finish; i++) {
      if (line[i] ~ /^- [A-Za-z][A-Za-z ]*:/) {
        curname = fieldname(line[i])
        cur = 0
        if (curname == "Notes") {
          v = trim(substr(line[i], index(line[i], ":") + 1))
          if (v != "") { np++; plabel[np] = curname; ptext[np] = "- " v; cur = np }
        }
        continue
      }
      if (is_blank(line[i])) continue
      if (cur == 0) { np++; plabel[np] = curname; ptext[np] = line[i]; cur = np }
      else { ptext[cur] = ptext[cur] "\n" line[i] }
    }
    for (i = 1; i <= np; i++) printf "\n### \140- %s:\140\n\n%s\n", plabel[i], ptext[i] > prosek
    close(prosek)

    for (i = 1; i <= start; i++) print line[i]
    if (line[start + 1] ~ /^[[:space:]]*$/) print ""
    if (idv != "") print "- ID: " idv
    print "- Status: done"
    if (goalv != "") print "- Goal: " goalv
    print "- Task: `TaskFlowDocs/achieved/" task "/`"
    print "- Next action: " next_action
    if (finish <= n) {
      print ""
      for (i = finish; i <= n; i++) print line[i]
    }
  }
' "$todo" > "$todo.tmp"; then
  rm -f "$todo.tmp" "$prose_tmp"
  rollback "$moved" "$todo_bak" "$plan_bak"
  echo "archive FAILED: Todo rewrite"
  exit 1
fi

# Append the moved prose to the achieved Plan. Nothing is appended when the
# entry carried none, and nothing is appended twice.
#
# There is always a Plan: step 2 moved the directory, and a task without a
# plan.md cannot reach here because its completion is checked in step 1. So the
# prose has exactly one destination, and the only question is whether the
# `## Todo Record` heading is already there (a reopened task, archived twice).
if [ -s "$prose_tmp" ]; then
  if ! grep -qx '## Todo Record' "$plan"; then
    printf '\n## Todo Record\n\nMoved verbatim from the TODO entry by `hooks/archive`, grouped by the field each block followed.\n' >> "$plan"
  fi
  cat "$prose_tmp" >> "$plan"
fi
rm -f "$prose_tmp"
mv "$todo.tmp" "$todo"

# 5. verify
fail=0
[ ! -d "$docs/$task" ] || { echo "FAIL: active path still present"; fail=1; }
[ -d "$docs/achieved/$task" ] || { echo "FAIL: achieved path missing"; fail=1; }
grep -q '> Status: completed' "$docs/achieved/$task/prd.md" || { echo "FAIL: achieved prd not completed"; fail=1; }
grep -q '> Status: completed' "$docs/achieved/$task/plan.md" || { echo "FAIL: achieved plan not completed"; fail=1; }
grep -q "achieved/$task/\`" "$todo" || { echo "FAIL: Todo Task: path not updated"; fail=1; }
grep -q "^- Next action: None — completed and archived\.$" "$todo" || { echo "FAIL: Todo next action not cleared"; fail=1; }
# The entry's body must now be exactly the five fields, and the moved prose must
# have landed where it was sent — checked here rather than assumed, because a
# compaction that drops a line without moving it is the one failure this
# transaction must never have.
if [ "$fail" = "0" ]; then
  entry="$(awk -v task="$task" '
    { n++; line[n] = $0 }
    END {
      needle = "`TaskFlowDocs/achieved/" task "/`"
      for (i = 1; i <= n; i++) {
        if (index(line[i], "## ") == 1) s = i
        if (index(line[i], needle)) { start = s; break }
      }
      if (!start) exit 0
      for (i = start + 1; i <= n; i++) {
        if (index(line[i], "## ") == 1) break
        if (line[i] !~ /^[[:space:]]*$/) print line[i]
      }
    }' "$todo")"
  printf '%s\n' "$entry" | grep -q '^- ID: ' || { echo "FAIL: compacted entry has no ID"; fail=1; }
  printf '%s\n' "$entry" | grep -qx -- '- Status: done' || { echo "FAIL: compacted entry not done"; fail=1; }
  printf '%s\n' "$entry" | grep -q '^- Task: `TaskFlowDocs/achieved/' || { echo "FAIL: compacted entry has no Task: path"; fail=1; }
  printf '%s\n' "$entry" | grep -q '^- Next action: ' || { echo "FAIL: compacted entry has no next action"; fail=1; }
  # The body outside the five fields must be empty. Everything removed from it is
  # asserted on the Plan side by the smoke suite, so this side only has to prove
  # the entry itself is the five fields and nothing else.
  s2="$(printf '%s\n' "$entry" | grep -v -e '^- ID: ' -e '^- Status: ' -e '^- Goal: ' -e '^- Task: ' -e '^- Next action: ' || true)"
  [ -z "$s2" ] || { echo "FAIL: compacted entry kept fields it should have moved:"; printf '%s\n' "$s2"; fail=1; }
fi
if [ "$fail" != "0" ]; then
  rollback "$moved" "$todo_bak" "$plan_bak"
  echo "archive FAILED"
  exit 1
fi
rm -f "$todo_bak" "$plan_bak"
echo "archive OK: $task -> achieved, Todo done"
# The hook does not touch Git (design boundary). Print the exact stage so the
# Agent cannot miss the deletion half of the mv, and pin the branch rule: the
# archive commit belongs on the current worktree branch, not on main.
printf '%s\n' \
  "Stage (commit on the current branch; do not switch to main for this commit):" \
  "  git add -A -- 'TaskFlowDocs/$task' 'TaskFlowDocs/achieved/$task' 'TaskFlowDocs/todo.md'"
# Teardown, but not yet. The worktree is removable only once this branch is in
# the base — an archive that has just run has not been committed, pushed, or
# merged — so the step is stated with its condition rather than as an action
# now, and the branch is named so the reader can check it. Printed only from a
# linked worktree: `commondir` in the absolute git dir is Git's own answer, the
# same test `hooks/task`'s `worktree_kind` uses, so a repository that never made
# one sees byte-identical output. The branch outlives the directory on purpose —
# `git worktree remove` deletes the tree and never the branch — so deleting the
# branch stays a separate, deliberate act.
git_dir="$(git -C "$root" rev-parse --absolute-git-dir 2>/dev/null || true)"
if [ -n "$git_dir" ] && [ -f "$git_dir/commondir" ]; then
  branch="$(git -C "$root" branch --show-current 2>/dev/null || true)"
  printf '%s\n' \
    "Tear down the worktree once '${branch:-this branch}' is merged into the base and this tree is clean:" \
    "  git worktree remove '$root'" \
    "  (the branch survives; deleting it is a separate decision)"
fi
