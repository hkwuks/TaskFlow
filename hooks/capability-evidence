#!/usr/bin/env bash
# Record a successful capability call against its captured start context.
set -euo pipefail
LC_ALL=C
export LC_ALL

HERE="$(cd "$(dirname "$0")" && pwd)"

# A non-zero exit from the parser means unusable input, not a reportable error.
event_json="$(cat)"
fields="$(printf '%s\n' "$event_json" | bash "$HERE/json-field" \
  hook_event_name tool_name cwd tool_input.skill tool_input.subagent_type tool_input.name 2>/dev/null)" || exit 0

event_name="$(printf '%s\n' "$fields" | sed -n '1p')"
tool_name="$(printf '%s\n' "$fields" | sed -n '2p')"
event_cwd="$(printf '%s\n' "$fields" | sed -n '3p')"
cap_skill="$(printf '%s\n' "$fields" | sed -n '4p')"
cap_agent="$(printf '%s\n' "$fields" | sed -n '5p')"
cap_name="$(printf '%s\n' "$fields" | sed -n '6p')"

case "$event_name" in
  PostToolUse)
    case "$tool_name" in
      Skill) capability="$cap_skill" ;;
      skill) capability="$cap_name" ;;
      Agent|Task) capability="$cap_agent" ;;
      mcp__*) capability="$tool_name" ;;
      *) exit 0 ;;
    esac ;;
  *) exit 0 ;;
esac
[ -n "$capability" ] || exit 0


printf '%s\n' "$event_json" | bash "$HERE/capability-context" finish "$capability" >/dev/null
exit 0
