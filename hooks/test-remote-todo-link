#!/usr/bin/env bash
set -euo pipefail
[ "$#" -eq 1 ] || { echo 'usage: test-remote-todo-link <new-fixture-directory>' >&2; exit 1; }
fixture="$1"
[ ! -e "$fixture" ] || { echo 'fixture already exists' >&2; exit 1; }
mkdir -p "$fixture/TaskFlowDocs/2026-11-16-demo" "$fixture/TaskFlowDocs/2026-11-16-other" "$fixture/bin"
fixture="$(cd "$fixture" && pwd -P)"
HERE="$(cd "$(dirname "$0")" && pwd)"
printf 'remote\nmain\tgithub\tgithub.com\towner/repo\n' > "$fixture/TaskFlowDocs/remote-todos.conf"
printf '# PRD\n' > "$fixture/TaskFlowDocs/2026-11-16-demo/prd.md"
printf '# Plan\n' > "$fixture/TaskFlowDocs/2026-11-16-demo/plan.md"
printf '# PRD\n' > "$fixture/TaskFlowDocs/2026-11-16-other/prd.md"
printf '# Plan\n' > "$fixture/TaskFlowDocs/2026-11-16-other/plan.md"
cat > "$fixture/bin/gh" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' '{"number":17,"title":"Example"}'
EOF
chmod +x "$fixture/bin/gh"
PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" link main 17 2026-11-16-demo --root "$fixture"
grep -q "$(printf 'github\tgithub.com\towner/repo\t17')" "$fixture/TaskFlowDocs/2026-11-16-demo/remote-issue" || { echo 'FAIL wrong association'; exit 1; }
if PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" link main 17 2026-11-16-demo --root "$fixture" >/dev/null 2>&1; then echo 'FAIL overwrote association'; exit 1; fi
if PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" link main 17 2026-11-16-other --root "$fixture" >/dev/null 2>&1; then echo 'FAIL duplicate association accepted'; exit 1; fi
if PATH="$fixture/bin:$PATH" bash "$HERE/remote-todo" link main 19 2026-11-16-other --root "$fixture" >/dev/null 2>&1; then echo 'FAIL identity mismatch accepted'; exit 1; fi
[ ! -e "$fixture/TaskFlowDocs/2026-11-16-other/remote-issue" ] || { echo 'FAIL wrote bad association'; exit 1; }
echo 'PASS remote todo link'