{
  "description": "TaskFlow lifecycle hooks: SessionStart state summary, per-prompt reminder, and base checkout edit guard (DeepSeek Harness form).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT='${CLAUDE_PLUGIN_ROOT}' bash '${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd' session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT='${CLAUDE_PLUGIN_ROOT}' bash '${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd' prompt-reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write|edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT='${CLAUDE_PLUGIN_ROOT}' bash '${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd' base-write-gate"
          }
        ]
      }
    ]
  }
}
