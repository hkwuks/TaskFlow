#!/usr/bin/env bash
# session-start — SessionStart hook for TaskFlow
# Reads a JSON event on stdin, prints the TaskFlow state summary as
# the platform-appropriate additional-context field, mirroring the
# obra/superpowers/hooks/session-start pattern:
#   Cursor → additional_context (snake_case)
#   Claude Code → hookSpecificOutput.additionalContext (nested)
#   Copilot/unknown → additionalContext (top-level SDK standard)
# Extensionless so Claude Code's Windows auto-detection (which prepends "bash"
# to any command containing ".sh") never interferes.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Command hooks receive the event JSON on stdin. Empty input remains
# compatible with direct CLI invocation and older hook hosts.
event_json="$(cat)"
python_cmd="$(bash "${PLUGIN_ROOT}/hooks/python-runtime")"
event_fields="$(TASKFLOW_EVENT_JSON="$event_json" "$python_cmd" - <<'PY'
import json, os
payload = os.environ.get("TASKFLOW_EVENT_JSON", "").strip()
try:
    event = json.loads(payload) if payload else {}
except json.JSONDecodeError as exc:
    raise SystemExit(f"TaskFlow SessionStart error: invalid event JSON: {exc}")
print(event.get("hook_event_name", ""))
print(event.get("cwd", ""))
print(event.get("session_id", ""))
PY
)"
event_name="$(printf '%s\n' "$event_fields" | sed -n '1p')"
event_cwd="$(printf '%s\n' "$event_fields" | sed -n '2p')"
event_session_id="$(printf '%s\n' "$event_fields" | sed -n '3p')"
if [ -n "$event_name" ] && [ "$event_name" != "SessionStart" ]; then
  exit 0
fi
if [ -n "$event_cwd" ] && [ -d "$event_cwd" ]; then
  export TASKFLOW_REPO_ROOT="$event_cwd"
fi
if [ -n "$event_session_id" ]; then
  export TASKFLOW_SESSION_ID="$event_session_id"
fi
export TASKFLOW_SESSION_CWD="$event_cwd"
# Record the host session id in the selected task's session index. Best-effort:
# a failure here must never change this hook's exit code or context output.
bash "${PLUGIN_ROOT}/hooks/session-record" || true

# Synchronize the routing record, then derive compact context from it and task state.
if ! state_summary="$(bash "${PLUGIN_ROOT}/hooks/summarize-state" 2>&1)"; then
  printf '%s\n' "$state_summary" >&2
  exit 1
fi
if ! docs_context="$(bash "${PLUGIN_ROOT}/hooks/repository-docs-context" 2>&1)"; then
  printf '%s\n' "$docs_context" >&2
  exit 1
fi
state_summary="${state_summary}${state_summary:+$'\n'}${docs_context}"
[ -z "$state_summary" ] && exit 0

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}
escaped="$(escape_for_json "$state_summary")"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$escaped"
fi
exit 0
