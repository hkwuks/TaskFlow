#!/usr/bin/env bash
# version — atomic Task-version transition archiving only changed core docs.
# Usage: version <task-id> <new-version> [root] [file...]
# Copies the superseded core docs whose approved content materially changed
# into old/<old>/ (only those + version.md), then prepares retained root docs
# for the new approval cycle. Default archives prd + spec.
# Approval stays with the user.
set -euo pipefail
task="$1"; newv="$2"; root="${3:-$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")}"
files=("${@:4}")
docs="$root/TaskFlowDocs"
[ -d "$docs/$task" ] || { echo "no task $docs/$task"; exit 1; }

plan="$docs/$task/plan.md"
[ -f "$plan" ] || { echo "missing plan.md"; exit 1; }
[ -f "$docs/$task/prd.md" ] || { echo "missing prd.md"; exit 1; }
oldv=$(awk -F': ' '/> Task version:/{print $2; exit}' "$plan")
[ -n "$oldv" ] || { echo "missing current Task version"; exit 1; }
[[ "$oldv" =~ ^v([1-9][0-9]*)$ ]] || { echo "invalid current Task version: $oldv"; exit 1; }
[ "$newv" = "v$((BASH_REMATCH[1] + 1))" ] || { echo "new version must follow $oldv"; exit 1; }

[ "${#files[@]}" -gt 0 ] || files=(prd.md spec.md)
selected=()
for f in "${files[@]}"; do
  case "$f" in prd.md|spec.md|plan.md) ;; *) echo "invalid core document: $f"; exit 1;; esac
  [ -f "$docs/$task/$f" ] || { [ "$f" = spec.md ] && continue; echo "cannot archive $f (not present)"; exit 1; }
  [[ " ${selected[*]:-} " == *" $f "* ]] || selected+=("$f")
done
[ "${#selected[@]}" -gt 0 ] || { echo "no core documents selected"; exit 1; }

for f in prd.md spec.md plan.md; do
  fpath="$docs/$task/$f"
  [ -f "$fpath" ] || continue
  grep -q "^> Task version: $oldv$" "$fpath" || { echo "mixed or missing Task version in $f"; exit 1; }
done
# Only the section is required. Individual Approval fields are written below
# even when absent — a plan that followed the old four-field skill snippet has
# no `- Status:` line, and refusing here is what kept the gate and version
# reset from agreeing on shape.
grep -q '^## Approval$' "$plan" || { echo "missing Approval section"; exit 1; }

# The archive must hold the superseded *version*, not the working tree after the
# new version's edits landed. When v2 was written before the bump was taken, the
# copy below would carry v2's text and `old/vN/` would silently stop recording
# what was approved. Untracked documents (file-mode, documents kept out of Git)
# have no such baseline and are left to the author.
if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  for f in "${selected[@]}"; do
    fpath="$docs/$task/$f"
    git -C "$root" ls-files --error-unmatch "$fpath" >/dev/null 2>&1 || continue
    if ! git -C "$root" diff --quiet -- "$fpath" || ! git -C "$root" diff --cached --quiet -- "$fpath"; then
      echo "$f has uncommitted changes; commit the superseded version first, then re-run version"
      exit 1
    fi
  done
fi

archdir="$docs/$task/old/$oldv"
[ ! -e "$archdir" ] || { echo "archive already exists: $archdir"; exit 1; }
mkdir -p "$archdir"

# version.md (always)
cat > "$archdir/version.md" <<EOF
# Archived Version $oldv — $(head -1 "$plan" | sed 's/^# //')
> Task: $task
> Version: $oldv
> Status: superseded
> Archived: $(date '+%Y-%m-%d %H:%M %z')
> Superseded by: $newv
> Archive mode: file

## Change Summary
(Agent: summarize what changed between $oldv and $newv.)

## Archived Materials
$(for f in "${selected[@]}"; do echo "- $f"; done)

## Restore
Read the archived $oldv core docs from a new temporary restore root. Do not overwrite the current task root.
EOF

# copy only changed core docs; retained roots become the new version
for f in "${selected[@]}"; do cp "$docs/$task/$f" "$archdir/$f"; done

# prepare all root docs for the new approval cycle (temp file + mv keeps
# BSD/macOS sed working, which has no GNU-style bare `sed -i`)
for f in prd.md spec.md plan.md; do
  fpath="$docs/$task/$f"
  [ -f "$fpath" ] || continue
  sed "s/^> Task version: .*/> Task version: $newv/" "$fpath" > "$fpath.tmp"
  mv "$fpath.tmp" "$fpath"
done
for fpath in "$docs/$task/prd.md" "$plan"; do
  sed 's/^> Status: .*/> Status: ready/' "$fpath" > "$fpath.tmp"
  mv "$fpath.tmp" "$fpath"
done
# Reset ## Approval to the same five-field block hooks/task promote writes.
# Field lines are dropped and re-emitted once, in template order, so a missing
# Status (or any other) is inserted rather than refused. Non-field lines in
# the section are left alone.
awk '
  BEGIN {
    t[1] = "- Status: requested"
    t[2] = "- Approved by: pending"
    t[3] = "- Approved at: pending"
    t[4] = "- Approved version: pending"
    t[5] = "- Approved scope: pending"
  }
  function flush_five(   i) {
    for (i = 1; i <= 5; i++) print t[i]
    emitted = 1
  }
  /^## Approval$/ { approval = 1; emitted = 0; print; next }
  approval && /^## / {
    if (!emitted) flush_five()
    approval = 0
    print
    next
  }
  approval && /^- Status:/ ||
  approval && /^- Approved by:/ ||
  approval && /^- Approved at:/ ||
  approval && /^- Approved version:/ ||
  approval && /^- Approved scope:/ {
    if (!emitted) flush_five()
    next
  }
  { print }
  END { if (approval && !emitted) flush_five() }
' "$plan" > "$plan.tmp"
mv "$plan.tmp" "$plan"

for f in "${selected[@]}"; do [ -f "$archdir/$f" ] || { echo "archive check failed: $f"; exit 1; }; done
for f in prd.md spec.md plan.md; do
  fpath="$docs/$task/$f"; [ -f "$fpath" ] || continue
  grep -q "^> Task version: $newv$" "$fpath" || { echo "root version check failed: $f"; exit 1; }
done
grep -q '^> Status: ready$' "$docs/$task/prd.md" && grep -q '^> Status: ready$' "$plan" || { echo "ready-state check failed"; exit 1; }
# Exact five-line block, in order — not a single-field grep under -A8.
approval_fields="$(awk '
  /^## Approval$/ { p = 1; next }
  p && /^## / { exit }
  p && /^- Status:/ { print; next }
  p && /^- Approved by:/ { print; next }
  p && /^- Approved at:/ { print; next }
  p && /^- Approved version:/ { print; next }
  p && /^- Approved scope:/ { print; next }
' "$plan")"
expected_approval='- Status: requested
- Approved by: pending
- Approved at: pending
- Approved version: pending
- Approved scope: pending'
[ "$approval_fields" = "$expected_approval" ] || {
  echo "approval reset failed"
  printf '%s\n' "$approval_fields"
  exit 1
}

echo "version OK: copied $oldv (changed docs only) -> root $newv ready; record approval before implementation"
