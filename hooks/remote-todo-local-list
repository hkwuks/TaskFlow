#!/usr/bin/env bash
# List local Todo entries not represented by a successfully read remote Issue.
set -euo pipefail
[ "$#" -eq 1 ] || { echo 'usage: remote-todo-local-list <root>' >&2; exit 2; }
root="$1"
todo="$root/TaskFlowDocs/todo.md"
[ -f "$todo" ] && [ ! -L "$todo" ] || exit 0
HERE="$(cd "$(dirname "$0")" && pwd)"
seen="$(cat)"
tab="$(printf '\t')"
contains() {
  case "
$seen
" in *"
$1
"*) return 0 ;; *) return 1 ;; esac
}
key_for() {
  local p="$1" h="$2" r="$3" n="$4"
  case "$p" in github|gitlab) ;; *) return 1 ;; esac
  [[ "$h" =~ ^[A-Za-z0-9][A-Za-z0-9.:-]*$ ]] && [[ "$r" =~ ^[A-Za-z0-9_./-]+$ ]] && [[ "$n" =~ ^[1-9][0-9]*$ ]] || return 1
  h="$(printf '%s' "$h" | tr '[:upper:]' '[:lower:]')"
  if [ "$p" = github ]; then r="$(printf '%s' "$r" | tr '[:upper:]' '[:lower:]')"; fi
  printf '%s|%s|%s|%s' "$p" "$h" "$r" "$n"
}
awk '
  function flush() {
    if (id == "") return
    if (status == "") status = "unknown"
    if (goal == "") goal = "(no goal)"
    gsub(/[[:cntrl:]]/, "", id); gsub(/[[:cntrl:]]/, "", status); gsub(/[[:cntrl:]]/, "", goal); gsub(/[[:cntrl:]]/, "", task)
    print id "\t" status "\t" goal "\t" task
  }
  /^## / { flush(); id = status = goal = task = ""; next }
  /^- ID: / { id = substr($0, 7); next }
  /^- Status: / { status = substr($0, 11); next }
  /^- Goal: / { goal = substr($0, 9); next }
  /^- Task: / { task = substr($0, 9); next }
  END { flush() }
' "$todo" | while IFS="$tab" read -r id status goal task; do
  [[ "$id" =~ ^(TF|T)-[0-9]{8}-[a-z0-9]+$ ]] || continue
  key=''
  mapping="$root/TaskFlowDocs/remote-todo-links/$id"
  if [ -f "$mapping" ] && [ ! -L "$mapping" ] && [ -f "$mapping.detached" ] && [ ! -L "$mapping.detached" ]; then
    IFS="$tab" read -r detached copy_id < "$mapping.detached"
    if [ "$detached" = detached ] && [[ "$copy_id" =~ ^(TF|T)-[0-9]{8}-[a-z0-9]+$ ]] && [ "$copy_id" != "$id" ]; then
      header="$(awk -F '\t' 'NR == 1 && NF == 5 && $1 == "pending" { p = $3; h = $4; r = $5 } $1 == "confirmed" && NF == 2 && $2 ~ /^[1-9][0-9]*$/ { n = $2 } END { if (p != "" && n != "") print p "\t" h "\t" r "\t" n }' "$mapping")"
      if [ -n "$header" ]; then
        IFS="$tab" read -r p h r n <<EOF
$header
EOF
        source_key="$(key_for "$p" "$h" "$r" "$n")" || source_key=''
        if [ -n "$source_key" ]; then
          h="$(printf '%s' "$h" | tr '[:upper:]' '[:lower:]')"
          if [ "$p" = github ]; then r="$(printf '%s' "$r" | tr '[:upper:]' '[:lower:]')"; url="https://$h/$r/issues/$n"
          else url="https://$h/$r/-/issues/$n"; fi
          if TASKFLOW_COPY_ID="$copy_id" TASKFLOW_COPY_URL="$url" awk '
            function flush() { if (inside && found_id) { matches++; if (found_url && found_end) complete++ } }
            /^## / { flush(); inside = 1; found_id = found_url = found_end = 0 }
            inside && $0 == "- ID: " ENVIRON["TASKFLOW_COPY_ID"] { found_id = 1 }
            inside && $0 == "- External: " ENVIRON["TASKFLOW_COPY_URL"] { found_url = 1 }
            inside && $0 == "    <!-- taskflow-copy-complete:" ENVIRON["TASKFLOW_COPY_ID"] " -->" { found_end = 1 }
            END { flush(); if (matches == 1 && complete == 1) exit 0; exit 1 }
          ' "$todo"; then continue; fi
        fi
      fi
    fi
  fi
  if [ -f "$mapping" ] && [ ! -L "$mapping" ] && [ ! -e "$mapping.detached" ]; then
    header="$(awk -F '\t' 'NR == 1 && NF == 5 && $1 == "pending" { p = $3; h = $4; r = $5 } $1 == "confirmed" && NF == 2 && $2 ~ /^[1-9][0-9]*$/ { n = $2 } ($1 == "stage-synced" || $1 == "remote-authoritative") && NF == 2 { synced = 1 } END { if (p != "" && n != "" && synced) print p "\t" h "\t" r "\t" n }' "$mapping")"
    if [ -n "$header" ]; then
      IFS="$tab" read -r p h r n <<EOF
$header
EOF
      key="$(key_for "$p" "$h" "$r" "$n")" || key=''
    fi
  fi
  case "$task" in
    \`TaskFlowDocs/*/\`)
      task_id="${task#\`TaskFlowDocs/}"; task_id="${task_id%/\`}"
      if [ -z "$key" ] && bash "$HERE/task-id" "$task_id" >/dev/null 2>&1; then
        ref="$root/TaskFlowDocs/$task_id/remote-issue"
        if [ -f "$ref" ] && [ ! -L "$ref" ] && [ ! -e "$root/TaskFlowDocs/remote-todo-links/task-$task_id.detached" ] && [ ! -L "$root/TaskFlowDocs/remote-todo-links/task-$task_id.detached" ]; then
          IFS="$tab" read -r p h r n < "$ref"
          key="$(key_for "$p" "$h" "$r" "$n")" || key=''
        fi
      fi ;;
  esac
  if [ -n "$key" ] && contains "$key"; then continue; fi
  printf 'LOCAL %s [%s] %s\n' "$id" "$status" "$goal"
done