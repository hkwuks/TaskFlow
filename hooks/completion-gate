#!/usr/bin/env bash
# completion-gate — decide whether a task's Plan may be treated as finished.
#
# Usage: completion-gate [--approval-only] <task-dir>
#   exit 0 — the Plan passes
#   exit 1 — it does not; one line on stderr names the condition that failed
#
# Why this exists as its own file, called the way `hooks/archive` already calls
# `task-id`, rather than as a copy inside each caller: four commands need this
# answer — `archive` and `task complete` must agree about what "finished" means,
# and `task state in_progress` and `task progress` need the approval half of it
# before they touch approved work. Before this file `complete` checked three
# conditions and `archive` checked none, so the guard held only for whoever
# chose the stricter entry point: measured 2026-10-22, an emptied `## Approval`,
# two pending Steps and an unchecked item archived with exit 0 after two
# hand-edited `> Status: completed` lines.
#
# `--approval-only` is the narrower question the two mid-task commands ask: is
# the current Task version approved? They must not require the Plan to be
# finished — that is what they are working towards.
#
# Every check reads the Plan *as a file*, in one `awk`, with no pipeline. That
# is not style. These scripts run under `set -o pipefail`, where
# `printf '%s\n' "$text" | grep -q pattern` fails whenever `$text` is larger
# than the pipe buffer and the pattern matches early: `grep -q` exits on the
# first hit, `printf` takes SIGPIPE and dies with 141, and `pipefail` turns a
# successful match into a failed pipeline. Measured on the pre-existing code: a
# 111 KB Plan with an unchecked item first in the file was archived 15 times
# out of 15, and the same shape falsely refused a genuinely approved 39 KB
# `## Approval` block 16 times out of 200. Reading the file once makes every
# check exact at any size, and there is no silent-skip path left in the gate.
#
# Extensionless, like every other TaskFlow hook, so Claude Code Windows
# auto-detection never interferes.

set -euo pipefail
LC_ALL=C
export LC_ALL

usage="usage: completion-gate [--approval-only] <task-dir>"

HERE="$(cd "$(dirname "$0")" && pwd)"

approval_only=0
if [ "${1:-}" = "--approval-only" ]; then
  approval_only=1
  shift
fi
[ "$#" -eq 1 ] || { echo "$usage" >&2; exit 1; }

plan="$1/plan.md"
[ -f "$plan" ] || { echo "plan.md missing; completion not started" >&2; exit 1; }

# The approval half is one line of policy shared with `capability-gate`, which
# asks the same question from a `PreToolUse` process and cannot source this
# file. It lives in `approval-check` so there is exactly one implementation;
# this gate reports its refusal verbatim, so every caller that already matched
# on "current Task version is not approved" still matches.
#
# The approval answer is also the first thing the full check would report, so
# asking it here rather than inside the `awk` keeps the order callers see — a
# Plan that is both unapproved and unfinished still fails on the approval.
bash "$HERE/approval-check" "$plan" || exit 1

# `--approval-only` is the narrower question the two mid-task commands ask (`task
# state in_progress`, `task progress`): is the current Task version approved?
# They must not require the Plan to be finished — that is what they are working
# towards — so the answer is already given above.
if [ "$approval_only" -eq 1 ]; then exit 0; fi

# One pass, one process, one read. The conditions are checked in the order the
# Agent would hit them and the first failure wins, so a Plan with two problems
# reports the earlier one rather than whichever the reader happened to notice.
# Approval has already been answered above, so what remains is whether the Plan
# is finished.
result="$(awk -v approval_only="$approval_only" '
  # A Step block is closed only when it says `- Status: done` in column 0. This
  # is a whitelist, and that is the point: the previous shape listed the three
  # words that meant unfinished, so every value it did not know about -- a typo,
  # `completed`, `done (v1)`, an empty value -- counted as finished. Measured
  # 2026-10-27: all of those archived. `hooks/task progress` has always accepted
  # exactly `pending|in_progress|done|blocked`, so `done` is the only word that
  # can mean closed, and reading anything else as closed is the disagreement
  # this replaces rather than one it repeats.
  #
  # Block location mirrors the writer at `hooks/task` -- any `### Step ` with a
  # number and no trailing word character opens one, and any `### Step ` or
  # column-0 `## ` closes it. Deliberately NOT filtered to the `## Steps`
  # section: two archived Plans carry Step blocks under other headings, and a
  # reader that skipped them would see a different set of Steps than
  # `task progress` writes to. That is the split this check exists to remove.
  #
  # What this still lets through, and knowingly: a Plan with no `### Step` at
  # all has nothing to be unfinished, so this check passes it. Closing that
  # needs a rule about whether a Plan must have Steps, which is a different
  # question with its own arguments; it is not smuggled in here.
  function flush() {
    if (instep && !closed) unfinished = 1
    instep = 0; closed = 0; nstat = 0
  }
  BEGIN { bad = 0 }
  /^## / { flush() }
  /^### Step / {
    flush()
    rest = substr($0, 10)
    if (match(rest, /^[0-9]+/)) {
      if (substr(rest, RLENGTH + 1, 1) !~ /[A-Za-z0-9_]/) {
        instep = 1
        # Named so a refusal can say which block carries two statuses. Without a
        # number there is nothing to name and nothing to report: the block is not
        # one `task progress` could have written to.
        stepnum = substr(rest, 1, RLENGTH)
      }
    }
    next
  }
  /^[[:space:]]*- \[ \]/ { unchecked = 1 }
  # Two `- Status:` lines in one block is a Plan that contradicts itself, and the
  # previous behaviour — last one wins — was a guess dressed as a reading. The
  # comment that stood here argued reading the last is "the reading a person
  # makes" because `task progress` replaces rather than appends, so a second line
  # must be a hand edit. That reasoning is sound about *how* the second line got
  # there and silent about what it means: the two lines state different statuses
  # and either could be the intended one, which is a question this gate has no
  # basis to answer. Measured 2026-10-30: a Plan with `- Status: done` followed by
  # `- Status: pending` archived, because the reader took the last.
  #
  # Refusing costs an author one deletion. Guessing costs a Plan that archived
  # while it said it was not finished.
  instep && /^- Status:/ {
    nstat++
    if (nstat > 1) dup_step = (dup_step == "") ? stepnum : dup_step ", " stepnum
    closed = ($0 ~ /^- Status:[[:space:]]*done[[:space:]]*$/)
  }
  END {
    flush()
    if (approval_only) { exit 0 }
    # Checked before `unchecked` and `unfinished`, because it is the one failure
    # whose remedy is different in kind: the others say "finish the work", this
    # says "the document states two things, delete one".
    if (dup_step != "") { print "Plan has more than one - Status: line in Step " dup_step; bad = 1 }
    else if (unchecked)  { print "Plan has unchecked items"; bad = 1 }
    else if (unfinished) { print "Plan has unfinished Steps"; bad = 1 }
    exit bad
  }
' "$plan")" || { printf '%s\n' "$result" >&2; exit 1; }
exit 0
